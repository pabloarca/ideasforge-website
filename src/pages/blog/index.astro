---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { content } from '../../i18n/ui';
import { altsFor, localizedPath } from '../../i18n/utils';
import PostCover from '../../components/PostCover.astro';

const lang = 'es' as const;
const t = content[lang];

const posts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const slugOf = (id: string) => id.replace(/^(es|en)\//, '');
const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

/*
  El índice se declara como Blog y nombra sus entradas. Sirve para que un
  rastreador vea la lista como una colección con partes, en vez de como una
  página suelta llena de enlaces. Se genera de `posts`, así que una entrada
  nueva entra sola y una que se va a la nevera desaparece sola.
*/
const site = Astro.site ?? new URL('https://ideasforge.io');
const blogJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t.meta.blogTitle.replace(/, Ideasforge$/, ''),
  description: t.meta.blogDescription,
  url: new URL('/blog', site).href,
  inLanguage: 'es-ES',
  publisher: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/blog/${slugOf(p.id)}`, site).href,
    datePublished: p.data.pubDate.toISOString(),
    ...(p.data.updatedDate ? { dateModified: p.data.updatedDate.toISOString() } : {}),
  })),
}).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={blogJsonLd} />

<BaseLayout
  lang={lang}
  title={t.meta.blogTitle}
  description={t.meta.blogDescription}
  alternates={altsFor('blog')}
>
  <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 sm:py-28">
    <header class="max-w-2xl">
      <h1 class="text-5xl font-bold tracking-tight text-fg sm:text-6xl">{t.blog.eyebrow}</h1>
      <p class="mt-5 text-lg text-muted">{t.blog.subtitle}</p>
    </header>

    {/* Filas de un bloque continuo, no tarjetas sueltas: el lenguaje de la
        home (carrusel, FAQ, servicios). `divide-y` separa las entradas y
        `border-y` cierra el bloque. El hover pasa de sombra a fondo suave. */}
    <div class="mt-14 divide-y divide-border-soft border-y border-border-soft">
      {
        posts.map((post, i) => (
          <article class="group relative flex flex-col overflow-hidden bg-bg transition-colors duration-300 hover:bg-border/30 sm:flex-row">
            <div class="aspect-[4/3] w-full shrink-0 overflow-hidden bg-bg-soft sm:aspect-auto sm:w-72 lg:w-80">
              {/* Misma portada que el acordeon de la home: si el post no trae
                  imagen, se genera con la paleta del diamante. `compact` deja
                  el titulo fuera porque la tarjeta ya lo muestra al lado. */}
              <PostCover title={post.data.title} image={post.data.heroImage} index={i} compact />
            </div>
            <div class="flex flex-1 flex-col p-7 sm:p-8">
              <div class="flex flex-wrap items-center gap-3">
                {/* Estreno y reescritura, en ese orden. Cuatro entradas de 2025
                    citan hechos de 2026 y con solo la fecha de estreno parecían
                    adivinar el futuro. La de estreno se queda porque es la que
                    ordena la lista. */}
                <time datetime={post.data.pubDate.toISOString()} class="text-xs font-medium uppercase tracking-wide text-faint">
                  {fmt(post.data.pubDate)}
                </time>
                {post.data.updatedDate &&
                  post.data.updatedDate.toDateString() !== post.data.pubDate.toDateString() && (
                    <time datetime={post.data.updatedDate.toISOString()} class="text-xs text-faint">
                      · {t.blog.updatedOn} {fmt(post.data.updatedDate)}
                    </time>
                  )}
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full border border-border-soft px-2.5 py-0.5 text-xs text-muted">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="mt-3 text-2xl font-bold leading-snug text-fg sm:text-[1.65rem]">
                <a href={localizedPath(`/blog/${slugOf(post.id)}`, lang)} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">{post.data.description}</p>
              <div class="mt-6">
                <span class="btn-ghost">{t.blog.readMore}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
