---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { content } from '../../i18n/ui';
import { altsFor, localizedPath } from '../../i18n/utils';

const lang = 'es' as const;
const t = content[lang];

const posts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const slugOf = (id: string) => id.replace(/^(es|en)\//, '');
const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  lang={lang}
  title={t.meta.blogTitle}
  description={t.meta.blogDescription}
  alternates={altsFor('blog')}
>
  <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 sm:py-28">
    <header class="max-w-2xl">
      <h1 class="text-5xl font-bold tracking-tight text-fg sm:text-6xl">{t.blog.eyebrow}</h1>
      <p class="mt-5 text-lg text-muted">{t.blog.subtitle}</p>
    </header>

    <div class="mt-14 grid gap-6">
      {
        posts.map((post) => (
          <article class="card-soft hover:card-soft-hover group relative flex flex-col overflow-hidden sm:flex-row">
            <div class="aspect-[4/3] w-full shrink-0 overflow-hidden bg-bg-soft sm:aspect-auto sm:w-72 lg:w-80">
              {post.data.heroImage ? (
                <img
                  src={post.data.heroImage}
                  alt={post.data.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div
                  class="h-full w-full"
                  style="background: linear-gradient(135deg, #e9e7ff, #c9c7ff);"
                />
              )}
            </div>
            <div class="flex flex-1 flex-col p-7 sm:p-8">
              <div class="flex flex-wrap items-center gap-3">
                <time datetime={post.data.pubDate.toISOString()} class="text-xs font-medium uppercase tracking-wide text-faint">
                  {fmt(post.data.pubDate)}
                </time>
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full border border-border-soft px-2.5 py-0.5 text-xs text-muted">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="mt-3 text-2xl font-bold leading-snug text-fg sm:text-[1.65rem]">
                <a href={localizedPath(`/blog/${slugOf(post.id)}`, lang)} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">{post.data.description}</p>
              <div class="mt-6">
                <span class="btn-ghost">{t.blog.readMore}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
