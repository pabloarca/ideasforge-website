---
import { getImage } from 'astro:assets';
import { foto } from '../../lib/fotos';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNav.astro';
import CuerpoDePost from '../../components/pizarra/CuerpoDePost.astro';
import { getCollection, render } from 'astro:content';
import { content } from '../../i18n/ui';
import { localizedPath } from '../../i18n/utils';
import { EMPRESA } from '../../lib/empresa';

const lang = 'es' as const;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'es' && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^es\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

/*
  Indice lateral de la entrada, el mismo componente que usan las paginas de
  servicio. No se inventa nada: son los titulares de nivel 2 que el autor ya
  escribio en el markdown, con el `id` que Astro les genera solo, que es el
  mismo al que apunta el ancla.

  Por debajo de tres titulares no se pinta. Un indice de dos entradas ocupa
  una columna entera para decir algo que se ve de un vistazo bajando.
*/
const navItems = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ heading: h.text, anchor: h.slug }));
const hasNav = navItems.length >= 3;
const t = content[lang];

// Link to the English translation (same translationId), if it exists.
const all = await getCollection('blog');
const en = all.find((p) => p.data.translationId === post.data.translationId && p.data.lang === 'en');
const alternates: Partial<Record<'es' | 'en', string>> = {
  es: localizedPath(`/blog/${post.id.replace(/^es\//, '')}`, 'es'),
};
if (en) alternates.en = localizedPath(`/blog/${en.id.replace(/^en\//, '')}`, 'en');

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

// Article structured data.
const site = Astro.site ?? new URL('https://ideasforge.io');
/*
  Imagen social del artículo.

  La portada ya no vive en `public/`: desde el 14 sep 2026 la procesa Astro y
  sale como WebP con un nombre con hash. Para la página eso es una mejora, pero
  para compartir NO se usa esa: se genera aparte un JPEG de 1200 px, que es el
  ancho que piden las redes y el formato que todas leen sin discusión. Sin esto
  el `og:image` de las dieciséis entradas con fotografía apuntaba a una ruta que
  la mudanza dejó vacía, y habrían salido sin imagen al compartirlas.
*/
const ogFoto = post.data.heroImage
  ? await getImage({ src: foto(post.data.heroImage), width: 1200, format: 'jpeg' })
  : null;
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  inLanguage: 'es-ES',
  ...(ogFoto ? { image: new URL(ogFoto.src, site).href } : {}),
  /* Persona y no organización: un artículo sin autor humano no tiene autor a
     ojos de un buscador, y quien escribe es parte de lo que se evalúa. */
  author: { '@type': 'Person', name: post.data.author ?? EMPRESA.autor },
  publisher: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
});
/*
  `image` alimenta og:image y twitter:image. Sin esta linea, `heroImage` solo
  llegaba al JSON-LD y NINGUNA pagina pasaba imagen al layout: las 61 caian en
  el respaldo `/og-default.png`, que ademas no existia en `public/`. Las cuatro
  entradas con fotografia propia se compartian con la generica.

  Va aqui y no entre los atributos del componente: un comentario JSX entre
  llaves, dentro de la lista de atributos, lo lee el parser como una expresion
  y `astro check` canta «unterminated string literal», aunque el build lo
  tolere. (Y ojo al escribirlo: citar el cierre de bloque literal aqui dentro
  termina el comentario a media frase.)

  `undefined` es lo correcto cuando no hay foto: deja actuar al valor por
  defecto del layout.
*/
---

<BaseLayout
  lang={lang}
  title={`${post.data.metaTitle ?? post.data.title}, Ideasforge`}
  description={post.data.description}
  alternates={alternates}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  image={ogFoto?.src}
>
  <script is:inline slot="head" type="application/ld+json" set:html={articleJsonLd} />
  <div class="wrap pt-[clamp(40px,5vw,72px)]">
    <a href={localizedPath('/blog', lang)} class="link-quiet text-[13px]!">
      ← {t.blog.backToBlog}
    </a>

    {/* La cabecera va a todo el ancho, encima de las dos columnas, igual que
        el héroe de las páginas largas: rótulo, titular y entradilla. */}
    <header class="pb-[clamp(40px,5vw,64px)] pt-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-faint">
        {/* La firma va visible y no solo en el dato estructurado: un buscador
            valora la experiencia de quien escribe, y para valorarla tiene que
            verla en la página igual que la ve el lector. */}
        <span>{t.blog.byline} {post.data.author ?? EMPRESA.autor}</span>
        <time datetime={post.data.pubDate.toISOString()}>
          · {t.blog.publishedOn} {fmt(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <time datetime={post.data.updatedDate.toISOString()}>
            · {t.blog.updatedOn} {fmt(post.data.updatedDate)}
          </time>
        )}
        {post.data.tags.length > 0 && <span>· {post.data.tags.join(', ')}</span>}
      </div>
      <h1 class="t-display mt-5 max-w-[26ch]">{post.data.title}</h1>
      <p class="mt-6 max-w-[62ch] text-[17px] leading-[1.55] text-muted">{post.data.description}</p>
    </header>

    <div class:list={['border-t-2 border-border', hasNav && 'lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]']}>
      {hasNav && (
        <div class="hidden lg:block">
          {/* Mismo tope de altura que en las páginas largas: una columna fija
              más alta que la ventana deja las últimas entradas inalcanzables. */}
          <div class="no-scrollbar sticky top-[104px] max-h-[calc(100vh-8rem)] overflow-y-auto overscroll-contain pb-10 pr-8 pt-12">
            <PageNav items={navItems} heading={t.blog.tocHeading} />
          </div>
        </div>
      )}
      <article class:list={['pt-12', hasNav && 'lg:border-l-2 lg:border-border lg:pl-12']}>
        <div class="prose max-w-[46rem]">
          {/* Con el HTML ya renderizado, para poder intercalar las pizarras que
              el markdown marca con <div data-pizarra="…"></div>. */}
          {post.rendered ? <CuerpoDePost html={post.rendered.html} lang={lang} /> : <Content />}
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
