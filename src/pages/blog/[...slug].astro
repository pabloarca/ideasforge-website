---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { content } from '../../i18n/ui';
import { localizedPath } from '../../i18n/utils';

const lang = 'es' as const;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'es' && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^es\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = content[lang];

// Link to the English translation (same translationId), if it exists.
const all = await getCollection('blog');
const en = all.find((p) => p.data.translationId === post.data.translationId && p.data.lang === 'en');
const alternates: Partial<Record<'es' | 'en', string>> = {
  es: localizedPath(`/blog/${post.id.replace(/^es\//, '')}`, 'es'),
};
if (en) alternates.en = localizedPath(`/blog/${en.id.replace(/^en\//, '')}`, 'en');

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

// Article structured data.
const site = Astro.site ?? new URL('https://ideasforge.io');
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'es-ES',
  ...(post.data.heroImage ? { image: new URL(post.data.heroImage, site).href } : {}),
  author: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
  publisher: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
});
---

<BaseLayout
  lang={lang}
  title={`${post.data.title}, Ideasforge`}
  description={post.data.description}
  alternates={alternates}
  ogType="article"
>
  <script is:inline slot="head" type="application/ld+json" set:html={articleJsonLd} />
  <article class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-24">
    {/* Misma flecha que el resto del sitio, reflejada. Antes era el caracter
        «←», que se dibuja con la tipografia y no casa con las demas. */}
    <a
      href={localizedPath('/blog', lang)}
      class="group inline-flex items-center gap-1.5 font-mono text-sm text-muted transition-colors hover:text-fg"
    >
      <Icon name="flecha-izquierda" size={16} class="shrink-0 transition-transform duration-300 group-hover:-translate-x-0.5" />
      {t.blog.backToBlog}
    </a>

    <header class="mt-6 border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-3">
        <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-faint">
          {t.blog.publishedOn} {fmt(post.data.pubDate)}
        </time>
        {post.data.tags.map((tag) => (
          <span class="rounded-full border border-border px-2.5 py-0.5 text-xs text-muted">{tag}</span>
        ))}
      </div>
      <h1 class="mt-4 text-balance text-4xl font-semibold leading-tight tracking-tight text-fg">
        {post.data.title}
      </h1>
      <p class="mt-4 text-lg text-muted">{post.data.description}</p>
    </header>

    <div
      class="prose mt-10 max-w-none prose-headings:tracking-tight prose-headings:text-fg prose-a:text-accent prose-strong:text-fg"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
