---
import VerticalPage from '../components/VerticalPage.astro';
import { content } from '../i18n/ui';

const lang = 'es' as const;
const t = content[lang];
---

<VerticalPage
  lang={lang}
  page={t.pages.accounting}
  title={t.meta.accountingTitle}
  description={t.meta.accountingDescription}
  routeKey="accounting"
/>
