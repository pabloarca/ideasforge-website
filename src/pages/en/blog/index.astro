---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { content } from '../../../i18n/ui';
import { altsFor, localizedPath } from '../../../i18n/utils';
import PostCover from '../../../components/PostCover.astro';

const lang = 'en' as const;
const t = content[lang];

const posts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const slugOf = (id: string) => id.replace(/^(es|en)\//, '');
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

/* Espejo del índice español: la colección se declara como Blog y nombra sus
   entradas, generadas de `posts` para que la lista no se quede vieja. */
const site = Astro.site ?? new URL('https://ideasforge.io');
const blogJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t.meta.blogTitle.replace(/, Ideasforge$/, ''),
  description: t.meta.blogDescription,
  url: new URL('/en/blog', site).href,
  inLanguage: 'en-US',
  publisher: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/en/blog/${slugOf(p.id)}`, site).href,
    datePublished: p.data.pubDate.toISOString(),
    ...(p.data.updatedDate ? { dateModified: p.data.updatedDate.toISOString() } : {}),
  })),
}).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={blogJsonLd} />

<BaseLayout
  lang={lang}
  title={t.meta.blogTitle}
  description={t.meta.blogDescription}
  alternates={altsFor('blog')}
>
  <div class="wrap pt-[clamp(56px,7vw,96px)]">
    <header class="section-head">
      <h1 class="t-display">{t.blog.eyebrow}</h1>
      <p class="max-w-[44ch] text-base leading-[1.6] text-muted">{t.blog.subtitle}</p>
    </header>

    {/* Filas de un bloque continuo, no tarjetas sueltas: cada entrada es una
        fila entre dos reglas de 2 px, con la portada a la izquierda. La fila
        entera es el enlace y lo que responde al ratón es el título. */}
    <div class="border-t-2 border-border">
      {
        posts.map((post) => (
          <article class="group relative grid gap-x-[clamp(24px,3vw,48px)] gap-y-5 border-b-2 border-border py-8 sm:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] lg:grid-cols-[20rem_minmax(0,1fr)]">
            <div class="relative aspect-[3/2] overflow-hidden bg-neutral-200">
              {/* `compact` deja el título fuera de la portada generada: la
                  fila ya lo muestra al lado. */}
              <PostCover
                title={post.data.title}
                image={post.data.heroImage}
                compact
                sizes="(min-width: 1024px) 320px, (min-width: 640px) 256px, 100vw"
              />
            </div>
            <div class="flex flex-col">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-faint">
                {/* Estreno y reescritura, en ese orden. Cuatro entradas de 2025
                    citan hechos de 2026 y con solo la fecha de estreno parecían
                    adivinar el futuro. La de estreno se queda porque es la que
                    ordena la lista. */}
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                {post.data.updatedDate &&
                  post.data.updatedDate.toDateString() !== post.data.pubDate.toDateString() && (
                    <time datetime={post.data.updatedDate.toISOString()}>
                      · {t.blog.updatedOn} {fmt(post.data.updatedDate)}
                    </time>
                  )}
                {post.data.tags.length > 0 && <span>· {post.data.tags.slice(0, 3).join(', ')}</span>}
              </div>
              <h2 class="t-h3-row mt-3 transition-colors group-hover:text-accent">
                <a href={localizedPath(`/blog/${slugOf(post.id)}`, lang)} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 max-w-[62ch] text-[15px] leading-[1.6] text-muted">{post.data.description}</p>
              <div class="mt-6">
                <span class="btn-ghost">{t.blog.readMore} →</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
