---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import PageNav from '../../../components/PageNav.astro';
import { getCollection, render } from 'astro:content';
import { content } from '../../../i18n/ui';
import { localizedPath } from '../../../i18n/utils';

const lang = 'en' as const;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^en\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

/*
  Indice lateral de la entrada, el mismo componente que usan las paginas de
  servicio. No se inventa nada: son los titulares de nivel 2 que el autor ya
  escribio en el markdown, con el `id` que Astro les genera solo, que es el
  mismo al que apunta el ancla.

  Por debajo de tres titulares no se pinta. Un indice de dos entradas ocupa
  una columna entera para decir algo que se ve de un vistazo bajando.
*/
const navItems = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ heading: h.text, anchor: h.slug }));
const hasNav = navItems.length >= 3;
const t = content[lang];

// Link to the Spanish translation (same translationId), if it exists.
const all = await getCollection('blog');
const es = all.find((p) => p.data.translationId === post.data.translationId && p.data.lang === 'es');
const alternates: Partial<Record<'es' | 'en', string>> = {
  en: localizedPath(`/blog/${post.id.replace(/^en\//, '')}`, 'en'),
};
if (es) alternates.es = localizedPath(`/blog/${es.id.replace(/^es\//, '')}`, 'es');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Article structured data.
const site = Astro.site ?? new URL('https://ideasforge.io');
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  inLanguage: 'en-US',
  ...(post.data.heroImage ? { image: new URL(post.data.heroImage, site).href } : {}),
  author: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
  publisher: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
});
/*
  `image` alimenta og:image y twitter:image. Sin esta linea, `heroImage` solo
  llegaba al JSON-LD y NINGUNA pagina pasaba imagen al layout: las 61 caian en
  el respaldo `/og-default.png`, que ademas no existia en `public/`. Las cuatro
  entradas con fotografia propia se compartian con la generica.

  Va aqui y no entre los atributos del componente: un comentario JSX entre
  llaves, dentro de la lista de atributos, lo lee el parser como una expresion
  y `astro check` canta «unterminated string literal», aunque el build lo
  tolere. (Y ojo al escribirlo: citar el cierre de bloque literal aqui dentro
  termina el comentario a media frase.)

  `undefined` es lo correcto cuando no hay foto: deja actuar al valor por
  defecto del layout.
*/
---

<BaseLayout
  lang={lang}
  title={`${post.data.title}, Ideasforge`}
  description={post.data.description}
  alternates={alternates}
  ogType="article"
  image={post.data.heroImage}
>
  <script is:inline slot="head" type="application/ld+json" set:html={articleJsonLd} />
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
  <div class={hasNav ? 'lg:grid lg:grid-cols-[14rem_minmax(0,1fr)]' : ''}>
    {hasNav && (
      <div class="hidden lg:block">
        {/* Mismo tope de altura que en las paginas largas: una columna fija
            mas alta que la ventana deja las ultimas entradas inalcanzables. */}
        <div class="sticky top-28 max-h-[calc(100vh-9rem)] overflow-y-auto overscroll-contain pb-10 pr-8">
          <PageNav items={navItems} heading={t.blog.tocHeading} />
        </div>
      </div>
    )}
  <article class={hasNav ? 'lg:border-l lg:border-border lg:pl-10' : 'mx-auto max-w-3xl'}>
    {/* Misma flecha que el resto del sitio, reflejada. Antes era el caracter
        «←», que se dibuja con la tipografia y no casa con las demas. */}
    <a
      href={localizedPath('/blog', lang)}
      class="group inline-flex items-center gap-1.5 font-mono text-sm text-muted transition-colors hover:text-fg"
    >
      <Icon name="flecha-izquierda" size={16} class="shrink-0 transition-transform duration-300 group-hover:-translate-x-0.5" />
      {t.blog.backToBlog}
    </a>

    <header class="mt-6 border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-3">
        <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-faint">
          {t.blog.publishedOn} {fmt(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <time datetime={post.data.updatedDate.toISOString()} class="font-mono text-xs text-faint">
            · {t.blog.updatedOn} {fmt(post.data.updatedDate)}
          </time>
        )}
        {post.data.tags.map((tag) => (
          <span class="rounded-full border border-border px-2.5 py-0.5 text-xs text-muted">{tag}</span>
        ))}
      </div>
      <h1 class="mt-4 text-balance text-4xl font-semibold leading-tight tracking-tight text-fg">
        {post.data.title}
      </h1>
      <p class="mt-4 text-lg text-muted">{post.data.description}</p>
    </header>

    <div
      class="prose mt-10 max-w-none prose-headings:tracking-tight prose-headings:text-fg prose-a:text-accent prose-strong:text-fg"
    >
      <Content />
    </div>
  </article>
  </div>
  </div>
</BaseLayout>
