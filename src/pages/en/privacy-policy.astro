---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { content } from '../../i18n/ui';
import { altsFor } from '../../i18n/utils';
import { EMPRESA, empresaCompleta } from '../../lib/empresa';

const lang = 'en' as const;
const t = content[lang];
---

<BaseLayout
  lang={lang}
  title={`${t.footer.privacy}, Ideasforge`}
  description="What information we collect on the Ideasforge site, what we use it for, who it is shared with and how we protect it."
  alternates={altsFor('privacy')}
>
  <article class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-24">
    <h1 class="text-4xl font-bold tracking-tight text-fg sm:text-5xl">{t.footer.privacy}</h1>

    <div class="prose mt-10 max-w-none prose-headings:text-fg prose-headings:tracking-tight prose-a:text-accent prose-strong:text-fg">
      {/* The controller comes first because it is the first thing the reader
           needs: who holds their data and where to write. */}
      <h2>1. Who is responsible for your data</h2>
      {empresaCompleta ? (
        <>
          <p>
            The controller of the data you give us through this site is
            {' '}<strong>{EMPRESA.razonSocial}</strong>{EMPRESA.nif ? `, tax number ${EMPRESA.nif},` : ','}
            {' '}based at {EMPRESA.domicilio}, Spain.
          </p>
          <p>
            For anything to do with your data, including exercising the rights described below,
            write to
            {' '}<a href={`mailto:${EMPRESA.correo}`} class="link-inline">{EMPRESA.correo}</a>.
            We answer within one month at the latest.
          </p>
          <p>
            If you believe we have not handled your request properly, you can complain to the
            Spanish data protection authority, the <strong>Agencia Española de Protección de
            Datos</strong>, at
            {' '}<a href="https://www.aepd.es" rel="noopener noreferrer" target="_blank" class="link-inline">www.aepd.es</a>.
          </p>
        </>
      ) : (
        <p>
          <strong>Pending.</strong> This section is filled from <code>src/lib/empresa.ts</code>,
          and the checker refuses to publish the site while it is empty, so this page cannot ship
          with a hole where the controller’s identity belongs.
        </p>
      )}

      <h2>2. Information We Collect</h2>
      <p>
        We collect personal information that you voluntarily provide when you use our website, such as:
      </p>
      <ul>
        <li>Your name</li>
        <li>Email address</li>
        <li>Messages or enquiries you send through our contact form</li>
        <li>Any other information you choose to provide</li>
      </ul>

      <h2>3. How We Use Your Information</h2>
      <p>We may use the information we collect for the following purposes:</p>
      <ul>
        <li>To provide, operate and maintain our website and services</li>
        <li>To respond to your enquiries and requests</li>
        <li>To improve our services, features and user experience</li>
        <li>To send you information and updates related to our services (only if you choose to subscribe)</li>
        <li>To comply with legal obligations</li>
      </ul>

      <h2>4. Sharing Information</h2>
      <p>We do not share your personal information with third parties, except in the following cases:</p>
      <ul>
        <li>When required by law or in response to legal requests</li>
        <li>To enforce our terms and policies or protect our rights</li>
        <li>With your explicit consent</li>
      </ul>

      <h2>5. Security of Your Information</h2>
      <p>
        We take reasonable precautions to protect your personal information. However, please note
        that no method of transmission over the Internet is 100% secure, and we cannot guarantee
        absolute security.
      </p>

      <h2>6. Changes to This Privacy Policy</h2>
      <p>
        We may update this Privacy Policy from time to time to reflect changes in our practices or
        in legal obligations. When we make changes, we will revise the date at the top of this
        policy. Please review this policy periodically to stay informed about how we protect your
        information.
      </p>
    </div>
  </article>
</BaseLayout>
