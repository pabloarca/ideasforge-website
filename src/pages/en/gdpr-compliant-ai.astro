---
import LongFormPage from '../../components/LongFormPage.astro';
import { content } from '../../i18n/ui';
import { altsFor } from '../../i18n/utils';

const lang = 'en' as const;
// EN-only for now (see the routeMap note): Spanish demand not measurable yet.
const page = content[lang].pages.compliance!;
---

<LongFormPage lang={lang} page={page} alternates={altsFor('compliance')} />
