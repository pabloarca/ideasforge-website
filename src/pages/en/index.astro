---
/*
  Portada. El orden de los bloques es el del diseño de octubre de 2026 y cada
  uno lee su texto de `content[lang].home`.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import LogoMarquee from '../../components/home/LogoMarquee.astro';
import AboutSplit from '../../components/home/AboutSplit.astro';
import ServicesPanel from '../../components/home/ServicesPanel.astro';
import CasesGallery from '../../components/home/CasesGallery.astro';
import WhenAI from '../../components/home/WhenAI.astro';
import MethodSteps from '../../components/home/MethodSteps.astro';
import SecuritySplit from '../../components/home/SecuritySplit.astro';
import SectorSwitcher from '../../components/home/SectorSwitcher.astro';
import PostsCarousel from '../../components/home/PostsCarousel.astro';
import FaqAccordion from '../../components/home/FaqAccordion.astro';
import ContactForm from '../../components/home/ContactForm.astro';
import { content } from '../../i18n/ui';
import { altsFor } from '../../i18n/utils';

const lang = 'en' as const;
const meta = content[lang].meta;
---

<BaseLayout
  lang={lang}
  title={meta.homeTitle}
  description={meta.homeDescription}
  alternates={altsFor('home')}
>
  <Hero lang={lang} />
  <LogoMarquee lang={lang} />
  <AboutSplit lang={lang} />
  <ServicesPanel lang={lang} />
  <CasesGallery lang={lang} />
  <WhenAI lang={lang} />
  <MethodSteps lang={lang} />
  <SecuritySplit lang={lang} />
  <SectorSwitcher lang={lang} />
  <PostsCarousel lang={lang} />
  <FaqAccordion lang={lang} />
  <ContactForm lang={lang} />
</BaseLayout>
