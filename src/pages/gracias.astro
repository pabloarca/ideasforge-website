---
/*
  Acuse de los dos formularios, el de contacto de la home y el de exploración.

  Existe para no soltar al visitante en la página de confirmación de
  Web3Forms, que es de ellos y aparece justo en el momento de más confianza de
  toda la visita. A cambio de una página, el acuse lo damos nosotros y con
  nuestras palabras.

  Va `noindex` porque nadie la busca: solo tiene sentido detrás del envío. Sale
  también del sitemap, en `astro.config.mjs`.

  El par inglés existe desde el 1 sep 2026, así que las alternativas salen ya
  del `routeMap` como en cualquier otra página.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../i18n/ui';
import { altsFor } from '../i18n/utils';
import { EMPRESA } from '../lib/empresa';

const lang = 'es' as const;
const t = content[lang].thanks;
---

<BaseLayout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={altsFor('thanks')}
  noindex
>
  <section class="wrap pt-[clamp(56px,7vw,96px)]">
    <span class="kicker mb-7">{t.eyebrow}</span>
    <h1 class="t-display max-w-[22ch]">{t.title}</h1>

    <div class="mt-8 max-w-[62ch] space-y-5 text-[17px] leading-[1.6] text-muted">
      {t.body.map((p) => <p>{p}</p>)}
      <p>
        {t.extraPre}<a href={`mailto:${EMPRESA.correo}`} class="link-inline">{EMPRESA.correo}</a
        >{t.extraPost}
      </p>
    </div>

    <p class="mt-10 max-w-[62ch] border-t-2 border-border pt-8 text-[17px] leading-[1.6] text-muted">
      {t.blogPre}<a href="/blog" class="link-inline">{t.blogLink}</a>{t.blogPost}
    </p>
  </section>
  {/*
    Conversión. Se mide AQUÍ y no en el `submit` del formulario por dos
    razones. La primera es que aquí ya se sabe que llegó: el envío puede
    fallar y el evento se habría contado igual. La segunda es que un evento
    disparado justo antes de una navegación a otro dominio se pierde a
    menudo, porque el navegador cancela la petición en curso.

    No viaja ni un dato del formulario. `forge.track` solo acepta cinco
    parámetros y ninguno es de texto libre.
  */}
  <script is:inline define:vars={{ idioma: lang }}>
    if (window.forge) window.forge.track('formulario_enviado', { idioma: idioma });
  </script>
</BaseLayout>
