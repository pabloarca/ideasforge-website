---
import BaseLayout from '../layouts/BaseLayout.astro';
import RailDots from '../components/RailDots.astro';
import DotReveal from '../components/DotReveal.astro';
import EdgeRails from '../components/EdgeRails.astro';
import Hero from '../components/Hero.astro';
import TrustedBy from '../components/TrustedBy.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import Methodology from '../components/Methodology.astro';
import Integrations from '../components/Integrations.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { content } from '../i18n/ui';
import { altsFor } from '../i18n/utils';

const lang = 'es' as const;
const meta = content[lang].meta;
---

<BaseLayout
  lang={lang}
  title={meta.homeTitle}
  description={meta.homeDescription}
  alternates={altsFor('home')}
>
  <EdgeRails />
  <DotReveal />
  <Hero lang={lang} />
  <TrustedBy lang={lang} />
  <CaseStudies lang={lang} />
  {/*
    Costuras entre secciones. Desde el 22 ago 2026 todas las secciones son
    blancas: la banda gris intercalada partia la pagina en modulos y se
    retiro en favor de la linea, que separa igual y habla mas bajo.

    Con el fondo unico ya no hay cambios de color que hagan de costura, asi
    que TODAS llevan `line` y la dibujan ellas. Si alguna vez vuelve una
    seccion de otro color, esa costura concreta puede prescindir de `line`.
  */}
  <RailDots seed={419} line />
  <Services lang={lang} />
  <RailDots seed={431} line />
  <WhyUs lang={lang} />
  <RailDots seed={443} line />
  <Methodology lang={lang} />
  <RailDots seed={457} line />
  <Integrations lang={lang} />
  <RailDots seed={541} line />
  <BlogPreview lang={lang} />
  <RailDots seed={547} line />
  <Faq lang={lang} />
  <RailDots seed={557} line />
  <Contact lang={lang} />
</BaseLayout>
