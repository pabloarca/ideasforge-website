---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, localizedPath } from '../i18n/utils';

// Best-effort language from the requested URL (static 404 defaults to ES).
const lang = getLangFromUrl(Astro.url);
const copy =
  lang === 'es'
    ? { title: 'Página no encontrada', body: 'La página que buscas no existe o se ha movido.', cta: 'Volver al inicio' }
    : { title: 'Page not found', body: 'The page you are looking for does not exist or has moved.', cta: 'Back to home' };
---

<BaseLayout lang={lang} title={`404, ${copy.title}`} description={copy.body}>
  <section class="wrap min-h-[50vh] pt-[clamp(56px,7vw,96px)]">
    <span class="kicker mb-7">404</span>
    <h1 class="t-display max-w-[18ch]">{copy.title}</h1>
    <p class="mt-6 max-w-[46ch] text-[17px] leading-[1.55] text-muted">{copy.body}</p>
    <a href={localizedPath('/', lang)} class="btn-primary hover:btn-primary-hover mt-9">
      {copy.cta}
    </a>
  </section>
</BaseLayout>
