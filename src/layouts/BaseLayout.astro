---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, languages, content } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /**
   * Alternate-language URLs for this exact page, e.g.
   * { es: '/blog', en: '/en/blog' }. Used for hreflang + the language switcher.
   * Defaults to the homepage of each language if a page doesn't pass it.
   */
  alternates?: Partial<Record<Lang, string>>;
  /** og:type, use 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /**
   * Fechas del artículo, solo para posts. Van a Open Graph, que es lo que leen
   * las redes al construir la vista previa. El JSON-LD ya las llevaba, pero es
   * otro consumidor: uno alimenta al buscador y el otro a quien comparte.
   */
  publishedTime?: Date;
  modifiedTime?: Date;
  /**
   * Imagen para compartir. Si la página no pasa ninguna, se usa la portada
   * generada para ella, que se construye al terminar el build a partir de
   * este mismo `og:image` (ver `scripts/integracion-og.mjs`). Las páginas con
   * fotografía propia, como los posts con `heroImage`, pasan la suya y ganan.
   */
  image?: string;
}

const {
  lang,
  title,
  description,
  alternates = { es: '/', en: '/en' },
  ogType = 'website',
  publishedTime,
  modifiedTime,
  image,
} = Astro.props;

const site = Astro.site ?? new URL('https://ideasforge.io');
/*
  La ruta sin barra final. Es la forma canónica del sitio (ver
  `trailingSlash` en astro.config) y la que usan todos los enlaces internos, así
  que de aquí salen la canónica, og:url y la miga de pan. La raíz es la
  excepción obvia: `https://ideasforge.io` no existe sin su barra.
*/
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(canonicalPath, site).href;
/*
  La ruta de la portada sale de la propia ruta de la página, así que una
  página nueva la tiene sin declarar nada. La portada en sí no existe todavía
  cuando se escribe esta etiqueta: la genera la integración al acabar el
  build, leyendo precisamente esta etiqueta para saber cuáles hacen falta.
*/
const ogPropia = '/og' + (canonicalPath === '/' ? '/index' : canonicalPath) + '.png';
const ogImage = new URL(image ?? ogPropia, site).href;

// Organization structured data, shared by every page.
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ideasforge',
  url: site.href,
  logo: new URL('/ideasforge-logo.svg', site).href,
});

/*
  Miga de pan estructurada. Se deduce de la propia ruta en vez de pasarla
  pagina por pagina: asi ninguna se queda sin ella al crearse.

  Google la usa para sustituir la URL cruda del resultado por la ruta legible.
  El tramo intermedio apunta a las anclas de la home porque `/servicios` y
  `/casos` no existen como paginas: son secciones. Un elemento de la miga
  tiene que ser una URL real, y esas lo son.
*/
const rutaSinIdioma = (lang === 'en' ? canonicalPath.replace(/^\/en/, '') : canonicalPath) || '/';
const segmentos = rutaSinIdioma.split('/').filter(Boolean);
const nav = content[lang].nav;
const inicio = lang === 'en' ? '/en' : '/';
const ramas: Record<string, { name: string; href: string }> = {
  blog: { name: nav.blog, href: lang === 'en' ? '/en/blog' : '/blog' },
  servicios: { name: nav.services, href: `${inicio}#servicios` },
  services: { name: nav.services, href: `${inicio}#servicios` },
  casos: { name: nav.projects, href: `${inicio}#proyectos` },
};
const migas = segmentos.length
  ? [
      { name: nav.home, href: inicio },
      ...(segmentos.length > 1 && ramas[segmentos[0]] ? [ramas[segmentos[0]]] : []),
      { name: title.replace(/, Ideasforge$/, ''), href: canonicalPath },
    ]
  : [];
const breadcrumbJsonLd = migas.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: migas.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.name,
        item: new URL(m.href, site).href,
      })),
    })
  : null;

/*
  Service en las cuatro paginas de servicio de cada idioma. Se deduce de la
  ruta, igual que la miga, para que una pagina de servicio nueva lo herede.

  SIN `areaServed` a proposito. Declarar un territorio aqui contradiria la
  decision de no dar a entender que solo servimos a la UE, y los datos de
  Search Console dicen que Latinoamerica pesa mas que Espana.
*/
const esServicio = /^\/(servicios|en\/services)\//.test(canonicalPath);
const serviceJsonLd = esServicio
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: title.replace(/, Ideasforge$/, ''),
      description,
      url: canonical,
      provider: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
    }).replace(/</g, '\\u003c')
  : null;

// hreflang entries. x-default points at the default (Spanish) version.
const hreflangs = (Object.keys(languages) as Lang[])
  .filter((l) => alternates[l])
  .map((l) => ({
    code: l === 'es' ? 'es-ES' : 'en-US',
    href: new URL(alternates[l] as string, site).href,
  }));
// Spanish is the site default, but a page that only exists in one language
// (e.g. the EN-only cost guide) must not declare the Spanish home as its
// x-default: fall back to the page's own URL instead.
const xDefault = new URL(alternates.es ?? alternates[lang] ?? '/', site).href;
---

<!doctype html>
<html lang={lang === 'es' ? 'es-ES' : 'en-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      El .ico va primero y sin `sizes` a propósito: es el que piden a ciegas los
      navegadores viejos y muchas herramientas de terceros, que hasta hoy se
      llevaban un 404 de `/favicon.ico`. Lleva 16, 32 y 48 dentro.
    -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Sin esto Google recorta las imágenes a una miniatura en los resultados y
      en Discover. No cambia el posicionamiento, cambia cuánto ocupa el
      resultado, que es lo que decide si alguien lo pulsa.
    -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!--
      Space Grotesk servida por nosotros, un fichero variable de 22 KB. La
      declaración vive en global.css; aquí solo se precarga.

      El `preload` es lo que arregla el salto de maquetación: sin él, el
      navegador no descubre la tipografía hasta que ha leído y aplicado el CSS,
      pinta con la de respaldo y recoloca el texto cuando llega la buena. Con
      él la pide en la primera tanda y llega antes de pintar.

      `crossorigin` es obligatorio aunque el fichero sea nuestro: las fuentes
      se piden en modo anónimo, y sin el atributo el navegador descarga el
      fichero dos veces.

      Antes esto eran tres etiquetas a Google, con dos familias, ocho pesos y
      224 ms de bloqueo de render.
    -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {hreflangs.map((h) => <link rel="alternate" hreflang={h.code} href={h.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!--
      El canal del idioma de la página, no los dos: quien se suscribe lo hace en
      uno, y ofrecer el otro en el mismo sitio invita a acabar leyendo la mitad
      en un idioma que no se pidió. Va en todas las páginas y no solo en el
      blog, que es donde los lectores lo buscan.
    -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${content[lang].meta.blogTitle.replace(/, Ideasforge$/, '')} · Ideasforge`}
      href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    <meta property="og:site_name" content="Ideasforge" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={orgJsonLd} />
    {
      breadcrumbJsonLd && (
        <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />
      )
    }
    {serviceJsonLd && <script is:inline type="application/ld+json" set:html={serviceJsonLd} />}
    <slot name="head" />
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Header lang={lang} alternates={alternates} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
