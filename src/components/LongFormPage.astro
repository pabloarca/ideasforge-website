---
/*
  Shared renderer for the long-form pages (guide, service clusters, about).
  Pages stay thin: they pick their LongFormPageContent from ui.ts and pass it
  here together with the routeMap alternates.

  Two optional levers matter for copy:
  - `hero.ctaHref` lets informational pages point at an in-page anchor instead
    of asking for the sale on first contact.
  - `stats` surfaces hard numbers right under the hero. Competitors rarely show
    any, so this is where the page earns trust fastest.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { type Lang, type LongFormPageContent } from '../i18n/ui';
import ClusterPosts from './ClusterPosts.astro';
import FaqList from './FaqList.astro';
import { pillarFromUrl } from '../lib/cluster';
import FlowDiagram from './FlowDiagram.astro';
import LatticeDots from './LatticeDots.astro';
import RouteReveal from './RouteReveal.astro';
import { localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: LongFormPageContent;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, page, alternates } = Astro.props;
const heroCta = page.hero.ctaHref ?? localizedPath('/#contacto', lang);
const hasFaq = Boolean(page.faq && page.faq.length > 0);
// Keep the light/dark section rhythm consistent once the FAQ is optional.
const faqBg = page.sections.length % 2 === 0 ? 'bg-bg-soft' : 'bg-bg';

/* Ancla estable para cada sección: la suya si la declara, y si no una salida
   del encabezado. Solo se usa dentro de la página, así que un encabezado que
   cambie mueve su ancla sin romper nada de fuera. */
const anchorOf = (sec: { id?: string; heading: string }) =>
  sec.id ??
  sec.heading
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 40);

/* Índice de partes. Se construye recorriendo las secciones y quedándose con
   la primera de cada parte, que es a donde apunta el enlace. Una página sin
   `part` en ninguna sección no tiene índice y se comporta como siempre. */
const parts: Array<{ name: string; anchor: string; from: number }> = [];
page.sections.forEach((sec, i) => {
  if (sec.part && sec.part !== parts[parts.length - 1]?.name) {
    parts.push({ name: sec.part, anchor: anchorOf(sec), from: i });
  }
});
const hasParts = parts.length > 1;
const hasChecklist = page.sections.some((sec) => sec.kind === 'checklist');
---

<BaseLayout
  lang={lang}
  title={page.metaTitle}
  description={page.metaDescription}
  alternates={alternates}
>
  <!-- Hero -->
  <section class="bg-bg py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
      {page.hero.eyebrow && <span class="eyebrow-pill">{page.hero.eyebrow}</span>}
      <h1 class="mt-7 text-balance text-4xl font-bold leading-[1.05] tracking-tight text-fg sm:text-5xl lg:text-6xl">
        {page.hero.title}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-pretty text-lg leading-relaxed text-muted sm:text-xl">
        {page.hero.subtitle}
      </p>
      <div class="mt-9">
        <a href={heroCta} class="btn-primary hover:btn-primary-hover">
          {page.hero.cta}
        </a>
      </div>
    </div>

    {
      /*
        Evidence block, not a stat grid. It used to be 2-3 identical centred
        cards in equal columns, which is the shape every generated landing
        page has. Two things changed and both are deliberate:

        - It runs each figure into its own sentence, so the lines end at
          different widths. Equal columns force equal-length text; ragged
          lines do not, and the labels in ui.ts are already written as the
          continuation of their number ("+3 horas" + "al día que...").
        - It sits left-aligned under a centred hero. The asymmetry is the
          point: it reads as evidence someone chose to show, not as a
          template slot that had to be filled.

        The figure keeps the accent colour and extra weight, so the block is
        still scannable without reading it.
      */
      page.stats && page.stats.length > 0 && (
        <div class="mx-auto mt-14 max-w-3xl px-5 sm:px-8">
          <dl class="border-l-2 border-border pl-5 sm:pl-6">
            {page.stats.map((s) => (
              <div class="py-1.5">
                <dt class="inline text-lg font-bold tracking-tight text-accent sm:text-xl">
                  {s.value}
                </dt>{' '}
                <dd class="inline text-[15px] leading-relaxed text-muted">{s.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </section>

  {
    /*
      Índice de partes. Solo aparece cuando la página está dividida, que en la
      práctica es cuando es larga de verdad. Usa la retícula continua de la
      home, así que se lee como parte del sitio y no como un sumario pegado.
    */
    hasParts && (
      <section class="bg-bg pb-4">
        <div class="mx-auto max-w-5xl px-5 sm:px-8">
          {page.tocHeading && (
            <p class="mb-5 text-xs font-semibold uppercase tracking-[0.16em] text-faint">
              {page.tocHeading}
            </p>
          )}
          <ol class="grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
            {parts.map((part, i) => (
              <li class="relative bg-bg">
                <a
                  href={`#${part.anchor}`}
                  class="group flex h-full flex-col justify-between gap-6 p-6 transition-colors duration-300 hover:bg-border/30"
                >
                  <span class="font-mono text-xs text-faint">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[15px] font-bold leading-snug text-fg">{part.name}</span>
                </a>
                <LatticeDots seed={811 + i * 7} />
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- Body sections, alternating background -->
  {
    page.sections.map((section, i) => (
      <section
        id={anchorOf(section)}
        class={`${i % 2 === 0 ? 'bg-bg-soft' : 'bg-bg'} scroll-mt-24 py-14 sm:py-16`}
      >
        <div class="mx-auto max-w-3xl px-5 sm:px-8">
          {/* Portada de parte. Se abre cuando esta seccion estrena parte, y
              usa el mismo filete que separa secciones en la home. */}
          {parts.some((pt) => pt.from === i) && (
            <div class="mb-10 border-t border-border pt-5">
              <p class="font-mono text-xs uppercase tracking-[0.16em] text-accent">
                {`${String(parts.findIndex((pt) => pt.from === i) + 1).padStart(2, '0')} · ${section.part}`}
              </p>
            </div>
          )}

          <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">{section.heading}</h2>
          <div class="mt-5 space-y-4">
            {section.paragraphs.map((p) => (
              <p class="text-[15px] leading-relaxed text-muted sm:text-base">{p}</p>
            ))}
          </div>
          {section.diagram && <FlowDiagram lang={lang} />}

          {/* Reticula continua: elementos paralelos, el idioma de «Lo que
              construimos». Dos columnas y no cuatro porque aqui cada elemento
              es una frase larga, no un titulo. */}
          {section.bullets && section.kind === 'lattice' && (
            <ul class="mt-7 grid gap-px border border-border bg-border sm:grid-cols-2">
              {section.bullets.map((b, k) => (
                <li class="relative bg-bg">
                  <div class="flex h-full gap-3 p-6">
                    <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
                      <Icon name="correcto" size={14} />
                    </span>
                    <span class="text-[15px] leading-relaxed text-fg">{b}</span>
                  </div>
                  <LatticeDots seed={907 + i * 13 + k} />
                </li>
              ))}
            </ul>
          )}

          {/* Ruta numerada: secuencias y listas que se recorren una a una, el
              idioma de «Como trabajamos». El filete se dibuja al bajar. */}
          {section.bullets && section.kind === 'checklist' && (
            <ol class="mt-8">
              {section.bullets.map((b, k) => (
                <li
                  data-route-step
                  class="grid grid-cols-[2.25rem_1fr] gap-x-4 sm:grid-cols-[2.75rem_1fr] sm:gap-x-6"
                >
                  <div class="flex flex-col items-center">
                    <span class="route-marker grid h-9 w-9 shrink-0 place-items-center rounded-full border-2 border-border bg-bg font-mono text-xs font-bold text-accent sm:h-11 sm:w-11 sm:text-sm">
                      {String(k + 1).padStart(2, '0')}
                    </span>
                    {k < section.bullets!.length - 1 && (
                      <span class="route-line mt-3 w-0.5 flex-1 rounded-full bg-border" aria-hidden="true" />
                    )}
                  </div>
                  <div class={k < section.bullets!.length - 1 ? 'pb-8' : ''}>
                    <p class="text-[15px] leading-relaxed text-fg sm:text-base">{b}</p>
                  </div>
                </li>
              ))}
            </ol>
          )}

          {section.bullets && (section.kind ?? 'prose') === 'prose' && (
            <ul class="mt-6 space-y-3">
              {section.bullets.map((b) => (
                <li class="flex items-start gap-3 text-[15px] leading-relaxed text-fg sm:text-base">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent text-bg" aria-hidden="true">
                    <Icon name="correcto" size={12} />
                  </span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          )}
          {section.link && (
            <div class="mt-6">
              {/* Misma flecha que el resto del sitio. Antes era el caracter «→»,
                  que se dibuja con la tipografia y no casa con las demas. */}
              <a
                href={section.link.href}
                class="group inline-flex items-center gap-1.5 text-accent"
              >
                <span class="underline-offset-2 group-hover:underline">{section.link.label}</span>
                <Icon name="flecha-derecha" size={16} class="shrink-0 transition-transform duration-300 group-hover:translate-x-0.5" />
              </a>
            </div>
          )}
        </div>
      </section>
    ))
  }

  {/* Las entradas que desarrollan lo que cuenta la página. La ruta sale de la
      URL, así que la página no tiene que declararse a sí misma, y el conjunto
      se deriva de los enlaces que los propios posts ya traen. Va detrás del
      cuerpo y delante de la FAQ, que junto al CTA forma el cierre. */}
  <ClusterPosts lang={lang} pillar={pillarFromUrl(Astro.url.pathname)} bg={faqBg === 'bg-bg-soft' ? 'bg-bg' : 'bg-bg-soft'} />

  <!-- FAQ (skipped on pages without one, e.g. About) -->
  {
    hasFaq && (
      <section class={`${faqBg} py-14 sm:py-16`}>
        <div class="mx-auto max-w-3xl px-5 sm:px-8">
          <h2 class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">{page.faqHeading}</h2>
          {/* Misma pieza que la FAQ de la home. Antes eran tarjetas estaticas
              con sombra: la unica FAQ del sitio con otro aspecto y sin abrirse. */}
          <FaqList items={page.faq!} group="faq-page" class="mt-7" />
        </div>
      </section>
    )
  }

  <!-- Final CTA -->
  <section class="bg-bg-soft py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{page.cta.heading}</h2>
      <p class="mt-4 text-lg text-muted">{page.cta.body}</p>
      <div class="mt-7">
        <a href={localizedPath('/#contacto', lang)} class="btn-primary hover:btn-primary-hover">
          {page.cta.button}
        </a>
      </div>
    </div>
  </section>
  {hasChecklist && <RouteReveal />}
</BaseLayout>
