---
/*
  Shared renderer for the long-form pages (guide, service clusters, about).
  Pages stay thin: they pick their LongFormPageContent from ui.ts and pass it
  here together with the routeMap alternates.

  Aspecto: el del diseño de octubre de 2026, el mismo sistema de la portada.
  Héroe alineado a la izquierda con rótulo, titular y entradilla; cuerpo a dos
  columnas con el índice fijo; reglas de 2 px entre secciones; y un cierre que
  repite el bloque de contacto de la portada, con la regla negra encima. Nada
  va centrado, no hay iconos y el acento se queda en rótulos, enlaces y los
  cuadrados de las listas.

  Two optional levers matter for copy:
  - `hero.ctaHref` lets informational pages point at an in-page anchor instead
    of asking for the sale on first contact.
  - `stats` surfaces hard numbers right under the hero. Competitors rarely show
    any, so this is where the page earns trust fastest.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNav from './PageNav.astro';
import { type Lang, type LongFormPageContent } from '../i18n/ui';
import ClusterPosts from './ClusterPosts.astro';
import FaqList from './FaqList.astro';
import { pillarFromUrl } from '../lib/cluster';
import PizarraPorNombre from './pizarra/PizarraPorNombre.astro';
import { localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: LongFormPageContent;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, page, alternates } = Astro.props;
const heroCta = page.hero.ctaHref ?? localizedPath('/#contacto', lang);
const hasFaq = Boolean(page.faq && page.faq.length > 0);

/* Ancla estable para cada sección: la suya si la declara, y si no una salida
   del encabezado. Solo se usa dentro de la página, así que un encabezado que
   cambie mueve su ancla sin romper nada de fuera. */
const anchorOf = (sec: { id?: string; heading: string }) =>
  sec.id ??
  sec.heading
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 40);

/* Partes. Se recorren las secciones y se guarda la primera de cada parte,
   que es donde se abre su portada. Una página sin `part` en ninguna sección
   no tiene partes y se comporta como siempre. */
const parts: Array<{ name: string; anchor: string; from: number }> = [];
page.sections.forEach((sec, i) => {
  if (sec.part && sec.part !== parts[parts.length - 1]?.name) {
    parts.push({ name: sec.part, anchor: anchorOf(sec), from: i });
  }
});
const hasParts = parts.length > 1;

/* Entradas del índice lateral: TODAS las secciones, con el rótulo de parte
   en la que estrena cada una. Antes el índice solo listaba las partes, que
   en una página de seis secciones deja fuera lo que el lector busca. */
const navItems = page.sections.map((sec, i) => {
  const abre = parts.findIndex((pt) => pt.from === i);
  return {
    heading: sec.heading,
    anchor: anchorOf(sec),
    part: abre >= 0 ? parts[abre].name : undefined,
    partIndex: abre >= 0 ? abre : undefined,
  };
});
/* El índice acompaña a partir de cuatro secciones. Con menos, el lector ve
   la página entera de un vistazo y una columna fija solo le roba ancho. */
// El número de secciones decide por defecto, pero una página puede negarse:
// las cortas se leen mejor a una columna y el índice lateral las disfraza de
// pilar de posicionamiento cuando no lo son.
const hasNav = page.nav ?? page.sections.length >= 4;

const dos = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  lang={lang}
  title={page.metaTitle}
  description={page.metaDescription}
  alternates={alternates}
>
  <!-- Hero -->
  <section class="wrap pb-[clamp(48px,6vw,80px)] pt-[clamp(56px,7vw,96px)]">
    {page.hero.eyebrow && <span class="kicker lf-in mb-7" style="--d:0s">{page.hero.eyebrow}</span>}
    <h1 class="t-display lf-in max-w-[24ch]" style="--d:.08s">{page.hero.title}</h1>
    <p class="lf-in mt-6 max-w-[62ch] text-[17px] leading-[1.55] text-muted" style="--d:.16s">
      {page.hero.subtitle}
    </p>
    {page.updated && <p class="num lf-in mt-5" style="--d:.2s">{page.updated}</p>}
    {/* El botón es opcional: una guía puede no querer llamada a la acción
        en el héroe, para no pedir nada antes de haber explicado nada. */}
    {
      page.hero.cta && (
        <div class="lf-in mt-9" style="--d:.24s">
          <a href={heroCta} class="btn-primary hover:btn-primary-hover">
            {page.hero.cta}
          </a>
        </div>
      )
    }

    {
      /*
        Evidence block. Cada cifra abre su propia columna bajo una regla
        negra, con el número a tamaño de titular y su frase debajo: las
        etiquetas de ui.ts ya están escritas como continuación del número
        («+3 horas» + «al día que...»). Las columnas salen de `auto-fit`, así
        que dos cifras ocupan dos columnas y tres, tres, sin huecos.
      */
      page.stats && page.stats.length > 0 && (
        <dl class="mt-14 grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-x-8 gap-y-8 border-t-2 border-fg pt-6">
          {page.stats.map((s) => (
            <div>
              <dt class="t-h3-panel">{s.value}</dt>
              <dd class="mt-3 max-w-[36ch] text-[15px] leading-[1.6] text-muted">{s.label}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </section>

  {
    /*
      Índice de partes para pantallas estrechas. En ancho grande manda la
      columna lateral, que acompaña toda la lectura; aquí, donde esa columna
      no cabe, se deja una retícula con las partes como sumario de entrada.
      Los dos llevan a las mismas anclas.
    */
    hasParts && (
      <section class="wrap pb-10 lg:hidden">
        {page.tocHeading && <p class="mb-5 text-[13px] text-muted">{page.tocHeading}</p>}
        <ol class="ruled-grid sm:grid-cols-2">
          {parts.map((part, i) => (
            <li class:list={[parts.length % 2 === 1 && i === parts.length - 1 && 'sm:col-span-2']}>
              <a
                href={`#${part.anchor}`}
                class="flex h-full flex-col justify-between gap-6 px-5 py-6 transition-colors hover:text-accent"
              >
                <span class="num">{dos(i + 1)}</span>
                <span class="text-lg font-medium leading-tight tracking-[-0.015em]">{part.name}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/*
    Cuerpo a dos columnas. A la izquierda el índice, pegado mientras se lee;
    a la derecha el texto, separado por una regla vertical.

    Un solo fondo en toda la página: quien separa las secciones es la regla
    de 2 px, que es el lenguaje del resto del sitio.
  */}
  <section class="wrap">
    <div class:list={['border-t-2 border-border', hasNav && 'lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]']}>
      {
        hasNav && (
          <div class="hidden lg:block">
            {/* Tope de altura: los pilares largos tienen veinte secciones y
                una columna fija de ese alto se sale de la ventana, dejando
                las últimas inalcanzables. Con el tope, el índice se
                desplaza por dentro y el resto de la página no se entera. */}
            <div class="no-scrollbar sticky top-[104px] max-h-[calc(100vh-8rem)] overflow-y-auto overscroll-contain pb-10 pr-8 pt-12">
              <PageNav items={navItems} heading={page.tocHeading} />
            </div>
          </div>
        )
      }

      <div class={hasNav ? 'lg:border-l-2 lg:border-border lg:pl-12' : 'max-w-[46rem]'}>
        {
          page.sections.map((section, i) => (
            <section
              id={anchorOf(section)}
              class:list={['lf-seccion scroll-mt-[104px] py-12 sm:py-14', i > 0 && 'border-t-2 border-border']}
            >
              <div class={hasNav ? 'max-w-[44rem]' : ''}>
                {/* Portada de parte. Se abre cuando esta sección estrena parte. */}
                {parts.some((pt) => pt.from === i) && (
                  <p class="kicker mb-5">
                    {`${dos(parts.findIndex((pt) => pt.from === i) + 1)} · ${section.part}`}
                  </p>
                )}

                <h2 class="text-[clamp(24px,2.4vw,32px)] leading-[1.12] tracking-[-0.025em]">
                  {section.heading}
                </h2>
                <div class="lf-texto mt-5 space-y-4">
                  {section.paragraphs.map((p, k) => (
                    <>
                      <p set:html={p} />
                      {/* Gráfico pizarra intercalado: va justo debajo del
                          párrafo que explica, no al final de la sección. */}
                      {section.pizarra?.tras === k && (
                        <PizarraPorNombre grafico={section.pizarra.grafico} lang={lang} />
                      )}
                    </>
                  ))}
                </div>
              </div>

              {/* Tabla de datos. Texto plano en celdas; la primera columna es
                  la descripción y va alineada a la izquierda como el resto. */}
              {section.table && (
                <div class="mt-8 overflow-x-auto">
                  <table class="w-full border-b-2 border-border text-left text-[15px] leading-[1.5]">
                    <thead>
                      <tr class="border-t-2 border-fg">
                        {section.table.headers.map((h) => (
                          <th scope="col" class="px-4 py-3 text-[13px] font-normal text-muted first:pl-0">
                            {h}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr class="border-t-2 border-border">
                          {row.map((cell, c) => (
                            <td class:list={['px-4 py-3.5 first:pl-0', c === 0 ? 'text-muted' : 'font-medium text-fg']}>
                              {cell}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {/* Retícula con líneas interiores: elementos paralelos. Dos
                  columnas y no cuatro porque aquí cada elemento es una frase
                  larga, no un título. Con un número impar el último ocupa
                  las dos columnas: nunca queda una celda vacía al final. */}
              {section.bullets && section.kind === 'lattice' && (
                <ul class="ruled-grid mt-8 sm:grid-cols-2">
                  {section.bullets.map((b, k) => (
                    <li
                      class:list={[
                        'lf-celda flex gap-4 py-6 sm:px-6',
                        section.bullets!.length % 2 === 1 && k === section.bullets!.length - 1 && 'sm:col-span-2',
                      ]}
                    >
                      <span class="sq mt-[7px] shrink-0" aria-hidden="true" />
                      <span class="text-[15px] leading-[1.6] text-fg" set:html={b} />
                    </li>
                  ))}
                </ul>
              )}

              {/* Lista numerada: secuencias y listas que se recorren una a
                  una. Filas con su número y reglas de 2 px, como la lista de
                  seguridad de la portada. Los números visibles van ocultos al
                  lector de pantalla, que ya cuenta los elementos del <ol>. */}
              {section.bullets && section.kind === 'checklist' && (
                <ol class="mt-8 max-w-[44rem] border-b-2 border-border">
                  {section.bullets.map((b, k) => (
                    <li class="grid grid-cols-[32px_minmax(0,1fr)] gap-3 border-t-2 border-border py-4">
                      <span class="num pt-[3px]" aria-hidden="true">{dos(k + 1)}</span>
                      <span class="text-[15px] leading-[1.6] text-fg sm:text-base" set:html={b} />
                    </li>
                  ))}
                </ol>
              )}

              {section.bullets && (section.kind ?? 'prose') === 'prose' && (
                <ul class="mt-6 max-w-[44rem] space-y-3">
                  {section.bullets.map((b) => (
                    <li class="flex items-start gap-3.5 text-[15px] leading-[1.6] text-fg sm:text-base">
                      <span class="mt-[10px] block h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true" />
                      <span set:html={b} />
                    </li>
                  ))}
                </ul>
              )}

              {section.link && (
                <p class="mt-7 max-w-[44rem]">
                  <a href={section.link.href} class="lf-enlace">
                    {section.link.label} →
                  </a>
                </p>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </section>

  {/* Las entradas que desarrollan lo que cuenta la página. La ruta sale de la
      URL, así que la página no tiene que declararse a sí misma, y el conjunto
      se deriva de los enlaces que los propios posts ya traen. Va detrás del
      cuerpo y delante de la FAQ, que junto al CTA forma el cierre. */}
  <ClusterPosts lang={lang} pillar={pillarFromUrl(Astro.url.pathname)} />

  <!-- FAQ (skipped on pages without one, e.g. About) -->
  {
    hasFaq && (
      <section class="wrap section-y">
        <div class="grid items-start gap-x-[clamp(32px,5vw,96px)] gap-y-8 lg:grid-cols-3">
          <h2 class="text-[clamp(28px,3vw,40px)] leading-[1.08] tracking-[-0.028em] lg:sticky lg:top-[104px]">
            {page.faqHeading}
          </h2>
          {/* Misma pieza que la FAQ de la home. */}
          <FaqList items={page.faq!} group="faq-page" class="lg:col-span-2" />
        </div>
      </section>
    )
  }

  <!-- Final CTA: el bloque de contacto de la portada, sin formulario. -->
  <section class="wrap section-y">
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-x-[clamp(32px,6vw,120px)] gap-y-8 border-t-2 border-fg pt-12"
    >
      <h2 class="t-h2">{page.cta.heading}</h2>
      <div>
        <p class="max-w-[44ch] text-[17px] leading-[1.6] text-muted">{page.cta.body}</p>
        <div class="mt-8">
          <a href={localizedPath('/#contacto', lang)} class="btn-primary hover:btn-primary-hover">
            {page.cta.button}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Entrada escalonada del héroe, la misma de la portada. */
  .lf-in {
    animation: if-up 0.8s var(--d, 0s) var(--ease-out) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .lf-in {
      animation: none;
    }
  }

  /* El texto corrido llega como HTML desde ui.ts, así que sus etiquetas no
     llevan el atributo de ámbito de Astro y hay que alcanzarlas con :global. */
  .lf-texto :global(p) {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .lf-seccion :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }

  /* En una columna las celdas no necesitan margen lateral: van a sangre con
     el texto. En dos, la primera de cada fila tampoco. */
  @media (min-width: 640px) {
    .lf-celda:nth-child(odd) {
      padding-left: 0;
    }
  }

  /* El enlace de cierre de sección suele ser una frase entera que ocupa dos
     líneas. Va en línea, y no en bloque como `link-arrow`, para que la regla
     de debajo acompañe a cada renglón en vez de subrayar solo el último. */
  .lf-enlace {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-accent);
    border-bottom: 2px solid var(--color-accent-200);
    padding-bottom: 2px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: border-color 250ms;
  }
  .lf-enlace:hover {
    border-color: var(--color-accent);
  }
</style>
