---
import { type Lang, content } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].methodology;
const last = t.steps.length - 1;
---

{/* Runs during parse, before the section paints, so the steps are never
    hidden unless the reveal can actually run. No JS, no IntersectionObserver
    or a script error means the route renders fully visible. */}
<script is:inline>
  if ('IntersectionObserver' in window) {
    document.documentElement.classList.add('route-anim');
  }
</script>

<section class="bg-bg-soft py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <header class="mx-auto max-w-2xl text-center">
      {/* No eyebrow here: "Nuestro método" was a synonym of the heading below. */}
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        {t.title}
      </h2>
      <p class="mt-4 text-lg text-muted">{t.subtitle}</p>
    </header>

    {/* The route. Each step is a two-column grid: a rail holding the tally and
        the segment that links it to the next one, and the content. The rail
        column stretches to the full height of the row, so the segment spans
        exactly the gap down to the following marker.

        The rail counts with bars instead of "01/02/03". Each step shows one
        bar more than the one above it and the new bar is the topmost, so the
        tally grows upward as the reader descends and ends as four black bars.
        The stack is bottom-anchored (`justify-end`) inside a box sized to the
        full four, which keeps the bottom bar on the same line as the heading
        no matter how many bars that step draws.

        `role="list"` is here because Tailwind's preflight removes the list
        marker, and with it VoiceOver drops the list semantics. Those semantics
        are what now carry the step order, since the visible number is gone. */}
    <ol role="list" class="mx-auto mt-16 max-w-4xl sm:mt-20">
      {
        t.steps.map((step, i) => (
          <li
            data-route-step
            class="grid grid-cols-[2.75rem_1fr] gap-x-5 sm:grid-cols-[3.5rem_1fr] sm:gap-x-9"
            style={`transition-delay: ${i === 0 ? 0 : 60}ms`}
          >
            <div class="flex flex-col items-center">
              {/* Two measurements make the tally sit right, and both are tied
                  to the heading rather than guessed:

                  - Height is `1em` at the heading's own size (hence the
                    text-2xl/text-3xl on a box that holds no text). The font's
                    ascent is one em, so the bottom edge of this box lands on
                    the heading's baseline. Anchoring the stack to the bottom
                    of the full line box instead left the bars floating below
                    the text, because a line box also reserves descender room.
                  - Bars are 2px with a 2-3px gap, so all four stack to 14px on
                    mobile and 17px from `sm` up, against a cap height of about
                    0.7em (17px and 21px). Four bars therefore never grow past
                    the capital letters they sit beside.

                  Bar width is then set to that same 14/17px, so the finished
                  four-bar tally is square rather than a wide strip. The width
                  is tied to the stack height on purpose: change the bar
                  thickness or the gap and this number has to follow, or the
                  block stops being square. */}
              <div
                class="flex h-[1em] w-[14px] shrink-0 flex-col justify-end gap-0.5 text-2xl sm:w-[17px] sm:gap-[3px] sm:text-3xl"
                aria-hidden="true"
              >
                {Array.from({ length: i + 1 }, (_, j) => (
                  <span
                    class:list={[
                      'h-0.5 w-full rounded-full bg-fg',
                      /* Only the bar this step adds draws itself in. The ones
                         below it were already there on the step above. */
                      j === 0 && 'route-bar-new',
                    ]}
                  />
                ))}
              </div>
              {i < last && (
                <span class="route-line mt-4 w-0.5 flex-1 rounded-full bg-border" aria-hidden="true" />
              )}
            </div>

            <div class={i < last ? 'pb-14 sm:pb-20' : ''}>
              <h3 class="text-2xl font-bold leading-tight tracking-tight text-fg sm:text-3xl">
                {step.title}
              </h3>
              <p
                class="mt-3 max-w-2xl text-base leading-relaxed text-muted sm:text-lg"
                set:html={step.body}
              />

              <p class="mt-7 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-faint">
                {t.outputsLabel}
              </p>
              <ul class="mt-3 space-y-2.5">
                {step.outputs.map((out) => (
                  <li class="flex items-start gap-3 text-[15px] leading-snug text-fg">
                    <span
                      class="mt-[0.5em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
                      aria-hidden="true"
                    />
                    <span>{out}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    {/* The route ends by handing the reader step 1 for real. */}
    <div class="mx-auto mt-14 max-w-4xl sm:mt-16 sm:pl-[4.4rem]">
      <a
        href={t.cta.href}
        class="btn-primary hover:btn-primary-hover inline-flex w-full justify-center sm:w-auto"
      >
        {t.cta.label}
        <Icon name="flecha-derecha" size={16} />
      </a>
    </div>
  </div>
</section>

<script>
  // Reveal each step once it enters the viewport, then stop watching it: the
  // route is a one-way read, so nothing needs to hide again on the way back up.
  const steps = document.querySelectorAll<HTMLElement>('[data-route-step]');

  if (!('IntersectionObserver' in window)) {
    steps.forEach((step) => step.classList.add('is-in'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        });
      },
      // Fires a little before the step is fully in view, so the segment is
      // already drawing by the time the marker reaches comfortable reading height.
      { rootMargin: '0px 0px -12% 0px', threshold: 0.2 }
    );

    steps.forEach((step) => observer.observe(step));
  }
</script>
