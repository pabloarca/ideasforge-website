---
/*
  Lista de preguntas frecuentes, compartida por la FAQ de la home y por las
  páginas largas (guías, servicios, guía de coste). Antes cada sitio tenía la
  suya: la home un acordeón y las páginas largas tarjetas estáticas con sombra,
  así que la misma pieza se veía y se comportaba distinto según la página.

  El aspecto es el del acordeón del diseño de octubre de 2026: reglas de 2 px
  entre preguntas, la pregunta a 500 y un signo más a la derecha hecho con dos
  barras. Al abrirse, la barra vertical se encoge hasta desaparecer y el más
  queda en menos.

  Acordeón nativo con <details name="...">: el atributo `name` agrupa los
  desplegables y el navegador cierra solo el que estuviera abierto. Sin
  JavaScript. `group` da nombre único por instancia para que dos FAQ en la
  misma página no compartan grupo.

  Cada pregunta es un <h3> dentro del <summary>, porque los dos sitios que
  usan la lista la cuelgan de un <h2>. Si algún día cuelga de otro nivel, la
  pregunta va uno por debajo del título que la contiene.
*/
import { type Faq } from '../i18n/ui';
import { medidas } from '../lib/imagen';

interface Props {
  items: Faq[];
  /** Nombre del grupo de <details>. Único por instancia en la página. */
  group?: string;
  /** Deja la primera pregunta abierta al cargar, como pide la portada. */
  openFirst?: boolean;
  class?: string;
}
const { items: todas, group = 'faq', openFirst = false, class: className = '' } = Astro.props;

/* Una pregunta oculta no se pinta y TAMPOCO entra en el schema: publicarla
   solo para las máquinas sería peor que publicarla entera. */
const items = todas.filter((i) => !i.oculta);

/*
  Ancla por pregunta, deducida del propio texto.

  Para qué: que se pueda enlazar una respuesta concreta, que es lo que hace
  falta al mandarla por correo y lo que necesita un motor de respuesta para
  citarla sin arrastrar la página entera. El identificador entra también en el
  JSON-LD como `url`, así que cada par pregunta-respuesta tiene dirección.

  Se deduce del texto y no se escribe a mano por lo de siempre: un campo más
  que rellenar es un campo que alguien olvida. Contrapartida asumida: si se
  reescribe una pregunta cambia su ancla y un enlace viejo deja de apuntar a
  ella. Cae dentro de la propia página, que es un fallo blando.
*/
const ancla = (q: string) =>
  'p-' +
  q
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 60);
const rutaBase = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/';

/** Una respuesta puede venir como cadena o como lista de párrafos. */
const parrafos = (a: Faq['a']) => (Array.isArray(a) ? a : [a]);

/*
  FAQPage estructurado. Va aquí y no en el layout porque aquí están los datos:
  cualquier FAQ del sitio lo hereda sin que su página tenga que acordarse.

  Expectativa honesta de lo que da: Google retiró el resultado enriquecido de
  FAQ en 2023 salvo para fuentes oficiales, así que esto NO va a pintar
  desplegables en el buscador. Sirve para que un motor de respuesta encuentre
  la pregunta y la respuesta emparejadas en vez de tener que deducirlo del
  acordeón.

  El escape de `<` evita que una respuesta que algún día contenga una etiqueta
  cierre el bloque de script antes de tiempo. (La etiqueta no se escribe aquí
  con sus ángulos: el escáner de dependencias de Vite la toma por un script
  de verdad e intenta compilar el resto del comentario.)
*/
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    url: `${rutaBase}#${ancla(item.q)}`,
    acceptedAnswer: { '@type': 'Answer', text: parrafos(item.a).join(' ') },
  })),
}).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={faqJsonLd}></script>

<div class:list={['border-t-2 border-border', className]}>
  {
    items.map((item, i) => (
      <details
        id={ancla(item.q)}
        name={group}
        open={openFirst && i === 0}
        class="faq-item border-b-2 border-border"
      >
        <summary class="faq-q">
          <h3 class="faq-q-texto">{item.q}</h3>
          <span class="faq-mas" aria-hidden="true">
            <i />
            <i />
          </span>
        </summary>

        <div class="faq-a">
          {item.image && (
            <img
              src={item.image}
              alt=""
              {...medidas(item.image)}
              loading="lazy"
              decoding="async"
              class="bn mb-5 aspect-[21/9] w-full object-cover"
            />
          )}
          {parrafos(item.a).map((p) => (
            <p>{p}</p>
          ))}
          {item.link && (
            <a href={item.link.href} class="link-arrow mt-4">
              {item.link.label} →
            </a>
          )}
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-item {
    scroll-margin-top: var(--sticky-offset);
    /* Permite animar hacia `auto`: es lo que deja que la respuesta se
       despliegue a su altura real sin medirla con JavaScript. */
    interpolate-size: allow-keywords;
  }
  .faq-q {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24px;
    gap: 24px;
    align-items: start;
    padding: 22px 0;
    list-style: none;
    cursor: pointer;
    transition: color 0.25s;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q:hover {
    color: var(--color-accent);
  }
  .faq-q-texto {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.35;
    letter-spacing: -0.012em;
    font-weight: 500;
  }

  /* El más: dos barras de 2 px. La vertical se encoge al abrir. */
  .faq-mas {
    position: relative;
    display: block;
    width: 24px;
    height: 24px;
  }
  .faq-mas i {
    position: absolute;
    background: currentColor;
  }
  .faq-mas i:first-child {
    left: 4px;
    right: 4px;
    top: 11px;
    height: 2px;
  }
  .faq-mas i:last-child {
    top: 4px;
    bottom: 4px;
    left: 11px;
    width: 2px;
    transition: transform 0.35s var(--ease-in-out);
  }
  .faq-item[open] .faq-mas i:last-child {
    transform: scaleY(0);
  }

  .faq-a {
    max-width: 70ch;
    padding: 0 48px 26px 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .faq-a p + p {
    margin-top: 1em;
  }

  /*
    Apertura animada, sin JavaScript. `::details-content` es la caja que el
    navegador oculta al cerrar: se anima su altura de cero a `auto`. Los
    navegadores que aún no la conocen ignoran el bloque entero y abren de
    golpe, que es lo que hacía este acordeón antes.
  */
  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease-in-out),
      content-visibility 0.45s allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }
  @media (max-width: 639px) {
    .faq-a {
      padding-right: 0;
    }
  }
</style>

<script is:inline>
  /*
    Al llegar con `#p-...` en la dirección, abrir esa pregunta.

    Hace falta porque el ancla sola no basta: el navegador salta al `<details>`
    y lo deja cerrado, así que quien sigue el enlace aterriza mirando el
    título de una respuesta que no ve. Chrome lo abre solo desde hace poco;
    los demás no.

    Sin este script el enlace sigue llevando al sitio correcto: se pierde la
    apertura, no el destino.
  */
  (function () {
    function abre() {
      var id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      var el = document.getElementById(id);
      if (el && el.tagName === "DETAILS") {
        el.open = true;
        el.scrollIntoView({ block: "start" });
      }
    }
    abre();
    window.addEventListener("hashchange", abre);
  })();
</script>
