---
/*
  Portada de una entrada del blog. Si el post trae `heroImage`, se usa esa,
  en blanco y negro como toda la fotografía del sitio.

  Si no la trae, se pinta el hueco gris plano del diseño de octubre de 2026,
  con el título encima salvo que se pida `compact`. Antes se generaba una
  portada de degradado oscuro con cuadrícula, una por familia de color: el
  sistema nuevo no admite degradados, y un hueco neutro dice lo mismo («aquí
  no hay foto») sin inventarse una imagen.

  Quien la coloca decide la caja: este componente la llena entera, así que el
  contenedor tiene que ser `relative` y tener altura o proporción.

  `pictureAttributes` con `contents`: <Picture> mete un elemento <picture>
  entre el contenedor y la imagen, y sin eso la imagen se anclaría a una caja
  en línea sin tamaño.
*/
import { Picture } from 'astro:assets';
import { foto } from '../lib/fotos';

interface Props {
  title: string;
  image?: string;
  /** Oculta el título sobre el hueco gris, para miniaturas pequeñas. */
  compact?: boolean;
  /**
   * El hueco real que ocupa la portada, en formato `sizes`. Lo pone quien la
   * coloca porque solo él lo sabe: con un valor único, algún sitio se bajaría
   * una variante que no necesita.
   */
  sizes?: string;
  class?: string;
}
const { title, image, compact = false, sizes = '100vw', class: className = '' } = Astro.props;
---

{
  image ? (
    <Picture
      pictureAttributes={{ class: 'contents' }}
      src={foto(image)}
      alt=""
      formats={['avif', 'webp']}
      widths={[320, 640, 960, 1280]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class:list={['bn absolute inset-0 h-full w-full object-cover', className]}
    />
  ) : (
    <div class:list={['absolute inset-0 bg-neutral-200', className]}>
      {!compact && (
        <p class="absolute inset-x-0 bottom-0 line-clamp-4 p-6 text-lg font-medium leading-snug text-fg">
          {title}
        </p>
      )}
    </div>
  )
}
