---
/*
  Portada de una entrada del blog. Si el post trae `heroImage`, se usa esa. Si
  no, se genera una con el lenguaje del kit de gráficos: degradado oscuro,
  cuadrícula tenue y el título encima.

  La familia rota entre las doce del diamante. QUIÉN recibe cuál se decide por
  POSICIÓN en la lista, no por sorteo: `coverFamilies` está ordenada de forma
  que las vecinas son las que más se parecen, así que repartir por posición
  garantiza que dos entradas consecutivas nunca compartan tono. Un hash no
  puede prometer eso; medido sobre las diez entradas sin fotografía dejaba seis
  familias de doce sin usar y colocaba dos iguales seguidas.

  Contrapartida asumida (22 ago 2026): al publicar una entrada nueva, las de
  debajo corren un puesto y cambian de portada. Lo que el sorteo protegía de
  verdad era que dos COMPILACIONES seguidas no difirieran, y eso se mantiene:
  misma lista, mismo resultado.

  El dibujo de la cuadrícula sí sigue saliendo del título, así que cada entrada
  conserva su textura propia aunque le cambie el color.
*/
import GridBackdrop from './graficos/GridBackdrop.astro';
import { coverFamilies, seedFrom } from './graficos/gradients';
import { medidas } from '../lib/imagen';

interface Props {
  title: string;
  image?: string;
  /** Posición en la lista que se está pintando. Sin ella se cae al sorteo por
   *  título, que sirve para portadas sueltas fuera de una lista. */
  index?: number;
  /** Oculta el título sobre la portada generada, para miniaturas pequeñas. */
  compact?: boolean;
  class?: string;
}
const { title, image, index, compact = false, class: className = '' } = Astro.props;

const seed = seedFrom(title);
const family = coverFamilies[(index ?? seed) % coverFamilies.length];
---

{
  image ? (
    <img
      src={image}
      alt=""
      {...medidas(image)}
      loading="lazy"
      decoding="async"
      class:list={['h-full w-full object-cover', className]}
    />
  ) : (
    <div
      class:list={['relative h-full w-full overflow-hidden', className]}
      style={`background:${family}`}
    >
      <GridBackdrop seed={seed % 9973} cell={44} fillChance={0.22} dotChance={0.26} />
      {/*
        `data-cover-title` es el asidero para que quien coloque la portada
        decida si el título se ve. En el acordeón del blog solo se muestra en la
        hoja abierta: sobre un canto de veinticinco píxeles no se leería nada.
      */}
      {!compact && (
        <p
          data-cover-title
          class="absolute inset-x-0 bottom-0 line-clamp-4 p-6 text-lg font-bold leading-snug text-white"
        >
          {title}
        </p>
      )}
    </div>
  )
}
