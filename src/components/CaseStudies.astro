---
import { type Lang, content } from '../i18n/ui';
import { medidas } from '../lib/imagen';
import Icon from './Icon.astro';
import CarouselBehaviour from './CarouselBehaviour.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].caseStudies;
---

<section id="proyectos" data-carousel class="relative scroll-mt-24 bg-bg py-16 sm:py-24">
  {/* Banda de cuadricula. Los dos filetes horizontales van a sangre, de borde
      a borde de la seccion, y por eso este envoltorio queda FUERA del
      contenedor centrado: dentro de el se cortarian a los 1280 px. El filete
      vertical que separa texto de imagen lo pone cada ficha, y como la ficha
      llena la banda de arriba abajo, los tres se encuentran y cierran la
      cuadricula. La pista pierde su `py-4`, que existia para dejar sitio a la
      sombra: sin sombra, ese aire separaba la ficha de sus propios filetes. */}
  <div class="border-y border-border-soft">
    <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
      {/* Los mandos ya no flotan sobre los costados de la ficha: viven todos en
          la barra de abajo (ver el final del componente). */}

      <!-- Carousel viewport -->
      <div class="overflow-x-clip lg:px-12">
        <div
          data-carousel-track
          class="flex snap-x snap-mandatory gap-8 overflow-x-auto scroll-p-4 px-4 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        >
        {
          /* Sin `card-soft`: la ficha va plana, sin sombra ni esquinas
             redondeadas. `overflow-hidden` se queda porque la imagen del lado
             derecho se posiciona en absoluto y hay que recortarla. */
          t.items.map((item) => (
            <article
              data-carousel-slide
              class="relative grid min-h-[420px] w-full shrink-0 snap-center overflow-hidden bg-surface sm:min-h-0 lg:grid-cols-2 lg:min-h-[480px]"
            >
              {/* Velo solo en movil, donde el texto se apoya en la foto. Va de
                  negro casi opaco abajo a casi nada arriba: la mitad superior
                  de la imagen se ve limpia y el pie sostiene el rotulo pase lo
                  que pase con la luminosidad de cada fotografia. */}
              <div
                class="absolute inset-0 z-[1] bg-gradient-to-t from-black/85 via-black/50 to-black/5 sm:hidden"
                aria-hidden="true"
              />

              <div class="relative z-[2] flex flex-col justify-end p-6 sm:justify-start sm:p-12">
                {/* En movil el cliente va en texto claro: los logos son oscuros
                    y sobre el velo desapareceria justo el que da credibilidad. */}
                <span class="text-xs font-semibold uppercase tracking-[0.18em] text-white/70 sm:hidden">
                  {item.client}
                </span>

                {item.clientLogo ? (
                  <img
                    src={item.clientLogo}
                    alt={item.client}
                    {...medidas(item.clientLogo)}
                    class="hidden h-14 w-auto self-start object-contain sm:block"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="hidden self-start text-xs font-semibold uppercase tracking-[0.18em] text-faint sm:block">
                    {item.client}
                  </span>
                )}
                <h3 class="mt-3 text-balance text-2xl font-bold leading-tight text-white sm:mt-8 sm:text-[2rem] sm:text-fg">
                  {item.title}
                </h3>
                {/* El cuerpo no cabe en un movil sin que la ficha desborde la
                    pantalla, pero sigue en el HTML: se oculta con CSS, no se
                    deja de renderizar. */}
                <p class="mt-5 hidden text-[15px] leading-relaxed text-muted sm:block">{item.body}</p>
                <div class="mt-4 sm:mt-auto sm:pt-10">
                  <hr class="hidden border-t border-border-soft sm:block" />
                  <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 sm:mt-5">
                    <span class="text-xl font-bold text-white sm:text-[1.75rem] sm:text-fg">{item.metricBig}</span>
                    <span class="hidden text-[15px] leading-snug text-muted sm:block">{item.metricSmall}</span>
                  </div>
                  {/* El enlace es explicito y no la ficha entera: la pista se
                      arrastra con el dedo y un enlace de tarjeta completa se
                      dispararia al soltar. Solo aparece donde hay pagina.

                      A diferencia del cuerpo y de metricSmall, este SI se ve
                      en movil: es la unica via a la pagina de caso desde el
                      carrusel, y ocultarlo dejaba el destino inalcanzable en
                      el dispositivo desde el que mas se navega. Toma el mismo
                      tratamiento de color que metricBig, blanco sobre la
                      imagen en movil y acento sobre fondo claro. */}
                  {item.href && (
                    <a
                      href={item.href}
                      class="group mt-3 inline-flex items-center gap-1.5 text-[15px] text-white sm:mt-5 sm:text-accent"
                    >
                      <span class="underline-offset-2 group-hover:underline">{item.hrefLabel}</span>
                      <Icon
                        name="flecha-derecha"
                        size={16}
                        class="shrink-0 transition-transform duration-300 group-hover:translate-x-0.5"
                      />
                    </a>
                  )}
                </div>
              </div>

              {/* En movil la imagen no es una mitad: llena la ficha entera y
                  el texto se apoya encima, asi que ahi no hay filete que
                  dividir. A partir de 640 px vuelven las dos mitades apiladas
                  con su filete horizontal, y desde 1024 px van una al lado de
                  otra y el filete se pone vertical. */}
              <div class="absolute inset-0 overflow-hidden sm:relative sm:min-h-[280px] sm:border-t sm:border-border-soft lg:min-h-full lg:border-l lg:border-t-0">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    {...medidas(item.image)}
                    class="absolute inset-0 h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div
                    class="absolute inset-0 h-full w-full"
                    style="background: linear-gradient(135deg, #e9e7ff 0%, #c9c7ff 60%, #b3b0ff 100%);"
                    aria-hidden="true"
                  />
                )}
              </div>
            </article>
          ))
        }
        </div>
      </div>
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    {/* Barra de mandos. Los dos grupos comparten linea y se alinean con los
        bordes de la ficha: el acolchado repite el de la pista (16 px) mas el
        de la ventana en pantallas grandes (48 px), que es donde empiezan las
        fichas. Los puntos van a la izquierda sobre un fondo suave que los
        agrupa y les da area de pulsacion, y las flechas juntas a la derecha. */}
    <div class="mt-8 flex items-center justify-between gap-6 px-4 lg:px-16">
      <div
        data-carousel-dots
        class="inline-flex items-center rounded-md bg-bg-soft px-2 py-1"
      >
        {
          t.items.map((_, i) => (
            /* El punto se ve de 10 px y mide 24, que es el mínimo que pide la
               norma para algo que se pulsa con el dedo.

               El primer intento fue agrandar el área con un pseudoelemento, y
               NO valió: mejoraba el uso real, pero la auditoría mide la caja
               del botón y seguía viendo 10 px. Ahora la caja mide 24 de verdad,
               con 7 px de borde transparente por lado, y `bg-clip-content`
               hace que el color solo pinte el interior. El margen negativo
               devuelve la separación visual que tenían antes, para que la fila
               de puntos se vea exactamente igual.

               El color se queda en el botón y no en un hijo porque
               `CarouselBehaviour` alterna `bg-fg` y `bg-border` sobre este
               mismo elemento.

               El comentario va aquí y no entre los atributos, donde el parser
               lo leería como una expresión y rompería el build. */
            <button
              type="button"
              data-carousel-dot
              data-index={i}
              aria-label={`${lang === 'es' ? 'Proyecto' : 'Project'} ${i + 1}`}
              class="h-6 w-6 rounded-full border-[7px] border-transparent bg-border bg-clip-content transition-colors"
            />
          ))
        }
      </div>

      {/* Mismo tratamiento que el icono de las tarjetas de compromisos y que la
          flecha del blog: cuadrado con fondo suave, galon fino, y al pasar por
          encima la caja crece y el galon se desplaza en su sentido. */}
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-carousel-prev
          aria-label={lang === 'es' ? 'Anterior' : 'Previous'}
          class="group grid h-11 w-11 place-items-center rounded-md bg-bg-soft transition-transform duration-300 hover:scale-110"
        >
          <Icon name="flecha-izquierda" size={20} class="text-fg transition-transform duration-300 group-hover:-translate-x-0.5" />
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label={lang === 'es' ? 'Siguiente' : 'Next'}
          class="group grid h-11 w-11 place-items-center rounded-md bg-bg-soft transition-transform duration-300 hover:scale-110"
        >
          <Icon name="flecha-derecha" size={20} class="text-fg transition-transform duration-300 group-hover:translate-x-0.5" />
        </button>
      </div>
    </div>
  </div>
</section>

<CarouselBehaviour />
