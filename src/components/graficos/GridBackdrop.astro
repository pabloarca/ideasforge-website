---
/**
 * Cuadrícula de fondo para el interior de un GrainFrame.
 *
 * Se genera en el build, así que no hay imágenes ni JavaScript. Cada celda
 * recibe una intensidad distinta y cada vértice puede llevar punto o no, pero
 * el azar va con semilla: el mismo `seed` da siempre el mismo dibujo, de forma
 * que dos compilaciones seguidas no producen diferencias.
 *
 * Coste: solo se emiten las celdas y los puntos que se ven. Las líneas van en
 * un <pattern>, que es un único elemento por muchas que se dibujen.
 */
import { prng } from '../../lib/prng';

export interface Props {
  /** Lado de la celda, en unidades del lienzo */
  cell?: number;
  /** Tamaño del lienzo. Se recorta para cubrir el contenedor sin deformarse */
  width?: number;
  height?: number;
  /** Cambiar la semilla cambia el dibujo, y siempre del mismo modo */
  seed?: number;
  /** Probabilidad de que una celda lleve relleno */
  fillChance?: number;
  /** Rango de intensidad del relleno */
  fillMin?: number;
  fillMax?: number;
  /** Probabilidad de que un vértice lleve punto */
  dotChance?: number;
  dotOpacity?: number;
  lineOpacity?: number;
}

const {
  cell = 50,
  width = 1600,
  height = 760,
  seed = 7,
  fillChance = 0.26,
  fillMin = 0.012,
  fillMax = 0.055,
  dotChance = 0.3,
  dotOpacity = 0.32,
  lineOpacity = 0.07,
} = Astro.props;

const rand = prng(seed);
const cols = Math.ceil(width / cell);
const rows = Math.ceil(height / cell);

const fills: Array<{ x: number; y: number; o: string }> = [];
for (let r = 0; r < rows; r += 1) {
  for (let c = 0; c < cols; c += 1) {
    if (rand() < fillChance) {
      fills.push({
        x: c * cell,
        y: r * cell,
        o: (fillMin + rand() * (fillMax - fillMin)).toFixed(3),
      });
    }
  }
}

const dots: Array<{ x: number; y: number }> = [];
for (let r = 0; r <= rows; r += 1) {
  for (let c = 0; c <= cols; c += 1) {
    if (rand() < dotChance) dots.push({ x: c * cell, y: r * cell });
  }
}

// El id del patrón depende de las props, así que dos cuadrículas distintas en
// la misma página no se pisan y dos iguales comparten definición sin daño.
const patternId = `gb-${cell}-${seed}`;
---

<svg
  class="gb"
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <defs>
    <pattern id={patternId} width={cell} height={cell} patternUnits="userSpaceOnUse">
      <path
        d={`M ${cell} 0 L 0 0 0 ${cell}`}
        fill="none"
        stroke="#fff"
        stroke-width="1"
        opacity={lineOpacity}
      />
    </pattern>
  </defs>

  <rect width={width} height={height} fill={`url(#${patternId})`} />

  {/*
    El color y la opacidad comunes viven en el <g> y no en cada elemento: con
    varios cientos de nodos, repetirlos engorda el HTML sin aportar nada.
  */}
  <g fill="#fff">
    {fills.map((f) => (
      <rect x={f.x} y={f.y} width={cell} height={cell} opacity={f.o} />
    ))}
  </g>

  <g fill="#fff" opacity={dotOpacity}>
    {dots.map((d) => <circle cx={d.x} cy={d.y} r="1.75" />)}
  </g>
</svg>

{/*
  Estilo global a propósito: si fuera con ámbito, Astro añadiría el atributo
  `data-astro-cid` a cada uno de los cientos de nodos del SVG. La regla afecta
  a una sola clase, así que no hay nada que aislar.
*/}
<style is:global>
  svg.gb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
