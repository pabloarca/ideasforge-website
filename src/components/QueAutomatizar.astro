---
/*
  La herramienta «¿Qué tareas automatizar primero?» (t0190). Una pregunta por
  pantalla, con barra de progreso, y casi todas se contestan con un toque
  (decisión del propietario, 21 oct 2026: la versión con todo el formulario a
  la vista «chocaba»).

  Todo ocurre en el navegador. Las tareas analizadas (nombre y respuestas) se
  guardan en el `localStorage` de quien las contesta, para que sigan ahí al
  probar otra o al recargar (propietario, 21 oct 2026); nunca salen de allí. Sale un evento anónimo por `forge.track` (veredicto, cuántas
  tareas, si se pide la revisión), que pasa por la reja de consentimiento y
  de campos de `Analitica.astro`. El nombre de la tarea y las respuestas solo
  viajan si la persona pide la revisión al final: entonces el resumen va a
  Web3Forms con su nombre y su correo, como el resto de formularios de la web.

  El texto vive en `src/i18n/que-automatizar.ts` (español) y en
  `que-automatizar-en.ts` (inglés, 21 oct 2026), y llega al script como JSON.

  Debajo de la herramienta van los ejemplos por departamento y tres preguntas
  frecuentes (21 oct 2026): son lo que posiciona la página sin meter texto
  delante de la herramienta. El resultado de cada ejemplo lo calcula `analiza`
  al compilar, y «Probar con esta tarea» (o `?ejemplo=<id>` en la dirección)
  carga sus respuestas en la herramienta.

  La lógica (qué solución, cuánto se deja de perder, en qué estado del
  semáforo cae) vive en `src/lib/que-automatizar.ts`, sin textos ni
  navegador, y la prueban `npm run check:herramienta` y el CI.
*/
import FaqList from './FaqList.astro';
import { qa as qaEs } from '../i18n/que-automatizar';
import { qaEn } from '../i18n/que-automatizar-en';
import { type Lang } from '../i18n/ui';
import { routeMap } from '../i18n/utils';
import { CLAVE_WEB3FORMS } from '../lib/formulario';
import { analiza } from '../lib/que-automatizar';
import { EJEMPLOS, DEPARTAMENTOS } from '../lib/que-automatizar-ejemplos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const qa = lang === 'en' ? qaEn : qaEs;
const c = qa.cta;
const empezar = routeMap.start[lang];
const ej = qa.ejemplos;
/* Cada ejemplo con lo que la herramienta dice de él, calculado aquí y no
   escrito a mano: si cambian las reglas, cambia también el ejemplo. */
const grupos = DEPARTAMENTOS.map((dep) => ({
  dep,
  items: EJEMPLOS.filter((e) => e.dep === dep).map((e) => {
    const r = analiza(e.a, qa.pasos);
    return { id: e.id, ...ej.items[e.id as keyof typeof ej.items], estado: qa.t.estados[r.estado], solucion: qa.verdicts[r.v].t, color: r.estado };
  }),
}));
const ejemplos = Object.fromEntries(EJEMPLOS.map((e) => [e.id, { ...e.a, name: ej.items[e.id as keyof typeof ej.items].n }]));
/* La herramienta declarada como tal: gratis, en el navegador y sin registro.
   El precio va a cero en euros porque el esquema exige moneda; no se pinta. */
const site = Astro.site ?? new URL('https://ideasforge.io');
const appJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: qa.app.name,
  description: qa.app.description,
  url: new URL(Astro.url.pathname.replace(/\.html$/, ''), site).href,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  inLanguage: lang,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  publisher: { '@type': 'Organization', name: 'Ideasforge', url: site.href },
}).replace(/</g, '\\u003c');
const datos = JSON.stringify({ locale: qa.locale, pasos: qa.pasos, ui: qa.ui, t: qa.t, v: qa.verdicts, cta: c, ejemplos });
---

<script is:inline type="application/ld+json" set:html={appJsonLd} />

{/* La herramienta, arriba y a la derecha del titular, donde antes iba una
    foto (propietario, 22 oct 2026: «que resalte más»). Así se ve nada más
    entrar. En el móvil va debajo del texto, con el botón «Empezar» para bajar. */}
<section class="wrap pb-[clamp(48px,6vw,80px)] pt-[clamp(40px,5vw,72px)]">
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-14">
    <div class="lg:sticky lg:top-28">
      <span class="kicker mb-7">{qa.hero.kicker}</span>
      <h1 class="t-display max-w-[16ch]">{qa.hero.title}</h1>
      <div class="mt-6 max-w-[48ch] space-y-4 text-[17px] leading-[1.55] text-muted">
        {qa.hero.lead.map((p) => <p>{p}</p>)}
      </div>
      <a href="#herramienta" class="btn-primary hover:btn-primary-hover mt-9 lg:hidden">{qa.hero.cta}</a>
    </div>
    <div id="herramienta" class="qa-shell scroll-mt-28">
      <div id="qa-hechas" class="qa-hechas" hidden></div>
      <div id="qa-wiz" class="qa-card">
        <p id="qa-cargado" class="qa-cargado" hidden></p>
        <div class="qa-prog">
          <div class="qa-bar" aria-hidden="true"><span id="qa-fill"></span></div>
          <span id="qa-count" class="qa-hint"></span>
        </div>
        <div id="qa-step"></div>
        <p class="qa-err" id="qa-err" role="alert" hidden></p>
        <div class="qa-nav">
          <button type="button" id="qa-back" class="qa-link">{qa.ui.atras}</button>
          <button type="button" id="qa-next" class="btn-primary hover:btn-primary-hover">{qa.ui.siguiente}</button>
        </div>
      </div>
      <div id="qa-out" class="qa-card" aria-live="polite" hidden></div>
    </div>
  </div>
</section>

<section class="wrap section-y" id="qa-sum" aria-label={qa.t.summary.kicker} hidden></section>

<section class="wrap section-y" id="ejemplos">
  <div class="section-head">
    <div>
      <span class="kicker mb-5">{ej.kicker}</span>
      <h2 class="t-h2-compact max-w-[22ch]">{ej.title}</h2>
      <p class="mt-5 max-w-[62ch] text-[17px] leading-[1.55] text-muted">{ej.lead}</p>
    </div>
  </div>
  <div class="qa-deps">
    {
      grupos.map((g) => (
        <div class="qa-dep">
          <h3 class="qa-h">{ej.deps[g.dep]}</h3>
          <ul class="qa-ejs">
            {g.items.map((e) => (
              <li class="qa-ej">
                <h4 class="text-lg font-medium leading-tight tracking-[-0.015em]">{e.n}</h4>
                <p class="text-[15px] leading-[1.6] text-muted">{e.d}</p>
                <p class="qa-ejr">
                  <span class="qa-hint">{ej.resultado}</span>
                  <span class="qa-chip" data-estado={e.color}>{e.estado}</span>
                  <span class="text-[15px]">{e.solucion}</span>
                </p>
                <button type="button" class="qa-link qa-probar" data-ejemplo={e.id}>{ej.probar}</button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<section class="wrap section-y">
  <div class="grid items-start gap-x-[clamp(32px,5vw,96px)] gap-y-8 lg:grid-cols-3">
    <div>
      <span class="kicker mb-5">{qa.faq.kicker}</span>
      <h2 class="t-h2-compact">{qa.faq.title}</h2>
    </div>
    <div class="lg:col-span-2">
      <FaqList items={qa.faq.items as unknown as { q: string; a: string[] }[]} group="faq-qa" openFirst />
    </div>
  </div>
</section>

{/* El formulario de revisión vive aquí escondido y el script lo mueve dentro
    de la tarjeta del resultado: la acción va justo debajo del veredicto. Se
    envía por `fetch` para que el resultado siga en pantalla. */}
<div id="qa-rev-holder" hidden>
  <form id="qa-rev" class="qa-revf" novalidate>
    <input type="hidden" name="access_key" value={CLAVE_WEB3FORMS} />
    <input type="hidden" name="subject" value={c.subject} />
    <input type="hidden" name="resumen" value="" />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
    <p class="qa-revt" id="qa-revt"></p>
    <p class="qa-hint" id="qa-revc">{qa.t.form.cuerpo}</p>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-3">
      <input id="qa-rn" name="name" type="text" required autocomplete="name" class="input" placeholder={c.name} aria-label={c.name} />
      <input id="qa-re" name="email" type="email" required autocomplete="email" class="input" placeholder={c.email} aria-label={c.email} />
    </div>
    <label class="flex items-start gap-2.5 text-[13px] leading-normal text-muted">
      <input type="checkbox" name="privacy" required class="mt-[3px] accent-accent" />
      <span>{c.privacyPre}<a href={routeMap.privacy[lang]} class="link-inline">{c.privacyLink}</a>{c.privacyPost}</span>
    </label>
    <p class="text-[14px]" id="qa-rmsg" role="status" hidden></p>
    <div class="qa-acts">
      <button type="submit" class="btn-primary hover:btn-primary-hover">{qa.t.form.boton}</button>
      <a href={empezar} id="qa-cta" class="qa-link">{qa.t.form.llamada}</a>
    </div>
  </form>
</div>

<script type="application/json" id="qa-datos" set:html={datos} />

