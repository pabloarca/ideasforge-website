---
/*
  El formulario largo de exploración. Mismos campos y mismo envío de siempre:
  lo que cambia es el aspecto, que es el del formulario de contacto de la
  portada (etiqueta pequeña encima, campo con borde de 2 px, sin radios).

  A la derecha, fijo mientras se rellena, lo que se recibe a cambio y lo que
  no: la promesa está en pantalla en el momento en que alguien decide si
  termina de escribir.
*/
import { type Lang, content } from '../i18n/ui';
import { routeMap } from '../i18n/utils';
import { CLAVE_WEB3FORMS, RUTA_GRACIAS } from '../lib/formulario';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].start;
const c = content[lang].contact;
const f = t.form;
const privacyHref = routeMap.privacy[lang];
const rutaGracias = RUTA_GRACIAS[lang];
---

<section class="wrap pt-[clamp(56px,7vw,96px)]">
  <header>
    <span class="kicker mb-7">{t.eyebrow}</span>
    <h1 class="t-display max-w-[22ch]">{t.title}</h1>
    <p class="mt-6 max-w-[62ch] text-[17px] leading-[1.55] text-muted">{t.subtitle}</p>
  </header>

  <div
    class="mt-[clamp(40px,5vw,64px)] grid gap-x-[clamp(32px,6vw,112px)] gap-y-12 border-t-2 border-fg pt-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]"
  >
    {/*
      Posts to Web3Forms, same as the home form: fully static hosting, no
      backend. Without JS the browser posts natively and lands on the
      Web3Forms confirmation page.
    */}
    <form action="https://api.web3forms.com/submit" method="POST" class="grid content-start gap-5">
      <input type="hidden" name="access_key" value={CLAVE_WEB3FORMS} />
      <input type="hidden" name="subject" value={f.subject} />
      {/* Sin `redirect`, quien envía aterriza en la página de confirmación
          de Web3Forms. Con él, en la nuestra. Pide URL absoluta. */}
      {
        rutaGracias && (
          <input
            type="hidden"
            name="redirect"
            value={new URL(rutaGracias, Astro.site ?? 'https://ideasforge.io').href}
          />
        )
      }
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-5">
        <div class="field">
          <label for="name">{f.name.label}</label>
          <input id="name" name="name" type="text" required autocomplete="name" class="input" />
        </div>
        <div class="field">
          <label for="email">{f.email.label}</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="input" />
        </div>
      </div>

      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-5">
        <div class="field">
          <label for="company">{f.company.label}</label>
          <input id="company" name="company" type="text" required autocomplete="organization" class="input" />
        </div>
        <div class="field">
          <label for="website">
            {f.website.label}
            {f.website.hint && <span class="text-faint"> ({f.website.hint.toLowerCase()})</span>}
          </label>
          <input id="website" name="website" type="url" inputmode="url" autocomplete="url" class="input" />
        </div>
      </div>

      <div class="field">
        <label for="company_size">{f.size.label}</label>
        <select id="company_size" name="company_size" class="input">
          {
            f.size.options?.map((opt, i) => (
              <option value={i === 0 ? '' : opt} selected={i === 0} disabled={i === 0}>
                {opt}
              </option>
            ))
          }
        </select>
      </div>

      <div class="field">
        <label for="problem">{f.problem.label}</label>
        <textarea
          id="problem"
          name="problem"
          required
          aria-describedby="problem-hint"
          class="input"></textarea>
        <p id="problem-hint" class="text-[13px] leading-normal text-faint">{f.problem.hint}</p>
      </div>

      <div class="field">
        <label for="data_location">{f.dataHome.label}</label>
        <select id="data_location" name="data_location" class="input">
          {
            f.dataHome.options?.map((opt, i) => (
              <option value={i === 0 ? '' : opt} selected={i === 0} disabled={i === 0}>
                {opt}
              </option>
            ))
          }
        </select>
      </div>

      <div class="field">
        <label for="data_can_leave">{f.dataOut.label}</label>
        <select id="data_can_leave" name="data_can_leave" class="input">
          {
            f.dataOut.options?.map((opt, i) => (
              <option value={i === 0 ? '' : opt} selected={i === 0} disabled={i === 0}>
                {opt}
              </option>
            ))
          }
        </select>
      </div>

      <div class="field">
        <label for="timeline">{f.timeline.label}</label>
        <select id="timeline" name="timeline" class="input">
          {
            f.timeline.options?.map((opt, i) => (
              <option value={i === 0 ? '' : opt} selected={i === 0} disabled={i === 0}>
                {opt}
              </option>
            ))
          }
        </select>
      </div>

      <label class="flex items-start gap-2.5 text-[13px] leading-normal text-muted">
        <input type="checkbox" name="privacy" required class="mt-[3px] accent-accent" />
        <span>
          {c.privacyPre}<a href={privacyHref} class="link-inline">{c.privacyLink}</a>{c.privacyPost}
        </span>
      </label>

      <div>
        <button type="submit" class="btn-primary hover:btn-primary-hover">{f.submit}</button>
      </div>
    </form>

    {/* Stays in view while the form is filled in, so the promise is on screen
        at the moment the reader decides whether to finish. */}
    <aside class="lg:sticky lg:top-[104px] lg:self-start">
      <h2 class="text-lg leading-tight tracking-[-0.015em]">{t.getHeading}</h2>
      <ul class="mt-5 border-b-2 border-border">
        {
          t.get.map((item) => (
            <li class="grid grid-cols-[10px_minmax(0,1fr)] gap-4 border-t-2 border-border py-3.5 text-[15px] leading-[1.5]">
              <span class="sq mt-[6px]" aria-hidden="true" />
              <span set:html={item} />
            </li>
          ))
        }
      </ul>

      <h2 class="mt-12 text-lg leading-tight tracking-[-0.015em]">{t.notHeading}</h2>
      <ul class="mt-5 border-b-2 border-border">
        {
          t.not.map((item) => (
            <li class="border-t-2 border-border py-3.5 text-[15px] leading-[1.5] text-muted">{item}</li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>
