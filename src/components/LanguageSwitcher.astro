---
import { type Lang, languages, content } from '../i18n/ui';
import { otherLang } from '../i18n/utils';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
  /** Clases extra del sitio que lo monta. En movil se usa para darle el
      mismo cuerpo de boton que el hamburguesa y un area tactil decente. */
  class?: string;
}

const { lang: current, alternates, class: className = '' } = Astro.props;
const target = otherLang(current);
const href = alternates[target] ?? (target === 'es' ? '/' : '/en');
const t = content[current];
---

<a
  href={href}
  hreflang={target === 'es' ? 'es-ES' : 'en-US'}
  aria-label={t.nav.switchTo}
  class:list={[
    'inline-flex items-center gap-1.5 text-sm font-semibold uppercase tracking-wide text-fg transition-colors hover:text-accent',
    className,
  ]}
>
  {languages[target].slice(0, 2).toUpperCase()}
</a>
