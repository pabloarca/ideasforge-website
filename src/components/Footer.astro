---
import { type Lang, content } from '../i18n/ui';
import { localizedPath, routeMap } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();

const menu = [
  { label: t.nav.services, href: localizedPath('/#servicios', lang), icon: 'grid' },
  { label: t.nav.projects, href: localizedPath('/#proyectos', lang), icon: 'briefcase' },
  { label: t.nav.about, href: routeMap.about[lang]!, icon: 'user' },
  { label: t.nav.blog, href: localizedPath('/blog', lang), icon: 'file' },
  { label: t.nav.contact, href: localizedPath('/#contacto', lang), icon: 'user' },
];

const legal = [
  { label: t.footer.privacy, href: routeMap.privacy[lang] },
  { label: t.footer.cookies, href: routeMap.cookies[lang] },
];
---

<footer class="border-t border-border-soft bg-bg-soft">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-5">
      <!-- Logo + legal -->
      <div class="lg:col-span-2">
        <a href={localizedPath('/', lang)} class="inline-flex items-center" aria-label="Ideasforge">
          <img src="/ideasforge-logo.svg" alt="Ideasforge" class="h-8 w-auto" />
        </a>
        <ul class="mt-8 space-y-3">
          {legal.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-fg transition-colors hover:text-accent">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services (crawlable links to the keyword/service pages) -->
      <nav aria-label={t.footer.servicesHeading}>
        <h2 class="text-base font-bold text-fg">{t.footer.servicesHeading}</h2>
        <ul class="mt-5 space-y-3.5">
          {t.footer.servicesLinks.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-fg transition-colors hover:text-accent">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Menu -->
      <nav aria-label={t.footer.menu}>
        <h2 class="text-base font-bold text-fg">{t.footer.menu}</h2>
        <ul class="mt-5 space-y-3.5">
          {menu.map((l) => (
            <li>
              <a href={l.href} class="inline-flex items-center gap-2 text-sm text-fg transition-colors hover:text-accent">
                {l.icon === 'grid' && (
                  <svg class="h-5 w-5 text-fg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M3 6a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3V6ZM3 15.75a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-2.25Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3v-2.25Z" clip-rule="evenodd" />
                  </svg>
                )}
                {l.icon === 'briefcase' && (
                  <svg class="h-5 w-5 text-fg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M5.566 4.657A4.505 4.505 0 0 1 6.75 4.5h10.5c.41 0 .806.055 1.183.157A3 3 0 0 0 15.75 3h-7.5a3 3 0 0 0-2.684 1.657ZM2.25 12a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3v-6ZM5.25 7.5c-.41 0-.806.055-1.184.157A3 3 0 0 1 6.75 6h10.5a3 3 0 0 1 2.683 1.657A4.505 4.505 0 0 0 18.75 7.5H5.25Z" />
                  </svg>
                )}
                {l.icon === 'file' && (
                  <svg class="h-5 w-5 text-fg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625Z" clip-rule="evenodd" />
                    <path d="M12.971 1.816A5.23 5.23 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 0 1 3.434 1.279 9.768 9.768 0 0 0-6.963-6.963Z" />
                  </svg>
                )}
                {l.icon === 'user' && (
                  <svg class="h-5 w-5 text-fg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
                  </svg>
                )}
                <span>{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact / Social -->
      <div>
        <h2 class="text-base font-bold text-fg">{t.footer.contactHeading}</h2>
        <a
          href="https://www.linkedin.com/"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="LinkedIn"
          class="mt-5 inline-flex h-10 w-10 items-center justify-center rounded-md bg-fg text-bg transition-colors hover:bg-accent"
        >
          <svg class="h-5 w-5" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
            <path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-14 border-t border-border-soft pt-6 text-center text-sm text-muted">
      © {year} {t.footer.rights}
    </div>
  </div>
</footer>
