---
import { type Lang, content } from '../i18n/ui';
import { localizedPath, routeMap } from '../i18n/utils';
import { medidas } from '../lib/imagen';
import { EMPRESA } from '../lib/empresa';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();

/*
  Pie del diseño de octubre de 2026: cuatro columnas de enlaces a 13 px y una
  fila de cierre con el logotipo y el copyright.

  Las tres primeras columnas son las mismas listas que alimentan los
  desplegables de la cabecera: soluciones, sectores y guías. «Sectores» sale
  de `nav.sectorLinks` y va entre las otras dos, con el nombre del sector a
  secas. La cuarta, «Empresa», reúne lo que antes iba repartido entre el menú
  suelto, el bloque legal y el icono de LinkedIn.
*/

/* Misma variable que gobierna el aviso de cookies, ver CookieConsent.astro. */
/*
  Los TRES identificadores, no solo GA (14 sep 2026). Con solo `PUBLIC_GA_ID`
  aquí, activar únicamente Google Ads o el píxel de Meta sacaba el aviso de
  cookies y dejaba el pie sin el enlace para volver a decidir: consentimiento
  que se puede dar y no retirar, que es justo lo que la norma no permite.
*/
const hayMedicion = Boolean(
  import.meta.env.PUBLIC_GA_ID?.trim() ||
    import.meta.env.PUBLIC_ADS_ID?.trim() ||
    import.meta.env.PUBLIC_META_PIXEL_ID?.trim()
);

const [soluciones, ...otrosGrupos] = t.footer.navGroups;
const columnas = [soluciones, { heading: t.nav.sectors, links: t.nav.sectorLinks }, ...otrosGrupos];

const empresa = [
  { label: t.nav.blog, href: localizedPath('/blog', lang) },
  // Solo donde la sección existe: en inglés todavía no hay preguntas frecuentes.
  ...(routeMap.faqs[lang] ? [{ label: t.nav.faqs, href: routeMap.faqs[lang] }] : []),
  { label: t.nav.contact, href: routeMap.contact[lang] ?? localizedPath('/#contacto', lang) },
];
---

<footer class="mt-[clamp(96px,12vw,160px)] border-t-2 border-border">
  <div class="wrap pb-10 pt-12">
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,180px),1fr))] gap-x-8 gap-y-10 text-[13px] leading-[1.8] text-muted"
    >
      {
        columnas.map((g) => (
          <nav aria-label={g.heading}>
            <p class="mb-2 text-fg">{g.heading}</p>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class="transition-colors hover:text-accent">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <nav aria-label={t.footer.menu}>
        <p class="mb-2 text-fg">{t.footer.menu}</p>
        <ul>
          {
            empresa.map((l) => (
              <li>
                <a href={l.href} class="transition-colors hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={EMPRESA.perfiles[0]}
              rel="noopener noreferrer"
              target="_blank"
              class="transition-colors hover:text-accent"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a href={routeMap.privacy[lang]} class="transition-colors hover:text-accent">{t.footer.privacyShort}</a>
            <span aria-hidden="true"> · </span>
            <a href={routeMap.cookies[lang]} class="transition-colors hover:text-accent">{t.footer.cookiesShort}</a>
          </li>
          {/* Reabre el aviso de cookies. No es un adorno: retirar el
              consentimiento tiene que costar lo mismo que darlo, y sin este
              enlace la única salida sería borrar el almacenamiento a mano.
              Va como <button> y no como <a> porque no lleva a ninguna parte.

              Y solo aparece si hay medición configurada: sin ella no hay nada
              que preferir y sería un botón que no hace nada. */}
          {
            hayMedicion && (
              <li>
                <button
                  type="button"
                  data-cookie-prefs
                  class="cursor-pointer text-left transition-colors hover:text-accent"
                >
                  {t.footer.cookiePrefs}
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>

    <div class="mt-14 flex flex-wrap items-center justify-between gap-6 border-t-2 border-border pt-6">
      <a href={localizedPath('/', lang)} aria-label="Ideasforge">
        <img
          src="/ideasforge-logo.svg"
          alt="Ideasforge"
          {...medidas('/ideasforge-logo.svg')}
          loading="lazy"
          decoding="async"
          class="h-[18px] w-auto"
        />
      </a>
      <span class="text-[13px] text-muted">© {year} {t.footer.rights}</span>
    </div>
  </div>
</footer>
