---
/*
  Las cuatro capas que separan los datos de una empresa de los de la de al lado.

  Existe porque el párrafo del aislamiento en «La seguridad es el punto de
  partida» dice dos cosas a la vez que en prosa cuestan de sostener: que son
  capas apiladas, cada una cubriendo el fallo de la de arriba, y que solo la
  primera está al alcance del modelo. Puestas en vertical, con la llave lateral
  marcando dónde acaba el modelo y empieza el código, las dos se ven de un
  vistazo.

  El azul es el mismo que en `FormasDiagram` y `EntradasDiagram`: acento para lo
  que decide o ve el modelo, tinta neutra para lo que hace el código. Por eso va
  sobre fondo `hielo`, porque sobre el azul oscuro del kit el acento desaparece.

  Layout aquí, texto en `content[lang].capasDiagram`, que es la regla de la
  casa. El lienzo mide 1100 × 400 en píxeles absolutos y se escala para caber.
*/
import { type Lang, content } from '../i18n/ui';
import GrainFrame from './graficos/GrainFrame.astro';
import DiagramCanvas from './graficos/DiagramCanvas.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = content[lang].capasDiagram;

const IZQ = 180; // dónde empieza la banda, con sitio a su izquierda para la llave
const ANCHO = 900;
const ALTO = 58;
const FILA0 = 66;
const SALTO = 66;

const fin = FILA0 + 3 * SALTO + ALTO; // borde inferior de la última capa
const centro = IZQ + ANCHO / 2;
---

<figure class="my-10">
  {/*
    Versión de móvil: la misma pila sin coordenadas. Las llaves laterales no
    caben a la izquierda, así que cada una pasa a ser un rótulo encima de su
    tramo: «lo que el modelo ve» sobre la primera capa y «lo que decide el
    código» sobre las otras tres.
  */}
  <div class="lg:hidden">
    <GrainFrame height="auto" title={d.title} fondo="hielo" pad="20px">
      <div class="cm-pila">
        <p class="cm-punta cd-modelo">{d.entrada}</p>
        <span class="cm-flecha" aria-hidden="true"></span>
        <p class="cm-llave cd-modelo">{d.llaves.modelo}</p>
        {
          d.capas.map((capa, i) => (
            <>
              {i === 1 && <p class="cm-llave">{d.llaves.codigo}</p>}
              <div class:list={['cm-capa', i === 0 && 'cd-modelo']}>
                <span class="cd-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="cm-texto">
                  <span class="cm-name">{capa.name}</span>
                  <span class="cm-desc">{capa.desc}</span>
                </span>
              </div>
            </>
          ))
        }
        <span class="cm-flecha" aria-hidden="true"></span>
        <p class="cm-punta">{d.salida}</p>
      </div>
    </GrainFrame>
  </div>

  <div class="hidden lg:block">
  <GrainFrame height="540px" title={d.title} fondo="hielo">
    <DiagramCanvas width={1100} height={400}>
      {/* La pregunta baja, cruza las cuatro capas y sale por abajo. */}
      <path slot="edges" d={`M${centro},44 L${centro},${FILA0 - 4}`} marker-end="url(#dg-arrow)" />
      <path slot="edges" d={`M${centro},${fin} L${centro},${fin + 20}`} marker-end="url(#dg-arrow)" />

      {/* Llave de la primera capa, la única que el modelo llega a ver. */}
      <path slot="edges" d={`M${IZQ - 18},${FILA0} L${IZQ - 28},${FILA0} L${IZQ - 28},${FILA0 + ALTO} L${IZQ - 18},${FILA0 + ALTO}`} />
      {/* Llave de las tres restantes, que son código y nada más. */}
      <path slot="edges" d={`M${IZQ - 18},${FILA0 + SALTO} L${IZQ - 28},${FILA0 + SALTO} L${IZQ - 28},${fin} L${IZQ - 18},${fin}`} />

      <div class="cd-punta cd-modelo" style={`left:${centro - 150}px;top:0;width:300px`}>
        {d.entrada}
      </div>

      {
        d.capas.map((capa, i) => (
          <div
            class:list={['cd-capa', i === 0 && 'cd-modelo']}
            style={`left:${IZQ}px;top:${FILA0 + i * SALTO}px;width:${ANCHO}px;height:${ALTO}px`}
          >
            <span class="cd-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="cd-name">{capa.name}</span>
            <span class="cd-desc">{capa.desc}</span>
          </div>
        ))
      }

      <div class="cd-llave cd-modelo" style={`top:${FILA0 + ALTO / 2 - 9}px;width:${IZQ - 40}px`}>
        {d.llaves.modelo}
      </div>
      <div
        class="cd-llave"
        style={`top:${(FILA0 + SALTO + fin) / 2 - 18}px;width:${IZQ - 40}px`}
      >
        {d.llaves.codigo}
      </div>

      <div class="cd-punta" style={`left:${centro - 170}px;top:${fin + 24}px;width:340px`}>
        {d.salida}
      </div>
    </DiagramCanvas>
  </GrainFrame>
  </div>

  <figcaption class="mt-6 border-l-2 border-accent pl-4 text-[15px] leading-relaxed text-fg">
    {d.legend}
  </figcaption>
</figure>

<style>
  .cd-capa,
  .cd-punta,
  .cd-llave {
    position: absolute;
    box-sizing: border-box;
    font-family: var(--font-sans, 'Space Grotesk', sans-serif);
  }

  /* Entrada y salida: la pregunta que baja y lo que acaba saliendo. */
  .cd-punta {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 14px;
    border: 1.3px solid color-mix(in oklab, currentColor 40%, transparent);
    border-radius: 7px;
    background: color-mix(in oklab, currentColor 6%, transparent);
    font-size: 15px;
    font-weight: 500;
    text-align: center;
  }

  .cd-capa {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 20px;
    border: 1.3px solid color-mix(in oklab, currentColor 40%, transparent);
    border-radius: 7px;
    background: color-mix(in oklab, currentColor 6%, transparent);
  }
  .cd-num {
    flex: none;
    font-family: var(--font-mono, ui-monospace, 'SF Mono', 'JetBrains Mono', monospace);
    font-size: 12px;
    letter-spacing: 1.5px;
    opacity: 0.55;
  }
  .cd-name {
    flex: none;
    width: 230px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
  }
  .cd-desc {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.25;
    opacity: 0.85;
  }

  /* Rótulo de cada llave lateral, pegado a la derecha de su columna. */
  .cd-llave {
    left: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* Lo que el modelo ve, con el acento de la casa. */
  .cd-modelo {
    color: var(--color-accent);
    opacity: 1;
  }
  /* ---- Versión de móvil: pila sin coordenadas ---- */
  .cm-pila {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    font-family: var(--font-sans, 'Space Grotesk', sans-serif);
  }
  .cm-punta {
    margin: 0;
    align-self: center;
    padding: 9px 14px;
    border: 1.3px solid color-mix(in oklab, currentColor 40%, transparent);
    border-radius: 7px;
    background: color-mix(in oklab, currentColor 6%, transparent);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }
  .cm-flecha {
    align-self: center;
    width: 1.3px;
    height: 18px;
    background: currentColor;
    opacity: 0.8;
    position: relative;
  }
  .cm-flecha::after {
    content: '';
    position: absolute;
    left: -4px;
    bottom: -2px;
    border: 4.5px solid transparent;
    border-top: 6px solid currentColor;
    border-bottom: 0;
  }
  .cm-llave {
    margin: 6px 0 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .cm-capa {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 12px;
    border: 1.3px solid color-mix(in oklab, currentColor 40%, transparent);
    border-radius: 7px;
    background: color-mix(in oklab, currentColor 6%, transparent);
  }
  .cm-capa .cd-num {
    padding-top: 2px;
  }
  .cm-texto {
    display: grid;
    gap: 3px;
  }
  .cm-name {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }
  .cm-desc {
    font-size: 13px;
    line-height: 1.3;
    opacity: 0.85;
  }
  .cm-capa.cd-modelo,
  .cm-punta.cd-modelo {
    border-color: color-mix(in oklab, var(--color-accent) 70%, transparent);
    background: color-mix(in oklab, var(--color-accent) 12%, transparent);
  }

  .cd-capa.cd-modelo,
  .cd-punta.cd-modelo {
    border-color: color-mix(in oklab, var(--color-accent) 70%, transparent);
    background: color-mix(in oklab, var(--color-accent) 12%, transparent);
  }
</style>
