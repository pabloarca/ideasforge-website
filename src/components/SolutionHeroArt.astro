---
/*
  El dibujo animado del héroe de cada página de solución. Son las cinco
  composiciones del paquete de diseño del 8 oct 2026
  (`.private/animaciones-hero/`), una por solución y todas en el mismo
  lenguaje: cuadrados y rectángulos sin radio, gris para lo que está en bruto,
  tinta para lo ordenado y el acento para la IA actuando. Sustituyen al
  círculo de nodos unidos por reglas, que era el mismo en las cinco páginas.

    agentDev        ocho nodos dispersos se ordenan en círculo alrededor del
                    agente y unos paquetes viajan entre él y ellos;
    processAuto     seis documentos dispersos se alinean en columna y una
                    regla azul los recorre;
    enterprise      una regla azul lee un documento, deja encendidas las
                    líneas que sirven y debajo se escribe la respuesta;
    conversational  una conversación por turnos que acaba en una acción;
    consulting      siete ideas iguales, de las que se priorizan tres.

  El prototipo las monta con React. Aquí se calculan al compilar y salen como
  `<span>` con su estilo en línea, sin JavaScript en la página. Las medidas
  son las del lienzo de 400 px del diseño pasadas a porcentaje, así que el
  dibujo encoge con su caja.

  Con `prefers-reduced-motion` no se anima nada y cada composición se queda
  en su estado ordenado, que es lo que pide el paquete. Hace falta decirlo
  pieza a pieza, porque varias nacen invisibles y es la animación quien las
  enseña.
*/
import { type SolutionKey } from '../i18n/ui';

interface Props {
  clave: SolutionKey;
}
const { clave } = Astro.props;

type Estilo = Record<string, string | number>;
type Pieza = { cls?: string; style: string; hijos?: Pieza[] };

const S = 400;
const EASE = 'var(--ease-in-out)';
const GRIS = 'var(--color-neutral-400)';
const TINTA = 'var(--color-fg)';
const AZUL = 'var(--color-accent)';

const pc = (v: number) => `${((v / S) * 100).toFixed(3)}%`;
const css = (o: Estilo) =>
  Object.entries(o)
    .map(([k, v]) => `${k}:${v}`)
    .join(';');
/* Azar estable: el mismo dibujo en cada compilación. */
const azar = (i: number, n: number) => {
  const x = Math.sin(i * 12.9898 + n * 78.233) * 43758.5453;
  return x - Math.floor(x);
};
const caja = (x: number, y: number, w: number, h: number, extra: Estilo = {}): Estilo => ({
  position: 'absolute',
  left: pc(x),
  top: pc(y),
  width: pc(w),
  height: pc(h),
  display: 'block',
  ...extra,
});

/* 1. Agentes: el agente y sus sistemas. */
function agentes(): Pieza[] {
  const c = 200;
  const R = 150;
  const N = 8;
  const T = 10;
  const nodos = Array.from({ length: N }, (_, i) => {
    const a = (i / N) * Math.PI * 2 - Math.PI / 2;
    return { x: c + Math.cos(a) * R, y: c + Math.sin(a) * R, i };
  });
  /* Dispersión hacia el interior, para que ningún nodo salga de la caja. */
  const disperso = (i: number, n?: { x: number; y: number }): Estilo => {
    const ax = (30 + azar(i, 1) * 70) * 0.8;
    const ay = (30 + azar(i, 2) * 70) * 0.8;
    const alAzar = (k: number) => (azar(i, k) < 0.5 ? -1 : 1);
    const sx = n ? -Math.sign(n.x - c) || alAzar(1) : alAzar(1);
    const sy = n ? -Math.sign(n.y - c) || alAzar(2) : alAzar(2);
    return {
      '--gx': `${Math.round(sx * ax)}px`,
      '--gy': `${Math.round(sy * ay)}px`,
      '--gr': `${Math.round((azar(i, 3) - 0.5) * 120)}deg`,
    };
  };
  const cuadrado = (x: number, y: number, lado: number, extra: Estilo) =>
    css(caja(x - lado / 2, y - lado / 2, lado, lado, extra));

  /* Paquetes: un contenedor del tamaño de la caja, colocado en el punto de
     salida, que se traslada un porcentaje de sí mismo hasta el de llegada.
     Los pares salen del centro y los impares entran. */
  const paquetes: Pieza[] = nodos.map((n) => {
    const sale = n.i % 2 === 0;
    const de = sale ? { x: c, y: c } : n;
    const a = sale ? n : { x: c, y: c };
    return {
      cls: 'ha-oculto',
      style: css({
        position: 'absolute',
        left: pc(de.x - 4),
        top: pc(de.y - 4),
        width: '100%',
        height: '100%',
        'pointer-events': 'none',
        '--fx': `${(((a.x - de.x) / S) * 100).toFixed(3)}%`,
        '--fy': `${(((a.y - de.y) / S) * 100).toFixed(3)}%`,
        animation: `if-flow ${T}s ${(n.i * 0.35).toFixed(2)}s ${EASE} infinite`,
      }),
      hijos: [{ style: css({ position: 'absolute', left: 0, top: 0, width: '2%', height: '2%', background: AZUL }) }],
    };
  });
  const puntos: Pieza[] = nodos.map((n) => ({
    style: cuadrado(n.x, n.y, 16, {
      background: TINTA,
      animation: `if-gather ${T}s ${(n.i * 0.08).toFixed(2)}s ${EASE} infinite`,
      ...disperso(n.i, n),
    }),
  }));
  const nucleo: Pieza = {
    style: cuadrado(c, c, 28, { background: AZUL, animation: `if-core ${T}s ${EASE} infinite`, ...disperso(9) }),
  };
  return [...paquetes, ...puntos, nucleo];
}

/* 2. Automatización: alinear y ejecutar. */
function automatizacion(): Pieza[] {
  const N = 6;
  const T = 9;
  const W = 120;
  const H = 36;
  const GAP = 14;
  const alto = N * H + (N - 1) * GAP;
  const x0 = (S - W) / 2;
  const y0 = (S - alto) / 2;
  const docs: Pieza[] = Array.from({ length: N }, (_, i) => {
    /* El primero no sube y el último no baja: se saldrían de la caja. */
    const sy = Math.max(i === 0 ? 0 : -40, Math.min(i === N - 1 ? 0 : 40, (azar(i, 2) - 0.5) * 100));
    return {
      cls: 'ha-tinta',
      style: css(
        caja(x0, y0 + i * (H + GAP), W, H, {
          background: GRIS,
          '--sx': `${Math.round((azar(i, 1) - 0.5) * 220)}px`,
          '--sy': `${Math.round(sy)}px`,
          '--sr': `${Math.round((azar(i, 3) - 0.5) * 40)}deg`,
          animation: `if-sort ${T}s ${(i * 0.12).toFixed(2)}s ${EASE} infinite`,
        })
      ),
    };
  });
  const regla: Pieza = {
    cls: 'ha-traza',
    style: css({
      position: 'absolute',
      left: pc(x0 + W / 2 - 1),
      top: pc(y0),
      width: '2px',
      height: pc(alto),
      background: AZUL,
      'z-index': 1,
      'transform-origin': '50% 100%',
      transform: 'scaleY(0)',
      animation: `if-line ${T}s ${EASE} infinite`,
    }),
  };
  return [...docs, regla];
}

/* 3. Documentación interna: recuperar y responder. */
function documentacion(): Pieza[] {
  const N = 11;
  const T = 9;
  const x0 = 70;
  const W = 260;
  const H = 8;
  const GAP = 18;
  const y0 = 60;
  const aciertos = new Set([2, 5, 6, 9]);
  const lineas: Pieza[] = Array.from({ length: N }, (_, i) => {
    /* La regla cruza la línea i en este punto del ciclo, y ahí se enciende. */
    const t = 14 + (i / (N - 1)) * 46;
    const base = caja(x0, y0 + i * (H + GAP), W * (0.55 + azar(i, 1) * 0.45), H, { background: GRIS, opacity: 0.35 });
    return aciertos.has(i)
      ? { cls: 'ha-acierto', style: css({ ...base, animation: `if-hit ${T}s ${((t / 100) * T).toFixed(2)}s linear infinite` }) }
      : { style: css(base) };
  });
  const altoDoc = (N - 1) * (H + GAP) + H;
  const lector: Pieza = {
    cls: 'ha-oculto',
    style: css(caja(x0 - 16, y0 - 6, W + 32, altoDoc + 12, { opacity: 0, 'pointer-events': 'none', animation: `if-scan ${T}s ${EASE} infinite` })),
    hijos: [{ style: css({ position: 'absolute', left: 0, top: 0, width: '100%', height: '2px', background: AZUL }) }],
  };
  const ay = y0 + altoDoc + 36;
  const filete: Pieza = {
    style: css({ position: 'absolute', left: pc(x0), top: pc(ay - 14), width: pc(W), height: '2px', background: TINTA }),
  };
  const respuesta: Pieza[] = [0.9, 0.6].map((w, i) => ({
    cls: 'ha-traza',
    style: css(
      caja(x0, ay + i * (H + 10), W * w, H, {
        background: TINTA,
        'transform-origin': '0 50%',
        transform: 'scaleX(0)',
        animation: `if-ans ${T}s ${(i * 0.25).toFixed(2)}s ${EASE} infinite`,
      })
    ),
  }));
  return [...lineas, lector, filete, ...respuesta];
}

/* 4. Agentes conversacionales: conversación con acción. */
function conversacion(): Pieza[] {
  const T = 10;
  const GAP = 22;
  /* Lado, ancho, alto y si el turno acaba en una acción. */
  const turnos: Array<['u' | 'a', number, number, boolean?]> = [
    ['u', 150, 34],
    ['a', 190, 48],
    ['u', 110, 34],
    ['a', 170, 48, true],
  ];
  const total = turnos.reduce((s, t) => s + t[2], 0) + GAP * (turnos.length - 1);
  let y = (S - total) / 2 - 10;
  const texto = (top: string, width: string): Pieza => ({
    style: css({ position: 'absolute', left: '10%', top, width, height: '2px', background: 'var(--color-bg)', opacity: 0.8 }),
  });
  return turnos.map(([lado, w, h, accion], i) => {
    const pieza: Pieza = {
      cls: 'ha-visible',
      style: css(
        caja(lado === 'u' ? 50 : S - 50 - w, y, w, h, {
          background: lado === 'u' ? GRIS : TINTA,
          opacity: 0,
          animation: `if-msg ${T}s ${(i * 0.16 * T).toFixed(2)}s var(--ease-out) infinite`,
        })
      ),
      hijos: [texto('32%', '70%'), texto('58%', '45%')],
    };
    if (accion) {
      pieza.hijos!.push({
        cls: 'ha-traza',
        style: css({
          position: 'absolute',
          left: 0,
          right: 0,
          bottom: '-8px',
          height: '3px',
          background: AZUL,
          'transform-origin': '0 50%',
          transform: 'scaleX(0)',
          animation: `if-act ${T}s ${((i * 0.16 + 0.1) * T).toFixed(2)}s ${EASE} infinite`,
        }),
      });
    }
    y += h + GAP;
    return pieza;
  });
}

/* 5. Consultoría: priorizar. */
function consultoria(): Pieza[] {
  const N = 7;
  const T = 10;
  const W = 220;
  const H = 26;
  const GAP = 20;
  const x0 = 60;
  const y0 = (S - (N * H + (N - 1) * GAP)) / 2;
  /* Las elegidas: la primera en acento, que es el primer proyecto. Cada una
     con el largo de su regla de prioridad. */
  const elegidas: Record<number, [string, number]> = { 1: [AZUL, 60], 3: [TINTA, 40], 5: [TINTA, 24] };
  const piezas: Pieza[] = [];
  for (let i = 0; i < N; i++) {
    const y = y0 + i * (H + GAP);
    const elegida = elegidas[i];
    piezas.push({
      cls: 'ha-opcion',
      style: css(
        caja(x0, y, W, H, {
          background: GRIS,
          opacity: 0,
          '--keep': elegida ? 1 : 0.22,
          '--oc': elegida ? elegida[0] : GRIS,
          animation: `if-opt ${T}s ${((i * 0.06 * T) / N).toFixed(2)}s ${EASE} infinite`,
        })
      ),
    });
    if (elegida) {
      piezas.push({
        cls: 'ha-traza',
        style: css({
          position: 'absolute',
          left: pc(x0 + W + 16),
          top: pc(y + H / 2 - 1),
          width: pc(elegida[1]),
          height: '2px',
          background: elegida[0],
          'transform-origin': '0 50%',
          transform: 'scaleX(0)',
          animation: `if-rank ${T}s ${((i * 0.03 * T) / N).toFixed(2)}s ${EASE} infinite`,
        }),
      });
    }
  }
  return piezas;
}

const composiciones: Record<SolutionKey, () => Pieza[]> = {
  agentDev: agentes,
  processAuto: automatizacion,
  enterprise: documentacion,
  conversational: conversacion,
  consulting: consultoria,
};
const piezas = composiciones[clave]();
---

<div class="hero-art">
  {
    piezas.map((p) => (
      <span class={p.cls} style={p.style}>
        {p.hijos?.map((h) => <span class={h.cls} style={h.style} />)}
      </span>
    ))
  }
</div>

<style is:global>
  /* Global a propósito: las piezas llevan la animación en su estilo en línea
     y la buscan por nombre. Los colores son los tokens del sistema. */
  .hero-art {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .hero-art span {
    display: block;
  }

  /* 1. Agentes */
  @keyframes if-gather {
    0%,
    8% {
      transform: translate(var(--gx), var(--gy)) rotate(var(--gr)) scale(0.7);
      background: var(--color-neutral-400);
    }
    32%,
    76% {
      transform: none;
      background: var(--color-fg);
    }
    92%,
    100% {
      transform: translate(var(--gx), var(--gy)) rotate(var(--gr)) scale(0.7);
      background: var(--color-neutral-400);
    }
  }
  @keyframes if-core {
    0%,
    8% {
      transform: translate(var(--gx), var(--gy)) rotate(var(--gr)) scale(0.7);
      background: var(--color-neutral-400);
    }
    32%,
    76% {
      transform: none;
      background: var(--color-accent);
    }
    92%,
    100% {
      transform: translate(var(--gx), var(--gy)) rotate(var(--gr)) scale(0.7);
      background: var(--color-neutral-400);
    }
  }
  @keyframes if-flow {
    0%,
    38% {
      transform: translate(0, 0);
      opacity: 0;
    }
    42% {
      opacity: 1;
    }
    72% {
      opacity: 1;
    }
    76%,
    100% {
      transform: translate(var(--fx), var(--fy));
      opacity: 0;
    }
  }

  /* 2. Automatización */
  @keyframes if-sort {
    0%,
    10% {
      transform: translate(var(--sx), var(--sy)) rotate(var(--sr));
      background: var(--color-neutral-400);
    }
    45%,
    70% {
      transform: none;
      background: var(--color-fg);
    }
    80%,
    100% {
      transform: translate(var(--sx), var(--sy)) rotate(var(--sr));
      background: var(--color-neutral-400);
    }
  }
  @keyframes if-line {
    0%,
    40% {
      transform: scaleY(0);
    }
    62%,
    72% {
      transform: scaleY(1);
    }
    82%,
    100% {
      transform: scaleY(0);
    }
  }

  /* 3. Documentación interna */
  @keyframes if-scan {
    0%,
    10% {
      transform: translateY(0);
      opacity: 0;
    }
    14% {
      opacity: 1;
    }
    60% {
      opacity: 1;
    }
    64%,
    100% {
      transform: translateY(100%);
      opacity: 0;
    }
  }
  @keyframes if-hit {
    0% {
      background: var(--color-neutral-400);
      opacity: 0.35;
    }
    2%,
    60% {
      background: var(--color-accent);
      opacity: 1;
    }
    68%,
    100% {
      background: var(--color-neutral-400);
      opacity: 0.35;
    }
  }
  @keyframes if-ans {
    0%,
    70% {
      transform: scaleX(0);
    }
    80%,
    88% {
      transform: scaleX(1);
    }
    96%,
    100% {
      transform: scaleX(0);
    }
  }

  /* 4. Agentes conversacionales */
  @keyframes if-msg {
    0% {
      opacity: 0;
      transform: translateY(14px);
    }
    6% {
      opacity: 1;
      transform: none;
    }
    80% {
      opacity: 1;
      transform: none;
    }
    90%,
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
  @keyframes if-act {
    0% {
      transform: scaleX(0);
    }
    30%,
    100% {
      transform: scaleX(1);
    }
  }

  /* 5. Consultoría */
  @keyframes if-opt {
    0%,
    6% {
      opacity: 0;
      transform: translateY(10px);
    }
    12%,
    40% {
      opacity: 1;
      transform: none;
      background: var(--color-neutral-400);
    }
    52%,
    82% {
      opacity: var(--keep);
      transform: none;
      background: var(--oc);
    }
    92%,
    100% {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @keyframes if-rank {
    0%,
    46% {
      transform: scaleX(0);
    }
    58%,
    82% {
      transform: scaleX(1);
    }
    92%,
    100% {
      transform: scaleX(0);
    }
  }

  /* Sin movimiento: cada composición, quieta en su estado ordenado. */
  @media (prefers-reduced-motion: reduce) {
    .hero-art span {
      animation: none !important;
    }
    .hero-art .ha-oculto {
      opacity: 0 !important;
    }
    .hero-art .ha-visible {
      opacity: 1 !important;
    }
    .hero-art .ha-traza {
      transform: none !important;
    }
    .hero-art .ha-tinta {
      background: var(--color-fg) !important;
    }
    .hero-art .ha-acierto {
      background: var(--color-accent) !important;
      opacity: 1 !important;
    }
    .hero-art .ha-opcion {
      background: var(--oc) !important;
      opacity: var(--keep) !important;
    }
  }
</style>
