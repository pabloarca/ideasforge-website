---
import { type Lang, content } from '../i18n/ui';
import { medidas } from '../lib/imagen';
import FaqList from './FaqList.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].faq;
---

<section id="faqs" class="relative scroll-mt-24 overflow-hidden bg-bg py-20 sm:py-28">
  <!-- Floating decorative crystal (desktop only) -->
  <img
    src="/decor/diamond.png"
    alt=""
    aria-hidden="true"
    {...medidas('/decor/diamond.png')}
    class="pointer-events-none absolute left-[8%] top-16 hidden h-32 w-32 select-none object-contain lg:block xl:h-40 xl:w-40"
    style="transform: rotate(-12deg);"
  />

  <div class="mx-auto max-w-4xl px-5 sm:px-8">
    <header class="text-center">
      <h2 class="text-5xl font-bold tracking-tight text-fg sm:text-6xl">{t.eyebrow}</h2>
      <p class="mt-5 text-lg text-muted">{t.subtitle}</p>
    </header>

    {/* La lista vive en FaqList, compartida con las páginas largas para que la
        misma pieza se vea y se comporte igual en todo el sitio. */}
    <FaqList items={t.items} group="faq-home" class="mt-12" />
  </div>
</section>
