---
import { type Lang, content, type ServiceGroup } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].services;

const groups: Array<{ key: 'enterprise' | 'smb'; group: ServiceGroup }> = [
  { key: 'enterprise', group: t.enterprise },
  { key: 'smb', group: t.smb },
];
---

<section id="servicios" class="scroll-mt-24 bg-bg-soft py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <header class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        {t.title}
      </h2>
      <p class="mt-4 text-lg text-muted">{t.subtitle}</p>
    </header>

    <div class="mt-14 space-y-14 lg:mt-20 lg:space-y-20">
      {
        groups.map(({ key, group }) => (
          <div>
            <p class="eyebrow text-center">{group.label}</p>
            <ul
              class={`mt-7 grid gap-6 ${
                key === 'enterprise'
                  ? 'sm:grid-cols-2 lg:grid-cols-4'
                  : 'sm:grid-cols-2 lg:grid-cols-3'
              }`}
            >
              {group.items.map((item) => (
                <li class="flex">
                  {item.href ? (
                    <a
                      href={item.href}
                      class="card-soft rainbow-ring hover:card-soft-hover flex w-full flex-col p-7 transition"
                    >
                      <h3 class="text-lg font-bold leading-snug text-fg">{item.title}</h3>
                      <p class="mt-3 text-[15px] leading-relaxed text-muted">
                        {item.description}
                      </p>
                      {item.proof && (
                        <div class="mt-auto pt-6">
                          <span class="inline-flex items-center rounded-full border border-border bg-bg px-3 py-1 text-xs font-medium text-accent">
                            {item.proof}
                          </span>
                        </div>
                      )}
                    </a>
                  ) : (
                    <div class="card-soft rainbow-ring flex w-full flex-col p-7">
                      <h3 class="text-lg font-bold leading-snug text-fg">{item.title}</h3>
                      <p class="mt-3 text-[15px] leading-relaxed text-muted">
                        {item.description}
                      </p>
                      {item.proof && (
                        <div class="mt-auto pt-6">
                          <span class="inline-flex items-center rounded-full border border-border bg-bg px-3 py-1 text-xs font-medium text-accent">
                            {item.proof}
                          </span>
                        </div>
                      )}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 text-center">
      <a
        href={localizedPath('/#contacto', lang)}
        class="btn-primary hover:btn-primary-hover"
      >
        {t.cta}
      </a>
    </div>
  </div>
</section>
