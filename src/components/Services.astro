---
/*
  Lo que construimos, en retícula continua al estilo de la seccion «do it all»
  de mistral.ai: las cajas no van sueltas con su sombra, comparten linea.

  El truco es `gap-px` sobre un fondo del color del borde: los huecos de un
  pixel entre celdas dejan ver ese fondo y forman la cuadricula sola, sin que
  haya que quitarle el borde a la ultima columna ni a la ultima fila cuando
  cambia el numero de columnas. Sin esquinas redondeadas: la reticula se lee
  como una sola pieza y el canto recto la hace mas rotunda.

  Las cajas son cuadradas: el alto lo marca el ancho de la columna. Eso obliga
  a que el texto se adapte al hueco y no al reves, asi que titulo y descripcion
  se recortan con puntos suspensivos. El recorte de la descripcion cambia por
  tamano de pantalla, porque el lado del cuadrado depende de cuantas columnas
  haya: con cuatro en una pantalla de portatil el cuadrado es pequeno y solo
  caben dos lineas, mientras que a partir de 1280 px vuelven a caber cuatro.

  En reposo cada caja muestra titulo y descripcion. La prueba de que existe un
  caso real («Como en Savian») aparece al pasar por encima, y su hueco esta
  reservado siempre para que ninguna caja cambie de alto.
*/
import { type Lang, content, type ServiceGroup } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import Icon from './Icon.astro';
import LatticeDots from './LatticeDots.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].services;

const groups: Array<{ key: 'enterprise' | 'smb'; group: ServiceGroup }> = [
  { key: 'enterprise', group: t.enterprise },
  { key: 'smb', group: t.smb },
];
---

<section id="servicios" class="scroll-mt-24 bg-bg-soft py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <header class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        {t.title}
      </h2>
      <p class="mt-4 text-lg text-muted">{t.subtitle}</p>
    </header>

    <div class="mt-14 space-y-14 lg:mt-20 lg:space-y-20">
      {
        groups.map(({ key, group }) => (
          <div>
            <p class="eyebrow text-center">{group.label}</p>
            <ul
              class={`mt-7 grid gap-px border border-border bg-border sm:grid-cols-2 ${
                key === 'enterprise' ? 'lg:grid-cols-4' : 'lg:grid-cols-3'
              }`}
            >
              {group.items.map((item, i) => {
                // Con cuatro columnas el cuadrado se queda corto entre 1024 y
                // 1280 px. Con tres nunca pasa, asi que solo el primer grupo
                // necesita apretar el recorte en ese tramo.
                const clamp =
                  key === 'enterprise'
                    ? 'line-clamp-4 lg:line-clamp-2 xl:line-clamp-4'
                    : 'line-clamp-4';

                const inner = (
                  <>
                    <h3 class="line-clamp-3 text-base font-bold leading-snug text-fg xl:text-lg">
                      {item.title}
                    </h3>
                    <p class={`mt-3 text-sm leading-relaxed text-muted xl:text-[15px] ${clamp}`}>
                      {item.description}
                    </p>
                    {/* Hueco reservado: la prueba entra y sale sin mover nada.
                        El icono comparte esa fila por el otro extremo, asi que
                        los dos avisos de que hay algo debajo del raton llegan a
                        la vez y ninguno obliga a la caja a cambiar de alto.
                        Va abajo y no arriba porque el titulo llega a ocupar
                        tres lineas y ahi se pisarian. */}
                    <div class="mt-auto flex items-end justify-between gap-3 pt-7">
                      {/* Dos rotulos en el mismo hueco, uno releva al otro.
                          En reposo, el nombre de la pagina de destino: es el
                          puente con el desplegable de la cabecera, que llama a
                          las paginas por su nombre y no por lo que consigues.
                          Al pasar el raton, la prueba de que el caso existe.
                          Comparten sitio porque los dos son secundarios y
                          apilarlos obligaria a la caja a crecer. */}
                      <div class="relative h-6 min-w-0 flex-1">
                        {item.pageLabel && (
                          <span class="absolute inset-y-0 left-0 flex items-center truncate text-xs text-faint transition-opacity duration-300 group-hover:opacity-0">
                            {item.pageLabel}
                          </span>
                        )}
                        {item.proof && (
                          <span class="absolute inset-y-0 left-0 inline-flex h-6 items-center whitespace-nowrap rounded-full border border-border bg-bg px-3 text-xs font-medium text-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                            {item.proof}
                          </span>
                        )}
                      </div>
                      {item.icon && (
                        <span
                          class="shrink-0 text-accent opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 translate-y-1"
                          aria-hidden="true"
                        >
                          <Icon name={item.icon} size={24} />
                        </span>
                      )}
                    </div>
                  </>
                );

                return (
                  <li class="relative aspect-square bg-bg">
                    {item.href ? (
                      <a
                        href={item.href}
                        class="group flex h-full flex-col overflow-hidden p-6 transition-colors duration-300 hover:bg-border/30 xl:p-7"
                      >
                        {inner}
                      </a>
                    ) : (
                      <div class="group flex h-full flex-col overflow-hidden p-6 transition-colors duration-300 hover:bg-border/30 xl:p-7">
                        {inner}
                      </div>
                    )}
                    <LatticeDots seed={key === 'enterprise' ? 101 + i * 7 : 211 + i * 7} />
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 text-center">
      <a href={localizedPath('/#contacto', lang)} class="btn-primary hover:btn-primary-hover">
        {t.cta}
      </a>
    </div>
  </div>
</section>
