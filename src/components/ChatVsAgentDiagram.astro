---
/*
  Bot frente a agente de IA, en dos carriles.

  Existe porque la definición de agente es la parte de la guía donde más se
  confunde el lector, y la diferencia se ve antes dibujada que explicada.

  El dibujo se mantiene deliberadamente pobre. Es un diagrama de definición,
  así que enseña solo lo que separa a los dos, quién decide la respuesta, y
  no cuela nada de cómo construimos nosotros. La validación por código, las
  capas y los permisos son nuestra manera de hacerlo y viven en las páginas
  de servicio, no aquí.

  Usa el mismo kit que `FlowDiagram` (`./graficos`), así que los diagramas del
  sitio se ven como si salieran de la misma mano. Layout aquí, texto en
  `content[lang].chatVsAgent`, que es la regla de la casa.

  El lienzo mide 1100 × 250 y se escala para caber, así que las coordenadas
  de abajo son píxeles absolutos y sirven igual en los dos idiomas.
*/
import { type Lang, content } from '../i18n/ui';
import GrainFrame from './graficos/GrainFrame.astro';
import DiagramCanvas from './graficos/DiagramCanvas.astro';
import DiagramNode from './graficos/DiagramNode.astro';
import EdgeLabel from './graficos/EdgeLabel.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = content[lang].chatVsAgent;
const n = d.nodes;
---

<figure class="my-10">
  <GrainFrame height="520px" title={d.title}>
    <DiagramCanvas width={1100} height={250}>
      {/* Carril del bot: dos cajas y una sola vía. */}
      <path slot="edges" d="M368,58 L406,58" marker-end="url(#dg-arrow)" />

      {/* Carril del agente: el paso del medio es el que cambia todo. */}
      <path slot="edges" d="M298,188 L336,188" marker-end="url(#dg-arrow)" />
      <path slot="edges" d="M684,188 L722,188" marker-end="url(#dg-arrow)" />

      <EdgeLabel x={130} y={12}>{d.lanes.bot}</EdgeLabel>
      <DiagramNode x={62} y={35} w={300}>{n.botUsuario}</DiagramNode>
      <DiagramNode x={412} y={35} w={380}>{n.botRespuesta}</DiagramNode>

      <EdgeLabel x={130} y={142}>{d.lanes.agente}</EdgeLabel>
      <DiagramNode x={62} y={165} w={230}>{n.agenteUsuario}</DiagramNode>
      <DiagramNode x={342} y={165} w={336}>{n.agenteElige}</DiagramNode>
      <DiagramNode x={728} y={165} w={250}>{n.agenteResponde}</DiagramNode>
    </DiagramCanvas>
  </GrainFrame>

  <figcaption class="mt-6 border-l-2 border-accent pl-4 text-[15px] leading-relaxed text-fg">
    {d.legend}
  </figcaption>
</figure>
