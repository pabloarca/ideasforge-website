---
import { getCollection } from 'astro:content';
import { type Lang, content } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].blog;

const posts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const slugOf = (id: string) => id.replace(/^(es|en)\//, '');
---

<section class="bg-bg py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2 class="text-center text-5xl font-bold tracking-tight text-fg sm:text-6xl">
      {t.eyebrow}
    </h2>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        posts.map((post) => (
          <article class="card-soft rainbow-ring hover:card-soft-hover relative flex flex-col overflow-hidden">
            <div class="aspect-[16/10] w-full overflow-hidden bg-bg-soft">
              {post.data.heroImage ? (
                <img
                  src={post.data.heroImage}
                  alt={post.data.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div
                  class="h-full w-full"
                  style="background: linear-gradient(135deg, #e9e7ff, #c9c7ff);"
                />
              )}
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="line-clamp-3 text-lg font-bold leading-snug text-fg">
                <a href={localizedPath(`/blog/${slugOf(post.id)}`, lang)} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 line-clamp-3 text-[15px] leading-relaxed text-muted">
                {post.data.description}
              </p>
              {/* mt-auto pins the CTA to the bottom of every card regardless of
                  title/description height, so the row of buttons stays aligned. */}
              <div class="mt-auto pt-6">
                <span class="btn-ghost">{t.readMore}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-14 text-center">
      <a
        href={localizedPath('/blog', lang)}
        class="btn-primary hover:btn-primary-hover"
      >
        {t.viewAll}
      </a>
    </div>
  </div>
</section>
