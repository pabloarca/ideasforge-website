---
import { type Lang, content } from '../i18n/ui';
import { localizedPath, routeMap } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { medidas } from '../lib/imagen';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const t = content[lang];
const home = localizedPath('/', lang);

/*
  Cabecera del diseño de octubre de 2026: logotipo, cinco enlaces de texto, el
  cambio de idioma y el CTA. Sin iconos y sin píldoras: el estado se dice con
  el color.

  Cuatro de los cinco enlaces son anclas de la portada (soluciones, sectores
  y recursos, este último dos veces), así que desde una página interior llevan a la
  portada y bajan a su sección. «Casos» lleva a su propia página, el índice
  de casos.

  «Método» y «Blog» salieron de aquí el 7 oct 2026 por decisión del
  propietario. El método sigue siendo un bloque de la portada y el blog pasó
  al desplegable de «Recursos», añadido ese mismo día.

  «Recursos» lleva tres páginas que aún no existen (centro de ayuda, seguridad
  y sobre nosotros). Llegan sin `href` desde ui.ts y se pintan apagadas y sin
  enlace hasta que se creen.

  «Sectores» entró el 7 oct 2026 con los tres verticales que tenían página
  (pymes, inmobiliarias y gestorías) y cinco más cuyas páginas están vacías. Sus enlaces salen de `nav.sectorLinks`, la misma
  lista que pinta la columna del pie.

  Cuatro de ellos llevan además su desplegable, que el diseño no dibuja y que
  aquí se mantiene a propósito: «Soluciones» y «Guías» son la única entrada
  directa desde la cabecera a las ocho páginas que más cuentan del sitio. Los
  grupos salen de `t.footer.navGroups`, la misma lista que pinta el pie, y el
  marcado `soloPie` (los verticales) sigue sin subir aquí.
*/
type Enlace = { label: string; href?: string };
type Entrada = { label: string; href: string; links?: Enlace[] };

const grupos = t.footer.navGroups.filter((g) => !g.soloPie);

const entradas: Entrada[] = [
  { label: t.nav.solutions, href: localizedPath('/#soluciones', lang), links: grupos[0]?.links },
  { label: t.nav.sectors, href: localizedPath('/#sectores', lang), links: t.nav.sectorLinks },
  { label: t.nav.cases, href: routeMap.cases[lang] ?? localizedPath('/#casos', lang) },
  { label: t.nav.guides, href: localizedPath('/#recursos', lang), links: grupos[1]?.links },
  { label: t.nav.resources, href: localizedPath('/#recursos', lang), links: t.nav.resourceLinks },
];
const contacto = routeMap.contact[lang] ?? localizedPath('/#contacto', lang);
---

<header class="site-nav sticky top-0 z-40 border-b-2 border-border">
  <div class="wrap flex h-[72px] items-center gap-[clamp(16px,2.5vw,36px)]">
    <a href={home} class="mr-auto block shrink-0" aria-label="Ideasforge">
      <img
        src="/ideasforge-logo.svg"
        alt="Ideasforge"
        {...medidas('/ideasforge-logo.svg')}
        class="h-5 w-auto"
      />
    </a>

    <nav class="hidden items-center gap-[clamp(16px,2.5vw,36px)] lg:flex" aria-label={t.nav.menu}>
      {
        entradas.map((e) =>
          e.links ? (
            <div class="group" data-menu-grupo>
              <a
                href={e.href}
                class="nav-link flex h-[72px] items-center"
                aria-haspopup="true"
                aria-expanded="false"
                data-menu-raiz
              >
                {e.label}
              </a>
              {/* El panel cuelga de la regla de la cabecera: se ancla a la
                  barra, no al enlace, y su borde superior cae justo encima de
                  esa regla. Por eso el grupo no es `relative` y el enlace
                  ocupa toda la altura de la barra: entre el enlace y el panel
                  no queda ningún hueco donde el ratón pierda el menú. */}
              <div class="invisible absolute top-full z-50 opacity-0 transition-opacity duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <div class="panel-float -ml-[22px] w-72 py-2">
                  {e.links.map((s) =>
                    s.href ? (
                      <a href={s.href} class="block px-5 py-2.5 text-sm transition-colors hover:text-accent">
                        {s.label}
                      </a>
                    ) : (
                      <span class="block px-5 py-2.5 text-sm text-faint">{s.label}</span>
                    )
                  )}
                </div>
              </div>
            </div>
          ) : (
            <a href={e.href} class="nav-link">
              {e.label}
            </a>
          )
        )
      }
    </nav>

    <LanguageSwitcher lang={lang} alternates={alternates} />

    <a href={contacto} class="btn-primary hover:btn-primary-hover hidden py-2! sm:inline-flex">
      {t.nav.cta}
    </a>

    <!-- Móvil y tableta: los enlaces bajan a un panel a todo el ancho. El
         idioma se queda en la barra porque cambiarlo es una acción global, no
         el último renglón de una lista. -->
    <details class="nav-movil lg:hidden">
      <summary
        class="grid h-11 w-11 cursor-pointer list-none place-items-center border-2 border-border [&::-webkit-details-marker]:hidden"
        aria-label={t.nav.menu}
      >
        <span class="nav-barras" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <div
        class="absolute inset-x-0 top-full max-h-[calc(100dvh-74px)] overflow-y-auto border-b-2 border-border bg-bg"
      >
        <div class="wrap py-6">
          <ul class="border-t-2 border-border">
            {
              entradas.map((e) => (
                <li class="border-b-2 border-border">
                  <a href={e.href} class="block py-4 text-[22px] leading-tight tracking-[-0.02em] hover:text-accent">
                    {e.label}
                  </a>
                  {e.links && (
                    <ul class="pb-4">
                      {e.links.map((s) => (
                        <li>
                          {s.href ? (
                            <a href={s.href} class="block py-1.5 text-sm text-muted hover:text-accent">
                              {s.label}
                            </a>
                          ) : (
                            <span class="block py-1.5 text-sm text-faint">{s.label}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
          <a href={contacto} class="btn-primary hover:btn-primary-hover mt-6 sm:hidden">
            {t.nav.cta}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  /* Fondo al 88 % con desenfoque: el contenido se adivina al pasar por debajo
     sin restarle lectura a la barra. */
  .site-nav {
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav-link {
    font-size: 14px;
    transition: color 200ms;
  }
  .nav-link:hover,
  .nav-link[aria-expanded='true'] {
    color: var(--color-accent);
  }

  /* Hamburguesa de dos barras que se cruzan al abrir. Son dos trazos de 2 px,
     el mismo grosor que todas las reglas del sitio. */
  .nav-barras {
    position: relative;
    display: block;
    width: 18px;
    height: 10px;
  }
  .nav-barras i {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    transition:
      transform 250ms var(--ease-in-out),
      top 250ms var(--ease-in-out);
  }
  .nav-barras i:first-child {
    top: 0;
  }
  .nav-barras i:last-child {
    top: 8px;
  }
  .nav-movil[open] .nav-barras i:first-child {
    top: 4px;
    transform: rotate(45deg);
  }
  .nav-movil[open] .nav-barras i:last-child {
    top: 4px;
    transform: rotate(-45deg);
  }
</style>

<script is:inline>
  /*
    El desplegable lo abre el CSS, con `group-hover` y `group-focus-within`.
    Funciona con ratón y con teclado. Este script solo CUENTA lo que ya pasa:
    sincroniza `aria-expanded` para que un lector de pantalla sepa en qué
    estado está el menú. Si no llega a ejecutarse, el menú se abre igual.

    Y cierra el panel móvil al pulsar un enlace: casi todos son anclas de la
    propia portada, y sin esto el panel seguiría abierto tapando la sección a
    la que se acaba de saltar.
  */
  document.querySelectorAll('[data-menu-grupo]').forEach(function (grupo) {
    var raiz = grupo.querySelector('[data-menu-raiz]');
    if (!raiz) return;
    var marca = function (abierto) {
      raiz.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    };
    grupo.addEventListener('mouseenter', function () { marca(true); });
    grupo.addEventListener('mouseleave', function () { marca(false); });
    grupo.addEventListener('focusin', function () { marca(true); });
    grupo.addEventListener('focusout', function (ev) {
      if (!grupo.contains(ev.relatedTarget)) marca(false);
    });
  });
  document.querySelectorAll('.nav-movil').forEach(function (panel) {
    panel.addEventListener('click', function (ev) {
      if (ev.target.closest('a')) panel.removeAttribute('open');
    });
  });
</script>
