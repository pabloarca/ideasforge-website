---
import { type Lang, content } from '../i18n/ui';
import { localizedPath, routeMap } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const t = content[lang];
const home = localizedPath('/', lang);

const links = [
  { label: t.nav.services, href: localizedPath('/#servicios', lang), icon: 'grid' },
  { label: t.nav.projects, href: localizedPath('/#proyectos', lang), icon: 'briefcase' },
  { label: t.nav.about, href: routeMap.about[lang]!, icon: 'spark' },
  { label: t.nav.blog, href: localizedPath('/blog', lang), icon: 'file' },
  { label: t.nav.contact, href: localizedPath('/#contacto', lang), icon: 'user' },
];

// Service/keyword pages, same list the footer renders. Shown as a dropdown
// under "Servicios" on desktop and as a sub-list in the mobile menu.
const serviceLinks = t.footer.servicesLinks;
---

<header class="sticky top-0 z-40 border-b border-border-soft bg-bg/95 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8">
    <!-- Logo: real wordmark SVG from the original site -->
    <a href={home} class="flex items-center text-fg" aria-label="Ideasforge">
      <img src="/ideasforge-logo.svg" alt="Ideasforge" class="h-7 w-auto sm:h-8" />
    </a>

    <!-- Desktop nav (centered), hover paints a soft gray pill, text stays black -->
    <nav class="hidden flex-1 items-center justify-center gap-1 md:flex" aria-label="Principal">
      {
        links.map((l) => (
          <div class={l.icon === 'grid' ? 'group relative' : 'contents'}>
          <a
            href={l.href}
            class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-[15px] font-medium text-fg transition-colors hover:bg-bg-soft"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {l.icon === 'grid' && (
                <path fill-rule="evenodd" d="M3 6a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3V6ZM3 15.75a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-2.25Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3v-2.25Z" clip-rule="evenodd" />
              )}
              {l.icon === 'briefcase' && (
                <path d="M5.566 4.657A4.505 4.505 0 0 1 6.75 4.5h10.5c.41 0 .806.055 1.183.157A3 3 0 0 0 15.75 3h-7.5a3 3 0 0 0-2.684 1.657ZM2.25 12a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3v-6ZM5.25 7.5c-.41 0-.806.055-1.184.157A3 3 0 0 1 6.75 6h10.5a3 3 0 0 1 2.683 1.657A4.505 4.505 0 0 0 18.75 7.5H5.25Z" />
              )}
              {l.icon === 'file' && (
                <>
                  <path fill-rule="evenodd" d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625Z" clip-rule="evenodd" />
                  <path d="M12.971 1.816A5.23 5.23 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 0 1 3.434 1.279 9.768 9.768 0 0 0-6.963-6.963Z" />
                </>
              )}
              {l.icon === 'spark' && (
                <path fill-rule="evenodd" d="M9 4.5a.75.75 0 0 1 .721.544l.813 2.846a3.75 3.75 0 0 0 2.576 2.576l2.846.813a.75.75 0 0 1 0 1.442l-2.846.813a3.75 3.75 0 0 0-2.576 2.576l-.813 2.846a.75.75 0 0 1-1.442 0l-.813-2.846a3.75 3.75 0 0 0-2.576-2.576l-2.846-.813a.75.75 0 0 1 0-1.442l2.846-.813A3.75 3.75 0 0 0 7.466 7.89l.813-2.846A.75.75 0 0 1 9 4.5ZM18 1.5a.75.75 0 0 1 .728.568l.258 1.036c.236.94.97 1.674 1.91 1.91l1.036.258a.75.75 0 0 1 0 1.456l-1.036.258c-.94.236-1.674.97-1.91 1.91l-.258 1.036a.75.75 0 0 1-1.456 0l-.258-1.036a2.625 2.625 0 0 0-1.91-1.91l-1.036-.258a.75.75 0 0 1 0-1.456l1.036-.258a2.625 2.625 0 0 0 1.91-1.91l.258-1.036A.75.75 0 0 1 18 1.5Z" clip-rule="evenodd" />
              )}
              {l.icon === 'user' && (
                <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
              )}
            </svg>
            <span>{l.label}</span>
            {l.icon === 'grid' && (
              <svg
                class="h-3.5 w-3.5 text-muted transition-transform duration-200 group-hover:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            )}
          </a>
          {l.icon === 'grid' && (
            <div class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="card-soft w-72 p-2">
                {serviceLinks.map((s) => (
                  <a
                    href={s.href}
                    class="block rounded-md px-3 py-2.5 text-sm font-medium text-fg transition-colors hover:bg-bg-soft hover:text-accent"
                  >
                    {s.label}
                  </a>
                ))}
              </div>
            </div>
          )}
          </div>
        ))
      }
    </nav>

    <div class="hidden items-center md:flex">
      <LanguageSwitcher lang={lang} alternates={alternates} />
    </div>

    <!-- Mobile menu -->
    <details class="group relative md:hidden">
      <summary
        class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-md border border-border-soft text-fg [&::-webkit-details-marker]:hidden"
        aria-label="Menú"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </summary>
      <div class="card-soft absolute right-0 mt-2 max-h-[calc(100vh-6rem)] w-72 overflow-y-auto p-2">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="block rounded-md px-3 py-2.5 text-sm font-medium text-fg transition-colors hover:bg-bg-soft hover:text-accent"
            >
              {l.label}
            </a>
          ))
        }
        <p class="mt-2 border-t border-border-soft px-3 pb-1 pt-3 text-xs font-semibold uppercase tracking-[0.12em] text-faint">
          {t.footer.servicesHeading}
        </p>
        {
          serviceLinks.map((s) => (
            <a
              href={s.href}
              class="block rounded-md px-3 py-2 text-sm text-fg transition-colors hover:bg-bg-soft hover:text-accent"
            >
              {s.label}
            </a>
          ))
        }
        <div class="mt-2 flex items-center justify-end border-t border-border-soft px-1 pt-3">
          <LanguageSwitcher lang={lang} alternates={alternates} />
        </div>
      </div>
    </details>
  </div>
</header>
