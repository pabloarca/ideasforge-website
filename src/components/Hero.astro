---
import { type Lang, content } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;
---

<section class="bg-bg">
  <div class="mx-auto max-w-7xl px-5 pb-10 pt-16 sm:px-8 sm:pt-20">
    <!-- Stacked, centered intro -->
    <div class="mx-auto max-w-4xl text-center">
      {/* El badge de marca, en el lenguaje de retícula del sitio: un marco
          recto con los puntos de 3px en las esquinas (los mismos cuadrados en
          acento de LatticeDots), en vez de la píldora redondeada.

          Entra en tres tiempos: primero se dibujan las líneas verticales,
          luego las horizontales con los puntos, y por último el texto se
          revela como escrito a máquina. La mecanografía es CSS puro, un
          clip-path que avanza por pasos, y el número de pasos es la longitud
          real del texto en cada idioma, así que cada golpe descubre
          aproximadamente una letra. Sin JavaScript: si algo falla, lo único
          que puede pasar es que se vea entero desde el principio, y con
          movimiento reducido se ve entero directamente. */}
      <span class="hero-badge relative inline-block whitespace-nowrap px-5 py-2.5 text-[0.95rem] font-medium text-accent">
        <span class="hb-line hb-v left-0" aria-hidden="true"></span>
        <span class="hb-line hb-v right-0" aria-hidden="true"></span>
        <span class="hb-line hb-h top-0" aria-hidden="true"></span>
        <span class="hb-line hb-h bottom-0" aria-hidden="true"></span>
        <span class="hb-dot left-0 top-0 -translate-x-1/2 -translate-y-1/2" aria-hidden="true"></span>
        <span class="hb-dot right-0 top-0 translate-x-1/2 -translate-y-1/2" aria-hidden="true"></span>
        <span class="hb-dot bottom-0 left-0 -translate-x-1/2 translate-y-1/2" aria-hidden="true"></span>
        <span class="hb-dot bottom-0 right-0 translate-x-1/2 translate-y-1/2" aria-hidden="true"></span>
        <span
          class="hb-text inline-block"
          style={`animation-timing-function: steps(${t.eyebrow.length}, end)`}
        >
          {t.eyebrow}
        </span>
      </span>
      <h1
        class="mt-7 text-balance text-4xl font-bold leading-[1.05] tracking-tight text-fg sm:text-6xl lg:text-[4.25rem]"
      >
        {t.title}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-pretty text-lg leading-relaxed text-muted sm:text-xl">
        {t.subtitle}
      </p>
      <div class="mt-9 flex justify-center">
        <a
          href={localizedPath('/#contacto', lang)}
          class="btn-primary hover:btn-primary-hover"
        >
          {t.ctaPrimary}
        </a>
      </div>

    </div>

    <!-- Full-width video card below -->
    <div class="mt-14 sm:mt-20">
      <div
        class="mx-auto aspect-[16/9] max-w-6xl overflow-hidden border border-border-soft bg-surface"
      >
        <video
          class="h-full w-full object-cover"
          src="/videos/genaisolutions.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Secuencia del badge. Tres tiempos encadenados por retardos:

      120-380 ms   las dos lineas verticales crecen desde el centro
      420-680 ms   las dos horizontales, y los puntos de las esquinas al final
      750-1650 ms  el texto se descubre por pasos, un golpe por letra

    Las lineas se animan con transform (scale), no con width/height: el
    navegador las compone sin recalcular el layout, y el marco ya ocupa su
    sitio desde el primer fotograma, asi que nada se desplaza alrededor.

    El texto usa clip-path por pasos. El ultimo paso se pasa un 2% de largo a
    proposito: con fuente proporcional el borde del recorte no cae exacto en
    la ultima letra, y sin ese margen la ese final aparecia cortada.
  */
  .hb-line {
    position: absolute;
    background: var(--color-border);
  }
  .hb-v {
    top: 0;
    bottom: 0;
    width: 1px;
    transform: scaleY(0);
    animation: hb-grow-v 260ms ease-out 120ms forwards;
  }
  .hb-h {
    left: 0;
    right: 0;
    height: 1px;
    transform: scaleX(0);
    animation: hb-grow-h 260ms ease-out 420ms forwards;
  }
  .hb-dot {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--color-accent);
    opacity: 0;
    animation: hb-appear 180ms ease-out 640ms forwards;
  }
  .hb-text {
    clip-path: inset(0 100% 0 0);
    /* La funcion de tiempo llega en linea desde el marcado: steps(N), con N
       la longitud del texto de cada idioma. */
    animation: hb-type 900ms 750ms forwards;
  }

  @keyframes hb-grow-v {
    to {
      transform: scaleY(1);
    }
  }
  @keyframes hb-grow-h {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes hb-appear {
    to {
      opacity: 1;
    }
  }
  @keyframes hb-type {
    to {
      clip-path: inset(0 -2% 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hb-v,
    .hb-h {
      transform: none;
      animation: none;
    }
    .hb-dot {
      opacity: 1;
      animation: none;
    }
    .hb-text {
      clip-path: none;
      animation: none;
    }
  }
</style>
