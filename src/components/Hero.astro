---
import BrandBadge from './BrandBadge.astro';
import { type Lang, content } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;
---

<section class="bg-bg">
  <div class="mx-auto max-w-7xl px-5 pb-10 pt-16 sm:px-8 sm:pt-20">
    <!-- Stacked, centered intro -->
    <div class="mx-auto max-w-4xl text-center">
      <BrandBadge text={t.eyebrow} />
      <h1
        class="mt-7 text-balance text-4xl font-bold leading-[1.05] tracking-tight text-fg sm:text-6xl lg:text-[4.25rem]"
      >
        {t.title}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-pretty text-lg leading-relaxed text-muted sm:text-xl">
        {t.subtitle}
      </p>
      <div class="mt-9 flex justify-center">
        <a
          href={localizedPath('/#contacto', lang)}
          class="btn-primary hover:btn-primary-hover"
        >
          {t.ctaPrimary}
        </a>
      </div>

    </div>

    <!-- Full-width video card below -->
    <div class="mt-14 sm:mt-20">
      <div
        class="mx-auto aspect-[16/9] max-w-6xl overflow-hidden border border-border-soft bg-surface"
      >
        {/*
          `poster` es lo que arregla el LCP. Sin el, la caja se queda vacia
          hasta que llegan los primeros fotogramas, y el hueco cae justo en la
          zona que mide Google. Con el, la portada pinta la imagen a los 27 KB
          y el video la sustituye cuando llega, sin salto porque tienen el
          mismo encuadre.

          Ojo si algun dia se cambia el video: el fuente es 1600x576, una tira
          de 25:9, y esta caja es 16:9, asi que `object-cover` recorta los
          lados y solo se ve la franja central de 1024x576. El poster tiene que
          salir del mismo fotograma y a la misma medida, o el relevo se nota.

          Comprimido el 31 ago 2026 de 3.450 KB a 530 KB (H.264 CRF 30). El
          maestro original vive en el historial de git.
        */}
        <video
          class="h-full w-full object-cover"
          src="/videos/genaisolutions.mp4"
          poster="/videos/hero-poster.webp"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      </div>
    </div>
  </div>
</section>
