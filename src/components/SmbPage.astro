---
/*
  Página de paquetes para pymes y su espejo inglés. El marcado estaba copiado
  en los dos archivos; aquí vive una sola vez.

  Los paquetes van en retícula continua, como las tarjetas de servicio de la
  home: celdas que comparten línea, sin sombras ni radios. Antes eran tarjetas
  sueltas con la sombra lavanda antigua.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import ClusterPosts from './ClusterPosts.astro';
import { type Lang, type SmbPageContent } from '../i18n/ui';
import { pillarFromUrl } from '../lib/cluster';
import { altsFor, localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: SmbPageContent;
  title: string;
  description: string;
}
const { lang, page: p, title, description } = Astro.props;
---

<BaseLayout lang={lang} title={title} description={description} alternates={altsFor('smb')}>
  <section class="bg-bg py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
      {p.hero.eyebrow && <span class="eyebrow-pill">{p.hero.eyebrow}</span>}
      <h1 class="mt-7 text-balance text-4xl font-bold leading-[1.05] tracking-tight text-fg sm:text-5xl lg:text-6xl">
        {p.hero.title}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-pretty text-lg leading-relaxed text-muted sm:text-xl">
        {p.hero.subtitle}
      </p>
      <div class="mt-9">
        <a href={localizedPath('/#contacto', lang)} class="btn-primary hover:btn-primary-hover">
          {p.hero.cta}
        </a>
      </div>
    </div>
  </section>

  <!-- Packages grid -->
  <section class="bg-bg-soft py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <header class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{p.packages.heading}</h2>
        <p class="mt-4 text-lg text-muted">{p.packages.subtitle}</p>
      </header>
      <ul class="mt-12 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
        {
          p.packages.items.map((pkg) => (
            <li class="flex h-full flex-col bg-bg p-7">
              <h3 class="text-lg font-bold leading-snug text-fg">{pkg.title}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">{pkg.description}</p>
              {pkg.proof && (
                <div class="mt-auto pt-6">
                  <span class="inline-flex items-center rounded-full border border-border bg-bg px-3 py-1 text-xs font-medium text-accent">
                    {pkg.proof}
                  </span>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Entradas del blog de este grupo. Se derivan de los enlaces que los
      propios posts declaran, asi que publicar una entrada nueva la
      incorpora sola. Si el grupo no tiene ninguna, no pinta nada. */}
  <ClusterPosts lang={lang} pillar={pillarFromUrl(Astro.url.pathname)} />

  <section class="bg-bg py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{p.cta.heading}</h2>
      <p class="mt-4 text-lg text-muted">{p.cta.body}</p>
      <div class="mt-7">
        <a href={localizedPath('/#contacto', lang)} class="btn-primary hover:btn-primary-hover">
          {p.cta.button}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
