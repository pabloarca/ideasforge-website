---
/*
  Plantilla de las siete páginas de sector, del paquete de diseño del 8 oct
  2026 (`.private/paginas-sectores-2/`). Cada página le pasa su clave y aquí
  se lee su contenido de `pages.sectors` en ui.ts: un héroe y una fila de
  bloques, que se dibujan en orden según su `type`.

  Cabecera y migas de pan NO son de este diseño: son las del sitio. Por eso
  el héroe no repite la miga que dibuja el prototipo.

  Tres cosas no se escriben aquí porque ya existen:
    - la FAQ es `FaqList`, la pieza de todas las FAQ del sitio, con su
      `FAQPage` estructurado y cada pregunta como h3;
    - el contacto es el `ContactForm` de la portada, con el titular, el
      párrafo y el botón de cada sector, y con envío de verdad;
    - la aparición al hacer scroll es `data-reveal`, que observa el layout.

  Tres diferencias con el prototipo, las tres a propósito:
    - Los titulares de sección van un escalón por debajo del h1, con la misma
      escala que las páginas de solución. Con los tamaños del prototipo se
      confundían con él, y eso ya se corrigió allí a petición del propietario.
    - Las retículas no son de columnas fijas a cualquier ancho: son de una
      columna en un teléfono, de dos en una tableta y de las suyas en
      escritorio. En las tres, la última celda ocupa lo que falte para cerrar
      la fila, así que nunca queda un hueco gris.
    - El prototipo no dibuja tres piezas que el texto sí trae, y aquí se
      dibujan: la secuencia numerada (`steps`), la segunda lista de una
      retícula y las preguntas de ejemplo que pasan de la primera.

  Los usos son la única pieza con JavaScript. Sin él se ven todos, uno
  debajo de otro. Con él queda uno a la vista, que cambia al pasar por la
  lista y avanza solo, con el mismo carrusel de la portada.
*/
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from './FaqList.astro';
import ContactForm from './home/ContactForm.astro';
import SectorHeroArt from './SectorHeroArt.astro';
import { type Lang, type SectorKey, content } from '../i18n/ui';
import { altsFor, routeMap } from '../i18n/utils';
import { foto } from '../lib/fotos';

interface Props {
  lang: Lang;
  clave: SectorKey;
}
const { lang, clave } = Astro.props;
const sec = content[lang].pages.sectors;
if (!sec) throw new Error(`No hay páginas de sector en «${lang}».`);
const d = sec.pages[clave];
if (!d) throw new Error(`El sector «${clave}» no tiene página en «${lang}».`);
const l = sec.labels;

const contacto = routeMap.contact[lang];
const dos = (i: number) => String(i + 1).padStart(2, '0');

/* La foto de cada caso sale de su ficha en la portada, buscada por el enlace:
   una sola fuente, así que un caso que cambia de foto cambia en todas partes
   (15 oct 2026). Un caso que no esté en la portada sale sin foto. */
const fotoDeCaso = (href: string) => content[lang].home.cases.items.find((k) => k.href === href)?.image;
/* Solo los que ya existen en este idioma: el inglés los estrena de uno en uno. */
const otros = sec.order
  .filter((k) => k !== clave && sec.pages[k])
  .map((k) => ({ ...sec.pages[k]!, href: routeMap[k][lang] }));

/* Columnas de una retícula de N celdas: las que dividan N entre 4, 3 y 5, y
   si ninguna lo divide, la última celda ocupa lo que falte. */
const reticula = (n: number, fijas?: number) => {
  const cols = fijas ?? (n <= 3 ? Math.max(n, 1) : ([4, 3, 5].find((k) => n % k === 0) ?? (n % 4 >= n % 3 ? 4 : 3)));
  const resto = n % cols;
  return { style: `--cols:${cols};--span:${resto ? cols - resto + 1 : 1}`, impar: n % 2 === 1 };
};
---

<BaseLayout lang={lang} title={d.metaTitle} description={d.metaDescription} alternates={altsFor(clave)}>
  <div class="wrap">
    <!-- Héroe -->
    <section class="sec-hero">
      <div>
        <h1 class="t-display sec-in max-w-[20ch]" style="--d:.08s">{d.h1}</h1>
        <p class="sec-in mt-6 max-w-[58ch] text-[17px] leading-[1.55] text-muted" style="--d:.16s">{d.lead}</p>
        <p
          class="sec-in mt-6 max-w-[36ch] text-[clamp(18px,1.5vw,21px)] font-medium leading-[1.35] tracking-[-0.012em]"
          style="--d:.2s"
        >
          {d.statement[0]}
          <span class="text-accent">{d.statement[1]}</span>
        </p>
        <div class="sec-in mt-9 flex flex-wrap items-center gap-5" style="--d:.24s">
          <a href={contacto} class="btn-primary hover:btn-primary-hover">{d.cta}</a>
          <a href="#usos" class="link-quiet">{d.heroLink ?? l.whatAI}</a>
        </div>
      </div>
      <div class="sec-in sec-arte-caja" style="--d:.2s" aria-hidden="true">
        <SectorHeroArt clave={clave} />
      </div>
    </section>

    {
      d.blocks.map((b) => {
        /* Panorama: cabecera cerrada por regla negra y pastillas. */
        if (b.type === 'landscape') {
          return (
            <section class="section-y">
              <div class="sec-cab-cerrada" data-reveal>
                <h2 class="sec-h2 max-w-[18ch]">{b.h2}</h2>
                <div class="space-y-3.5">
                  {b.after?.map((p) => (
                    <p class="max-w-[50ch] text-base leading-[1.65] text-muted">{p}</p>
                  ))}
                  {b.emph?.map((p) => (
                    <p class="max-w-[50ch] text-base font-medium leading-[1.65]">{p}</p>
                  ))}
                </div>
              </div>
              <div class="flex items-baseline justify-between gap-x-8 gap-y-4 pt-6">
                <span class="kicker">{b.label}</span>
                <span class="num shrink-0">{l.sources.replace('{n}', String(b.list?.length ?? 0))}</span>
              </div>
              <ul class="mt-5 flex flex-wrap gap-2.5">
                {b.list?.map((t) => (
                  <li class="sec-pastilla">
                    <span class="sec-pastilla-sq" aria-hidden="true" />
                    {t}
                  </li>
                ))}
              </ul>
            </section>
          );
        }

        /* Usos: la lista a la izquierda y el uso activo a la derecha. */
        if (b.type === 'uses') {
          return (
            <section id="usos" class="section-y">
              <div class="section-head" data-reveal>
                <h2 class="sec-h2">{b.h2}</h2>
                <p class="max-w-[44ch] text-base leading-[1.6] text-muted">{b.lead}</p>
              </div>
              <div class="sec-usos" data-usos>
                <div class="sec-usos-lista border-t-2 border-border">
                  {b.subs.map((u, i) => (
                    <button type="button" class:list={['sec-uso', i === 0 && 'is-active']} data-uso>
                      <span class="num pt-1.5">{dos(i)}</span>
                      <span class="block text-[clamp(20px,2vw,28px)] font-medium leading-[1.15] tracking-[-0.02em]">{u.t}</span>
                    </button>
                  ))}
                </div>
                <div class="sec-usos-panel">
                  {b.subs.map((u, i) => (
                    <div class:list={['sec-ficha', i === 0 && 'is-active']} data-uso-ficha>
                      <span class="num">{`${dos(i)} / ${dos(b.subs.length - 1)}`}</span>
                      <h3 class="sec-ficha-titulo">{u.t}</h3>
                      {u.d && <p class="mt-6 max-w-[48ch] text-base leading-[1.6] text-muted">{u.d}</p>}
                      {u.q && <p class="sec-cita mt-6 text-[clamp(18px,1.6vw,22px)]">{u.q}</p>}
                      {u.items && (
                        <div class="mt-auto pt-7">
                          {u.label && <span class="kicker mb-3.5">{u.label}</span>}
                          <ul class="flex flex-wrap gap-2">
                            {u.items.map((t) => (
                              <li class="sec-chip">{t}</li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );
        }

        /* Póster: campo azul a sangre. Su rótulo es `h2` y su titular, la
           primera pregunta de ejemplo. */
        if (b.type === 'poster') {
          return (
            <section class="sec-sangre sec-poster">
              <div class="sec-sangre-dentro grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] items-center gap-[clamp(32px,5vw,96px)]">
                <div>
                  <span class="mb-5 block text-xs uppercase leading-[1.4] tracking-[0.12em]">{b.h2}</span>
                  <h2 class="sec-h2-poster max-w-[18ch]">{lang === 'en' ? `“${b.quotes?.[0] ?? ''}”` : `«${b.quotes?.[0] ?? ''}»`}</h2>
                </div>
                <div>
                  <div class="space-y-4">
                    {b.paras?.map((p) => (
                      <p class="max-w-[48ch] text-base leading-[1.6]">{p}</p>
                    ))}
                  </div>
                  {b.quotes?.slice(1).map((q) => (
                    <p class="sec-cita sec-cita-clara mt-5 max-w-[44ch] text-[clamp(17px,1.5vw,20px)]">{q}</p>
                  ))}
                  {b.steps && (
                    <ol class="sec-lista sec-lista-clara mt-6 max-w-[48ch]">
                      {b.steps.map((t, i) => (
                        <li>
                          <span aria-hidden="true">{dos(i)}</span>
                          {t}
                        </li>
                      ))}
                    </ol>
                  )}
                  {b.after && (
                    <div class="mt-5 space-y-4">
                      {b.after.map((p) => (
                        <p class="max-w-[48ch] text-base leading-[1.6]">{p}</p>
                      ))}
                    </div>
                  )}
                  {b.list && (
                    <>
                      {b.label && <p class="mb-3.5 mt-6 text-[13px] opacity-80">{b.label}</p>}
                      <ul class="flex flex-wrap gap-2">
                        {b.list.map((t) => (
                          <li class="sec-chip sec-chip-clara">{t}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  {b.emph?.map((p) => (
                    <p class="mt-5 text-base font-medium leading-normal">{p}</p>
                  ))}
                  {b.link && (
                    <a href={b.link.href} class="sec-enlace-claro mt-6">
                      {b.link.label} →
                    </a>
                  )}
                </div>
              </div>
            </section>
          );
        }

        /* Split: texto a la izquierda y lista numerada a la derecha. */
        if (b.type === 'split') {
          return (
            <section class="sec-dos section-y">
              <div data-reveal>
                <h2 class="sec-h2-compacto">{b.h2}</h2>
                {b.paras?.map((p) => (
                  <p class="mt-5 max-w-[52ch] text-base leading-[1.65] text-muted">{p}</p>
                ))}
                {b.steps && (
                  <ol class="sec-lista mt-6 max-w-[52ch]">
                    {b.steps.map((t, i) => (
                      <li>
                        <span aria-hidden="true">{dos(i)}</span>
                        {t}
                      </li>
                    ))}
                  </ol>
                )}
                {b.after?.map((p) => (
                  <p class="mt-5 max-w-[52ch] text-base leading-[1.65] text-muted">{p}</p>
                ))}
                {b.quotes?.map((q) => (
                  <p class="sec-cita mt-5 max-w-[44ch] text-[clamp(17px,1.5vw,20px)]">{q}</p>
                ))}
                {b.emph?.map((p) => (
                  <p class="mt-5 max-w-[52ch] text-base font-medium leading-[1.55]">{p}</p>
                ))}
                {b.link && (
                  <a href={b.link.href} class="link-arrow mt-6">
                    {b.link.label} →
                  </a>
                )}
              </div>
              <div>
                {b.label && <p class="mb-4 text-[13px] text-muted">{b.label}</p>}
                <ol class="sec-lista">
                  {b.list?.map((t, i) => (
                    <li>
                      <span aria-hidden="true">{dos(i)}</span>
                      {t}
                    </li>
                  ))}
                </ol>
                {b.list2 && (
                  <>
                    <p class="mb-4 mt-7 text-[13px] text-muted">{b.label2}</p>
                    <ul class="flex flex-wrap gap-2">
                      {b.list2.map((t) => (
                        <li class="sec-chip">{t}</li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </section>
          );
        }

        /* Solo texto: el bloque que llega sin lista. */
        if (b.type === 'text') {
          return (
            <section class="sec-dos section-y">
              <h2 class="sec-h2-compacto" data-reveal>
                {b.h2}
              </h2>
              <div>
                <div class="space-y-4">
                  {b.paras?.map((p) => (
                    <p class="max-w-[52ch] text-base leading-[1.65] text-muted">{p}</p>
                  ))}
                </div>
                {b.quotes?.map((q) => (
                  <p class="sec-cita mt-5 max-w-[44ch] text-[clamp(17px,1.5vw,20px)]">{q}</p>
                ))}
                {b.after?.map((p) => (
                  <p class="mt-5 max-w-[52ch] text-base leading-[1.65] text-muted">{p}</p>
                ))}
                {b.emph?.map((p) => (
                  <p class="mt-5 max-w-[52ch] text-base font-medium leading-[1.55]">{p}</p>
                ))}
                {b.link && (
                  <a href={b.link.href} class="link-arrow mt-6">
                    {b.link.label} →
                  </a>
                )}
              </div>
            </section>
          );
        }

        /* Celdas: retícula de elementos paralelos. */
        if (b.type === 'cells') {
          const r = reticula(b.list?.length ?? 0);
          return (
            <section class="section-y">
              <div class="section-head mb-[clamp(32px,4vw,48px)]!" data-reveal>
                <h2 class="sec-h2">{b.h2}</h2>
                <div class="space-y-3">
                  {b.paras?.map((p) => (
                    <p class="max-w-[46ch] text-base leading-[1.6] text-muted">{p}</p>
                  ))}
                </div>
              </div>
              {b.label && <p class="kicker mb-4">{b.label}</p>}
              <ul class:list={['sec-grid sec-grid-regla', r.impar && 'impar']} style={r.style}>
                {b.list?.map((t) => (
                  <li class="sec-celda">
                    <span class="sq" aria-hidden="true" />
                    <span class="text-base font-medium leading-[1.35]">{t}</span>
                  </li>
                ))}
              </ul>
              {b.list2 && (
                <div class="mt-7">
                  <p class="mb-4 text-[13px] text-muted">{b.label2}</p>
                  <ul class="flex flex-wrap gap-2">
                    {b.list2.map((t) => (
                      <li class="sec-chip">{t}</li>
                    ))}
                  </ul>
                </div>
              )}
              <div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] gap-x-[clamp(32px,5vw,96px)] gap-y-4">
                <div class="space-y-2.5">
                  {b.steps && (
                    <ol class="sec-lista max-w-[56ch]">
                      {b.steps.map((t, i) => (
                        <li>
                          <span aria-hidden="true">{dos(i)}</span>
                          {t}
                        </li>
                      ))}
                    </ol>
                  )}
                  {b.after?.map((p) => (
                    <p class="max-w-[56ch] text-[15px] leading-[1.6] text-muted">{p}</p>
                  ))}
                  {b.quotes?.map((q) => (
                    <p class="sec-cita text-[17px]">{q}</p>
                  ))}
                </div>
                <div>
                  {b.emph?.map((p) => (
                    <p class="mb-2.5 text-[clamp(17px,1.5vw,20px)] font-medium leading-[1.35] tracking-[-0.012em]">{p}</p>
                  ))}
                  {b.link && (
                    <a href={b.link.href} class="link-arrow mt-2">
                      {b.link.label} →
                    </a>
                  )}
                </div>
              </div>
            </section>
          );
        }

        /* Flujos: cada proceso en una fila, paso a paso. */
        if (b.type === 'flow') {
          return (
            <section class="section-y">
              <div class="section-head" data-reveal>
                <h2 class="sec-h2">{b.h2}</h2>
                <div class="space-y-3">
                  {b.paras.map((p) => (
                    <p class="max-w-[46ch] text-base leading-[1.6] text-muted">{p}</p>
                  ))}
                </div>
              </div>
              <div class="border-t-2 border-border">
                {b.flows.map((f, i) => (
                  <div class:list={['sec-flujo', f.label && 'con-rotulo']}>
                    <span class:list={['pt-3 text-[13px]', f.label ? 'text-muted' : 'num']}>{f.label ?? dos(i)}</span>
                    <ol class="flex flex-wrap items-center gap-y-2.5">
                      {f.steps.map(([t, ia], k) => (
                        <li class="inline-flex items-center">
                          <span class:list={['sec-paso', ia && 'es-ia']}>{t}</span>
                          {k !== f.steps.length - 1 && <span class="sec-conector" aria-hidden="true" />}
                        </li>
                      ))}
                    </ol>
                  </div>
                ))}
              </div>
              <div class="mt-5 flex flex-wrap items-center gap-x-7 gap-y-3 text-[13px] text-muted">
                <span class="inline-flex items-center gap-2">
                  <span class="block h-3 w-3 bg-accent" aria-hidden="true" />
                  {l.aiReads}
                </span>
                <span class="inline-flex items-center gap-2">
                  <span class="block h-3 w-3 border-2 border-fg" aria-hidden="true" />
                  {l.softwareRuns}
                </span>
                {b.emph && <span class="font-medium text-fg sm:ml-auto">{b.emph}</span>}
              </div>
              {b.link && (
                <a href={b.link.href} class="link-arrow mt-6">
                  {b.link.label} →
                </a>
              )}
            </section>
          );
        }

        /* Integración: texto y retícula de sistemas. */
        if (b.type === 'integration') {
          const r = reticula(b.list?.length ?? 0, 3);
          return (
            <section class="sec-dos section-y">
              <div data-reveal>
                <span class="kicker mb-7">{b.kicker ?? l.integration}</span>
                <h2 class="sec-h2-compacto">{b.h2}</h2>
                {b.paras?.map((p) => (
                  <p class="mt-5 max-w-[52ch] text-base leading-[1.65] text-muted">{p}</p>
                ))}
                {b.list2 && (
                  <>
                    <p class="mb-3.5 mt-8 text-[13px] text-muted">{b.label2}</p>
                    <ol class="sec-lista">
                      {b.list2.map((t, i) => (
                        <li>
                          <span aria-hidden="true">{dos(i)}</span>
                          {t}
                        </li>
                      ))}
                    </ol>
                  </>
                )}
                {b.link && (
                  <a href={b.link.href} class="link-arrow mt-6">
                    {b.link.label} →
                  </a>
                )}
              </div>
              <div>
                {b.label && <p class="mb-4 text-[13px] text-muted">{b.label}</p>}
                <ul class:list={['sec-grid sec-grid-marco', r.impar && 'impar']} style={r.style}>
                  {b.list?.map((t) => (
                    <li class="sec-celda sec-celda-menor">
                      <span class="sq" aria-hidden="true" />
                      <span class="text-[15px] font-medium leading-[1.3]">{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          );
        }

        /* Áreas: columnas con título y texto. */
        if (b.type === 'areas') {
          const r = reticula(b.items.length);
          return (
            <section class="section-y">
              <div class="section-head" data-reveal>
                <h2 class="sec-h2">{b.h2}</h2>
                <div class="space-y-3">
                  {b.paras?.map((p) => (
                    <p class="max-w-[44ch] text-base leading-[1.6] text-muted">{p}</p>
                  ))}
                </div>
              </div>
              <div class:list={['sec-grid sec-grid-regla', r.impar && 'impar']} style={r.style}>
                {b.items.map((a, i) => (
                  <div class="flex flex-col bg-bg px-6 pb-8 pt-7">
                    <span class="num mb-7">{dos(i)}</span>
                    <h3 class="mb-3 text-xl leading-tight tracking-[-0.015em]">{a.t}</h3>
                    <p class="text-[15px] leading-[1.55] text-muted">{a.d}</p>
                    {a.items && (
                      <ul class="mt-auto grid gap-1.5 pt-5 text-sm leading-[1.4] text-muted">
                        {a.items.map((t) => (
                          <li class="grid grid-cols-[8px_1fr] items-baseline gap-2.5">
                            <span class="block h-2 w-2 bg-accent" aria-hidden="true" />
                            {t}
                          </li>
                        ))}
                      </ul>
                    )}
                    {a.k && <p class="mt-5 text-[15px] font-medium leading-[1.4]">{a.k}</p>}
                  </div>
                ))}
              </div>
              {b.after && (
                <div class="mt-6 space-y-2.5">
                  {b.after.map((p) => (
                    <p class="max-w-[62ch] text-[15px] leading-[1.6] text-muted">{p}</p>
                  ))}
                </div>
              )}
            </section>
          );
        }

        /* Caso real: el nombre, lo que consiguió y el enlace a su página. */
        if (b.type === 'case') {
          return (
            <section class="section-y">
              <div class="sec-dos border-t-2 border-fg pt-[clamp(32px,4vw,48px)]">
                <div data-reveal>
                  <h2 class="kicker mb-6">{b.h2}</h2>
                  <h3 class="sec-h2-compacto max-w-[18ch]">{b.sub}</h3>
                  <a href={b.link.href} class="link-arrow mt-7">
                    {b.link.label} →
                  </a>
                  {fotoDeCaso(b.link.href) && (
                    <a href={b.link.href} class="sec-caso-foto" tabindex="-1" aria-hidden="true">
                      <Picture
                        pictureAttributes={{ class: 'contents' }}
                        src={foto(fotoDeCaso(b.link.href)!)}
                        alt=""
                        formats={['avif', 'webp']}
                        widths={[480, 800, 1200]}
                        sizes="(min-width: 960px) 560px, calc(100vw - 32px)"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    </a>
                  )}
                </div>
                <div>
                  <div class="space-y-4">
                    {b.paras.map((p) => (
                      <p class="max-w-[52ch] text-base leading-[1.65] text-muted">{p}</p>
                    ))}
                  </div>
                  {b.list && (
                    <>
                      {b.label && <p class="mb-4 mt-7 text-[13px] text-muted">{b.label}</p>}
                      <ul class="flex flex-wrap gap-2">
                        {b.list.map((t) => (
                          <li class="sec-chip">{t}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  {b.after && (
                    <div class="mt-6 space-y-4">
                      {b.after.map((p) => (
                        <p class="max-w-[52ch] text-base leading-[1.65] text-muted">{p}</p>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </section>
          );
        }

        /* Control: campo en tinta a sangre. */
        if (b.type === 'dark') {
          const r = reticula(b.list?.length ?? 0);
          return (
            <>
            {/* Banda de foto a sangre, pegada encima del bloque de control: el
                respiro visual a mitad de una página que hasta aquí es todo
                texto (15 oct 2026). Sin `photo`, el hueco gris del diseño. */}
            <figure class="sec-sangre sec-banda" aria-hidden="true">
              {d.photo ? (
                <Picture
                  pictureAttributes={{ class: 'contents' }}
                  src={foto(d.photo)}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[640, 1024, 1440, 1920]}
                  sizes="100vw"
                  loading="lazy"
                  decoding="async"
                  class="bn absolute inset-0 h-full w-full object-cover"
                />
              ) : (
                <div class="photo-slot absolute inset-0 h-full" />
              )}
            </figure>
            <section class="sec-sangre sec-oscuro">
              <div class="sec-sangre-dentro">
                <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] items-end gap-x-[clamp(32px,5vw,96px)] gap-y-6">
                  <div>
                    <span class="mb-5 block text-xs uppercase leading-[1.4] tracking-[0.12em] text-accent-300">
                      {b.kicker ?? l.control}
                    </span>
                    <h2 class="sec-h2 max-w-[20ch]">{b.h2}</h2>
                  </div>
                  <div class="space-y-3">
                    {b.paras?.map((p) => (
                      <p class="sec-oscuro-suave max-w-[48ch] text-base leading-[1.6]">{p}</p>
                    ))}
                    {b.emph?.map((p) => (
                      <p class="max-w-[48ch] text-base font-medium leading-[1.6]">{p}</p>
                    ))}
                  </div>
                </div>
                {b.label && <p class="sec-oscuro-rotulo mb-3.5 mt-[clamp(40px,5vw,64px)] text-[13px]">{b.label}</p>}
                <ol class:list={['sec-grid sec-grid-oscura', r.impar && 'impar']} style={r.style}>
                  {b.list?.map((t, i) => (
                    <li>
                      <span class="sec-oscuro-rotulo text-xs [font-feature-settings:'tnum'_1]" aria-hidden="true">
                        {dos(i)}
                      </span>
                      <span class="text-[15px] leading-[1.35]">{t}</span>
                    </li>
                  ))}
                </ol>
                {b.list2 && (
                  <>
                    <p class="sec-oscuro-rotulo mb-3.5 mt-8 text-[13px]">{b.label2}</p>
                    <ul class="flex flex-wrap gap-2">
                      {b.list2.map((t) => (
                        <li class="sec-chip sec-chip-oscura">{t}</li>
                      ))}
                    </ul>
                  </>
                )}
                {b.after?.map((p) => (
                  <p class="mt-6 max-w-[56ch] text-[clamp(17px,1.5vw,20px)] font-medium leading-[1.4]">{p}</p>
                ))}
                {b.link && (
                  <a href={b.link.href} class="sec-enlace-claro mt-6">
                    {b.link.label} →
                  </a>
                )}
              </div>
            </section>
            </>
          );
        }

        /* Díptico: dos listas enfrentadas. */
        if (b.type === 'diptych') {
          return (
            <section class="section-y">
              <div class="section-head" data-reveal>
                <h2 class="sec-h2">{b.h2}</h2>
                <div class="space-y-3">
                  {b.paras.map((p) => (
                    <p class="max-w-[46ch] text-base leading-[1.6] text-muted">{p}</p>
                  ))}
                </div>
              </div>
              <div class="sec-diptico">
                <div class="bg-bg p-[clamp(24px,3vw,40px)]">
                  <div class="mb-5 flex items-center gap-3">
                    <span class="sq shrink-0" aria-hidden="true" />
                    <h3 class="kicker">{b.yesLabel}</h3>
                  </div>
                  <ol class="sec-lista sec-lista-abierta">
                    {b.yes.map((t, i) => (
                      <li>
                        <span aria-hidden="true">{dos(i)}</span>
                        {t}
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="bg-bg-soft p-[clamp(24px,3vw,40px)]">
                  <div class="mb-5 flex items-center gap-3">
                    <span class="sec-sq-hueco shrink-0" aria-hidden="true" />
                    <h3 class="kicker text-muted!">{b.roiLabel}</h3>
                  </div>
                  <ol class="sec-lista sec-lista-abierta text-neutral-900">
                    {b.roi.map((t, i) => (
                      <li>
                        <span aria-hidden="true">{dos(i)}</span>
                        {t}
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
              {b.note && <p class="mt-5 max-w-[80ch] text-sm leading-[1.6] text-muted">{b.note}</p>}
              {b.emph?.map((p) => (
                <p class="mt-4 max-w-[44ch] text-[clamp(18px,1.6vw,22px)] font-medium leading-[1.35] tracking-[-0.015em]">{p}</p>
              ))}
            </section>
          );
        }

        /* Método. */
        if (b.type === 'steps') {
          return (
            <section id="metodo" class="section-y">
              <div class="section-head" data-reveal>
                <h2 class="sec-h2 max-w-[22ch]">{b.h2}</h2>
                {b.lead && <p class="max-w-[44ch] text-base leading-[1.6] text-muted">{b.lead}</p>}
              </div>
              <ol class="sec-metodos border-t-2 border-border">
                {b.steps.map(([t, texto], i) => (
                  <li class="sec-metodo">
                    <span class="sq mb-10" aria-hidden="true" />
                    <h3 class="mb-3 text-lg leading-tight tracking-[-0.015em]">
                      <span class="num mb-2.5 block">{dos(i)}</span>
                      {t}
                    </h3>
                    <p class="text-[15px] leading-[1.6] text-muted">{texto}</p>
                  </li>
                ))}
              </ol>
            </section>
          );
        }

        /* A medida: caja con su lista a dos columnas. */
        if (b.type === 'when') {
          return (
            <section class="section-y">
              <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-x-[clamp(32px,5vw,96px)] gap-y-8 border-2 border-border bg-bg-soft p-[clamp(28px,4vw,56px)]">
                <div>
                  <span class="kicker mb-5">{l.custom}</span>
                  <h2 class="sec-h2-menor">{b.h2}</h2>
                  {b.after?.map((p) => (
                    <p class="mt-6 max-w-[44ch] text-base font-medium leading-[1.6] text-neutral-900">{p}</p>
                  ))}
                </div>
                <div>
                  {b.label && <p class="mb-3.5 text-[13px] text-muted">{b.label}</p>}
                  <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-x-6">
                    {b.list?.map((t) => (
                      <li class="grid grid-cols-[10px_1fr] items-baseline gap-3 border-t-2 border-border py-3 text-[15px] leading-[1.4]">
                        <span class="sq" aria-hidden="true" />
                        {t}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </section>
          );
        }

        /* FAQ: la pieza de todo el sitio. La primera frase de cada respuesta
           es la respuesta corta y va en tinta, como en el diseño. */
        if (b.type === 'faq') {
          return (
            <section class="mt-(--section-y) border-t-2 border-fg pt-[clamp(48px,6vw,80px)]">
              <div class="grid items-start gap-x-[clamp(32px,5vw,96px)] gap-y-8 lg:grid-cols-3">
                <div class="lg:sticky lg:top-[104px]">
                  <span class="kicker mb-5">{l.faq}</span>
                  <h2 class="sec-h2-menor">{b.h2}</h2>
                  {b.lead && <p class="mt-5 max-w-[40ch] text-[15px] leading-[1.6] text-muted">{b.lead}</p>}
                </div>
                <div class="sec-faq lg:col-span-2">
                  <FaqList items={b.items} group="faq-sector" openFirst />
                </div>
              </div>
            </section>
          );
        }

        /* El contacto va fuera del contenedor, más abajo. */
        return null;
      })
    }

    <!-- Otros sectores. Sin ninguno en este idioma, el bloque no sale. -->
    {otros.length > 0 && (
      <section class="section-y">
        <h2 class="kicker mb-6">{l.others}</h2>
        <div class="ruled-grid sm:grid-cols-2 lg:grid-cols-3">
          {
            otros.map((o) => (
              <a href={o.href} class="sec-otro">
                <span class="block text-[17px] font-medium leading-tight tracking-[-0.015em]">{o.name}</span>
                <span class="mt-2 block text-[13px] leading-normal opacity-75">{o.short}</span>
                <span class="mt-auto flex items-center justify-between pt-5 text-[13px]">
                  <span class="border-b-2 border-current pb-0.5">{l.viewSector}</span>
                  <span class="text-lg leading-none" aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>
    )}
  </div>

  <!-- Contacto: el formulario del sitio, con el texto del sector. En el
       diseño va antes de «Otros sectores»; aquí cierra la página, como en
       las de solución, porque es el final de todas las del sitio. -->
  {
    d.blocks.map(
      (b) =>
        b.type === 'contact' && (
          <ContactForm lang={lang} texto={{ kicker: l.contact, title: b.h2, body: b.p, submit: b.cta }} />
        )
    )
  }
</BaseLayout>

<script>
  import { carrusel } from './home/autoplay';

  document.querySelectorAll<HTMLElement>('[data-usos]').forEach((raiz) => {
    const botones = Array.from(raiz.querySelectorAll<HTMLElement>('[data-uso]'));
    const fichas = Array.from(raiz.querySelectorAll<HTMLElement>('[data-uso-ficha]'));
    // A partir de aquí solo se ve la ficha activa. Sin este script se ven todas.
    raiz.classList.add('con-js');

    const c = carrusel({
      raiz,
      total: botones.length,
      intervalo: 5000,
      pintar(i) {
        botones.forEach((b, k) => {
          b.classList.toggle('is-active', k === i);
          b.setAttribute('aria-pressed', k === i ? 'true' : 'false');
        });
        fichas.forEach((f, k) => f.classList.toggle('is-active', k === i));
      },
    });

    botones.forEach((b, k) => {
      const activar = () => {
        if (c.actual() !== k) c.ir(k);
      };
      b.addEventListener('mouseenter', activar);
      b.addEventListener('focus', activar);
      b.addEventListener('click', activar);
    });
  });
</script>

