---
/*
  Las entradas del blog que desarrollan lo que cuenta esta página.

  Cierra la mitad que faltaba del enlazado de grupo: los posts ya enlazaban
  hacia su página pilar, pero ninguna pilar devolvía el enlace. El conjunto se
  deriva de esos mismos enlaces (ver `lib/cluster.ts`), así que publicar una
  entrada nueva la incorpora sola, sin tocar ninguna lista.

  Si el grupo no tiene entradas, el componente no pinta nada.

  Aspecto: la retícula de tres columnas de la FAQ, con el titular a la
  izquierda y las entradas a la derecha en filas separadas por reglas de 2 px.
  Cada fila es un enlace entero y su título pasa a acento al posarse.
*/
import { type Lang, content } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import { postsForPillar } from '../lib/cluster';

interface Props {
  lang: Lang;
  /** Ruta de la página pilar, tal como la enlazan los posts. */
  pillar: string;
}
const { lang, pillar } = Astro.props;

const t = content[lang].blog;
const posts = await postsForPillar(lang, pillar);

const slugOf = (id: string) => id.replace(/^(es|en)\//, '');
---

{
  posts.length > 0 && (
    <section class="wrap section-y">
      <div class="grid items-start gap-x-[clamp(32px,5vw,96px)] gap-y-8 lg:grid-cols-3">
        <h2 class="text-[clamp(28px,3vw,40px)] leading-[1.08] tracking-[-0.028em] lg:sticky lg:top-[104px]">
          {t.clusterHeading}
        </h2>

        <ul class="border-t-2 border-border lg:col-span-2">
          {posts.map((post) => (
            <li class="border-b-2 border-border">
              <a
                href={localizedPath(`/blog/${slugOf(post.id)}`, lang)}
                class="group grid grid-cols-[minmax(0,1fr)_24px] gap-6 py-[22px]"
              >
                <span>
                  <span class="block text-[clamp(17px,1.5vw,20px)] font-medium leading-[1.35] tracking-[-0.012em] transition-colors group-hover:text-accent">
                    {post.data.title}
                  </span>
                  <span class="mt-2 block max-w-[70ch] text-[15px] leading-[1.6] text-muted">
                    {post.data.description}
                  </span>
                </span>
                <span class="pt-0.5 text-right text-lg text-accent" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
