---
import { type Lang, content } from '../i18n/ui';
import FlowDiagram from './FlowDiagram.astro';
import GateDiagram from './GateDiagram.astro';
import Icon from './Icon.astro';
import LatticeDots from './LatticeDots.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].whyUs;
---

<section class="bg-bg py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <header class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        {t.title}
      </h2>
      <p class="mt-4 text-lg text-muted">{t.subtitle}</p>
    </header>

    {/* Reticula continua, igual que en servicios: las cajas comparten linea en
        vez de ir sueltas con su sombra. El `gap-px` sobre un fondo del color
        del borde dibuja la cuadricula sola. Sin esquinas redondeadas, para
        que el bloque se lea como una sola pieza.

        Cuadradas solo a partir de `lg`, que es donde van tres en fila. Por
        debajo se apilan a una columna y un cuadrado a todo el ancho seria una
        caja enorme y casi vacia. */}
    <ul class="mt-14 grid gap-px border border-border bg-border lg:grid-cols-3">
      {
        t.items.map((item, i) => (
          <li class="relative bg-bg lg:aspect-square">
            <div class="group relative flex h-full flex-col overflow-hidden p-7 transition-colors duration-300 hover:bg-border/30 lg:p-8">
              {/* El icono aqui no describe el compromiso, que ya lo dice el
                  titulo: avisa de que la tarjeta se abre, porque al pulsarla
                  aparece un modal. Un icono tematico distinto por tarjeta
                  contaba el tema y se comia esa senal, y una flecha a la
                  derecha prometia navegacion a otra pagina.

                  `expandir` son dos cuñas contrapuestas que al pasar por
                  encima se apartan, de modo que el propio gesto es el mensaje.
                  Decorativo (`pointer-events-none`) para que el boton
                  invisible de debajo reciba la pulsacion. */}
              <div
                class="pointer-events-none absolute right-6 top-6 z-10 grid h-11 w-11 place-items-center rounded-md bg-bg-soft transition-transform duration-300 group-hover:scale-110"
                aria-hidden="true"
              >
                <Icon name="expandir" size={24} class="icon-expand text-fg" />
              </div>

              <h3 class="pr-14 text-xl font-bold leading-snug text-fg">{item.title}</h3>
              <p class="mt-4 line-clamp-6 text-[15px] leading-relaxed text-muted">{item.body}</p>

              {/* Invisible full-card click target. Sits above the static text so
                  clicks anywhere on the card trigger the modal. Sin redondeo
                  propio: ahora las esquinas las pone el contenedor. */}
              <button
                type="button"
                data-modal-trigger={`whyus-modal-${i}`}
                aria-label={`Ver más: ${item.title}`}
                class="absolute inset-0 cursor-pointer focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent"
              />
            </div>
            <LatticeDots seed={307 + i * 7} />
          </li>
        ))
      }
    </ul>
  </div>

  {/* Modals live as siblings of the <ul> because <dialog> is not a valid
      child of <ul>. They are opened/closed by the script below. */}
  {
    t.items.map((item, i) => {
      const titleId = `whyus-modal-${i}-title`;
      return (
        <dialog
          id={`whyus-modal-${i}`}
          data-whyus-modal
          aria-labelledby={titleId}
        >
          {/* Close button: small square pill, top-right inside the modal.
              El icono va a 20 y no a 16 porque `cerrar` declara `minSize: 20`:
              por debajo, el corte del cruce baja de un pixel y los cuatro
              brazos se empastan en dos barras. */}
          <button
            type="button"
            data-modal-close
            aria-label={lang === 'es' ? 'Cerrar' : 'Close'}
            class="absolute right-4 top-4 z-20 grid h-11 w-11 place-items-center rounded-lg bg-bg-soft text-accent transition-colors hover:bg-border sm:right-5 sm:top-5 sm:h-9 sm:w-9"
          >
            <Icon name="cerrar" size={20} />
          </button>

          {/* Scrollable content area, scrollbar hidden by .no-scrollbar */}
          <div class="no-scrollbar h-full overflow-y-auto px-6 pb-12 pt-16 sm:px-12 sm:py-16 lg:px-20 lg:py-20">
            <div class="mx-auto max-w-6xl">
              {/* Two-column header: left = title + subtitle + CTA, right = bullet list */}
              <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
                <div>
                  <h2
                    id={titleId}
                    class="text-balance text-3xl font-bold tracking-tight text-fg sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
                  >
                    {item.modal.title}
                  </h2>
                  <p class="mt-6 text-pretty text-lg leading-relaxed text-muted">
                    {item.modal.subtitle}
                  </p>
                  <div class="mt-9">
                    <a
                      href={item.modal.cta.href}
                      data-modal-close
                      class="btn-primary hover:btn-primary-hover inline-flex items-center gap-2"
                    >
                      {item.modal.cta.label}
                      <Icon name="flecha-derecha" size={16} />
                    </a>
                  </div>
                </div>

                <ul class="space-y-6 lg:pt-3">
                  {item.modal.bullets.map((b) => (
                    <li class="flex items-start gap-3">
                      <span
                        class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent text-bg"
                        aria-hidden="true"
                      >
                        <Icon name="correcto" size={12} />
                      </span>
                      <span>
                        <span class="block font-bold leading-snug text-fg">{b.title}</span>
                        <span class="mt-1 block text-[15px] leading-snug text-muted">{b.body}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Experience notes: opening line, story, hard numbers, closing line */}
              <div class="mx-auto mt-14 max-w-3xl border-t border-border-soft pt-12">
                <p class="text-balance text-2xl font-bold leading-snug tracking-tight text-fg sm:text-[1.75rem]">
                  {item.modal.openingLine}
                </p>

                <div class="mt-8 space-y-6">
                  {item.modal.paragraphs.slice(0, 2).map((p, k) => (
                    <>
                      {typeof p === 'string' ? (
                        <p class="text-[15px] leading-relaxed text-muted sm:text-base" set:html={p} />
                      ) : (
                        <div>
                          <h3 class="text-base font-bold text-fg">{p.heading}</h3>
                          <p class="mt-2 text-[15px] leading-relaxed text-muted sm:text-base" set:html={p.body} />
                        </div>
                      )}
                      {item.modal.diagram?.after === k &&
                        (item.modal.diagram.kind === 'gate' ? (
                          <GateDiagram lang={lang} />
                        ) : (
                          <FlowDiagram lang={lang} />
                        ))}
                    </>
                  ))}
                </div>

                {item.modal.stats && item.modal.stats.length > 0 && (
                  <dl class="mt-12 grid gap-5 sm:grid-cols-3">
                    {item.modal.stats.map((s) => (
                      <div class="rounded-xl bg-bg-soft p-6">
                        <dt class="text-[1.75rem] font-bold leading-none tracking-tight text-accent">
                          {s.value}
                        </dt>
                        <dd class="mt-3 text-sm leading-snug text-muted">{s.label}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                <div class="mt-12 space-y-6">
                  {item.modal.paragraphs.slice(2).map((p, k) => (
                    <>
                      {typeof p === 'string' ? (
                        <p class="text-[15px] leading-relaxed text-muted sm:text-base" set:html={p} />
                      ) : (
                        <div>
                          <h3 class="text-base font-bold text-fg">{p.heading}</h3>
                          <p class="mt-2 text-[15px] leading-relaxed text-muted sm:text-base" set:html={p.body} />
                        </div>
                      )}
                      {item.modal.diagram?.after === k + 2 &&
                        (item.modal.diagram.kind === 'gate' ? (
                          <GateDiagram lang={lang} />
                        ) : (
                          <FlowDiagram lang={lang} />
                        ))}
                    </>
                  ))}
                </div>

                {item.modal.closingLine && (
                  <p class="mt-12 border-l-2 border-accent pl-5 text-lg font-medium leading-relaxed text-fg">
                    {item.modal.closingLine}
                  </p>
                )}

                <div class="mt-12 rounded-2xl border border-border bg-bg-soft p-7">
                  <h3 class="text-base font-bold text-fg">{item.modal.notPromised.heading}</h3>
                  <p class="mt-3 text-[15px] leading-relaxed text-muted">
                    {item.modal.notPromised.body}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </dialog>
      );
    })
  }
</section>

<script>
  // Open a dialog when any element with [data-modal-trigger] is clicked.
  document.querySelectorAll<HTMLElement>('[data-modal-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.dataset.modalTrigger;
      if (!id) return;
      const dialog = document.getElementById(id) as HTMLDialogElement | null;
      dialog?.showModal();
      // Los diagramas dentro del modal se miden a sí mismos, y mientras el
      // <dialog> está cerrado su ancho es 0. Al abrirlo, que se reajusten.
      document.dispatchEvent(new Event('dg:refit'));
    });
  });

  // Close on X button, on ESC (native), or on backdrop click.
  document.querySelectorAll<HTMLDialogElement>('dialog[data-whyus-modal]').forEach((dialog) => {
    dialog.querySelectorAll<HTMLButtonElement>('[data-modal-close]').forEach((btn) => {
      btn.addEventListener('click', () => dialog.close());
    });
    dialog.addEventListener('click', (e) => {
      // Clicks on the ::backdrop bubble up with event.target === dialog
      if (e.target === dialog) dialog.close();
    });
  });
</script>
