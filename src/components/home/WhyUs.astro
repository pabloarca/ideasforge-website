---
/*
  ¿Por qué Ideasforge?: los tres compromisos que no vienen en una suscripción
  (Observabilidad por defecto, El código es tuyo, Seguridad por defecto).

  Vuelve a la portada el 19 oct 2026 porque el propietario no autorizó
  quitarlo. El TEXTO está congelado (decisión de agosto de 2026): se lee tal
  cual de `content[lang].whyUs`, el mismo bloque que publica la web actual, y
  aquí no se reescribe una coma. Lo único nuevo es el vestido, que sigue el
  lenguaje del rediseño de octubre: cabecera de sección, retícula con reglas
  de 2 px, rótulo en acento y sin esquinas redondeadas.

  Cada tarjeta abre un <dialog> con su texto largo. Las dos pizarras que
  acompañaban a dos de los modales en la versión anterior (la compuerta de
  pruebas y el flujo del contrato) no existen en el rediseño y no se pintan:
  el campo `diagram` se ignora.
*/
import { type Lang, content } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].whyUs;
const cerrar = lang === 'es' ? 'Cerrar' : 'Close';
const verMas = lang === 'es' ? 'Ver más' : 'Read more';
---

<section id="compromisos" class="wrap section-y">
  <div class="section-head" data-reveal>
    <div>
      <span class="kicker mb-7">{t.eyebrow}</span>
      <h2 class="t-h2">{t.title}</h2>
    </div>
    <p class="max-w-[44ch] text-base leading-[1.6] text-muted">{t.subtitle}</p>
  </div>

  <ul class="ruled-grid compromisos">
    {
      t.items.map((item, i) => (
        <li class="compromiso">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-6 text-[clamp(22px,2.2vw,30px)] leading-[1.12] tracking-[-0.022em]">{item.title}</h3>
          <p class="mt-4 text-[15px] leading-[1.6] text-muted">{item.body}</p>
          <span class="link-arrow mt-auto self-start pt-7" aria-hidden="true">
            {verMas} →
          </span>
          <button
            type="button"
            class="compromiso-boton"
            data-compromiso-abre={`compromiso-${i}`}
            aria-label={`${verMas}: ${item.title}`}
          />
        </li>
      ))
    }
  </ul>

  {
    t.items.map((item, i) => (
      <dialog id={`compromiso-${i}`} class="compromiso-modal" aria-labelledby={`compromiso-${i}-titulo`} data-compromiso>
        <button type="button" class="btn-icon compromiso-cerrar" data-compromiso-cierra aria-label={cerrar}>
          ×
        </button>
        <div class="compromiso-scroll no-scrollbar">
          <div class="mx-auto max-w-6xl">
            <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
              <div>
                <span class="kicker mb-5">{item.modal.eyebrow}</span>
                <h2 id={`compromiso-${i}-titulo`} class="t-h2-compact">
                  {item.modal.title}
                </h2>
                <p class="mt-6 text-[17px] leading-[1.6] text-muted">{item.modal.subtitle}</p>
                <a href={item.modal.cta.href} class="btn-primary hover:btn-primary-hover mt-9" data-compromiso-cierra>
                  {item.modal.cta.label} →
                </a>
              </div>
              <ul class="border-b-2 border-border lg:pt-3">
                {item.modal.bullets.map((b) => (
                  <li class="grid grid-cols-[20px_1fr] gap-3 border-t-2 border-border py-4">
                    <span class="sq mt-[7px]" aria-hidden="true" />
                    <span>
                      <span class="block font-medium leading-snug">{b.title}</span>
                      <span class="mt-1 block text-[15px] leading-snug text-muted">{b.body}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mx-auto mt-14 max-w-3xl border-t-2 border-fg pt-12">
              <p class="t-h3-row">{item.modal.openingLine}</p>

              <div class="mt-8 space-y-6">
                {item.modal.paragraphs.map((p) =>
                  typeof p === 'string' ? (
                    <p class="text-base leading-[1.65] text-muted" set:html={p} />
                  ) : (
                    <div>
                      <h3 class="text-lg font-medium leading-snug">{p.heading}</h3>
                      <p class="mt-2 text-base leading-[1.65] text-muted" set:html={p.body} />
                    </div>
                  )
                )}
              </div>

              {item.modal.stats && item.modal.stats.length > 0 && (
                <dl class="ruled-grid mt-12 sm:grid-cols-3">
                  {item.modal.stats.map((st) => (
                    <div class="p-6">
                      <dt class="text-[1.75rem] leading-none tracking-tight text-accent">{st.value}</dt>
                      <dd class="mt-3 text-sm leading-snug text-muted">{st.label}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {item.modal.closingLine && (
                <p class="mt-12 border-l-2 border-accent pl-5 text-lg font-medium leading-relaxed">
                  {item.modal.closingLine}
                </p>
              )}

              <div class="mt-12 border-2 border-border bg-bg-soft p-7">
                <h3 class="text-base font-medium">{item.modal.notPromised.heading}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-muted">{item.modal.notPromised.body}</p>
              </div>
            </div>
          </div>
        </div>
      </dialog>
    ))
  }
</section>

<style>
  .compromisos {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }
  .compromiso {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px clamp(24px, 3vw, 40px) 36px;
    transition: background-color 250ms;
  }
  .compromiso:hover {
    background-color: var(--color-bg-soft);
  }
  /* El botón cubre la tarjeta entera: se pulsa en cualquier punto. */
  .compromiso-boton {
    position: absolute;
    inset: 0;
    cursor: pointer;
    background: transparent;
  }
  .compromiso-boton:focus-visible {
    outline-offset: -4px;
  }

  .compromiso-modal {
    width: min(100% - 32px, 1200px);
    max-width: none;
    height: min(100dvh - 32px, 920px);
    max-height: none;
    margin: auto;
    padding: 0;
    border: 2px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg);
  }
  .compromiso-modal::backdrop {
    background: rgb(32 30 29 / 0.55);
  }
  .compromiso-scroll {
    height: 100%;
    overflow-y: auto;
    padding: 72px clamp(20px, 6vw, 80px) 64px;
  }
  .compromiso-cerrar {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 1;
    background: var(--color-bg);
    font-size: 22px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-compromiso-abre]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const id = boton.dataset.compromisoAbre;
      const dialogo = id ? (document.getElementById(id) as HTMLDialogElement | null) : null;
      dialogo?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog[data-compromiso]').forEach((dialogo) => {
    dialogo.querySelectorAll('[data-compromiso-cierra]').forEach((el) => {
      el.addEventListener('click', () => dialogo.close());
    });
    // Pulsar fuera del cuadro (sobre el fondo) también cierra.
    dialogo.addEventListener('click', (e) => {
      if (e.target === dialogo) dialogo.close();
    });
  });
</script>
