---
/*
  Página de conocimiento corporativo (ES y EN). El mismo marcado estaba
  copiado en los dos archivos; aquí vive una sola vez.

  Los pares de tarjetas (para quién / problema, garantías / prueba) y la
  rejilla de capacidades pasan a retícula continua, el lenguaje de la home:
  celdas que comparten línea, sin sombras ni esquinas redondeadas. Antes eran
  tarjetas sueltas con la sombra lavanda antigua.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import ClusterPosts from './ClusterPosts.astro';
import Icon from './Icon.astro';
import { type Lang, type EnterprisePageContent } from '../i18n/ui';
import { pillarFromUrl } from '../lib/cluster';
import { altsFor, localizedPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: EnterprisePageContent;
  title: string;
  description: string;
}
const { lang, page: p, title, description } = Astro.props;
---

<BaseLayout lang={lang} title={title} description={description} alternates={altsFor('enterprise')}>
  <!-- Hero -->
  <section class="bg-bg py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
      {p.hero.eyebrow && <span class="eyebrow-pill">{p.hero.eyebrow}</span>}
      <h1 class="mt-7 text-balance text-4xl font-bold leading-[1.05] tracking-tight text-fg sm:text-5xl lg:text-6xl">
        {p.hero.title}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-pretty text-lg leading-relaxed text-muted sm:text-xl">
        {p.hero.subtitle}
      </p>
      <div class="mt-9">
        <a href={localizedPath('/#contacto', lang)} class="btn-primary hover:btn-primary-hover">
          {p.hero.cta}
        </a>
      </div>
    </div>
  </section>

  <!-- For Whom + Problem -->
  <section class="bg-bg-soft py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-px border border-border bg-border md:grid-cols-2">
        <div class="bg-bg p-8">
          <h2 class="text-2xl font-bold text-fg">{p.forWhom.heading}</h2>
          <p class="mt-4 text-[15px] leading-relaxed text-muted">{p.forWhom.body}</p>
        </div>
        <div class="bg-bg p-8">
          <h2 class="text-2xl font-bold text-fg">{p.problem.heading}</h2>
          <p class="mt-4 text-[15px] leading-relaxed text-muted">{p.problem.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What we build + How -->
  <section class="bg-bg py-16 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-8 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{p.whatWeBuild.heading}</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">{p.whatWeBuild.body}</p>
      </div>
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{p.how.heading}</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">{p.how.body}</p>
      </div>
    </div>
  </section>

  <!-- Guarantees + Proof -->
  <section class="bg-bg-soft py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid gap-px border border-border bg-border md:grid-cols-2">
        <div class="bg-bg p-8">
          <h2 class="text-2xl font-bold text-fg">{p.guarantees.heading}</h2>
          <p class="mt-4 text-[15px] leading-relaxed text-muted">{p.guarantees.body}</p>
          {
            p.guarantees.link && (
              <a
                href={p.guarantees.link.href}
                class="group mt-5 inline-flex items-center gap-1.5 text-[15px] font-medium text-accent"
              >
                <span class="underline-offset-4 group-hover:underline">{p.guarantees.link.label}</span>
                <Icon name="flecha-derecha" size={16} class="shrink-0 transition-transform duration-300 group-hover:translate-x-0.5" />
              </a>
            )
          }
        </div>
        <div class="bg-bg p-8">
          <h2 class="text-2xl font-bold text-fg">{p.proof.heading}</h2>
          <p class="mt-4 text-[15px] leading-relaxed text-muted">{p.proof.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities grid -->
  <section class="bg-bg py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <h2 class="text-center text-3xl font-bold tracking-tight text-fg sm:text-4xl">
        {p.capabilities.heading}
      </h2>
      <ul class="mt-12 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
        {
          p.capabilities.items.map((c) => (
            <li class="bg-bg p-7">
              <h3 class="text-lg font-bold leading-snug text-fg">{c.title}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">{c.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Entradas del blog de este grupo. Se derivan de los enlaces que los
      propios posts declaran, asi que publicar una entrada nueva la
      incorpora sola. Si el grupo no tiene ninguna, no pinta nada. */}
  <ClusterPosts lang={lang} pillar={pillarFromUrl(Astro.url.pathname)} />

  <!-- Final CTA -->
  <section class="bg-bg-soft py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{p.cta.heading}</h2>
      <p class="mt-4 text-lg text-muted">{p.cta.body}</p>
      <div class="mt-7">
        <a href={localizedPath('/#contacto', lang)} class="btn-primary hover:btn-primary-hover">
          {p.cta.button}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
