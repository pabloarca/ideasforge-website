---
/*
  Las tres señales de un juguete. En el post «El juguete brillante»,
  sección «Cómo se reconoce un juguete antes de pagarlo», al final.

  Una lista de comprobación con tres casillas marcadas en rojo, una por
  señal. Debajo, la frase que cierra la sección.

  Escritorio 800 × 250, móvil 360 × 266.
*/
import { type Lang, content } from '../../i18n/ui';
import Pizarra from './Pizarra.astro';
import Nota from './Nota.astro';
import { ROJO } from './colores';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = content[lang].pizarras.tresSenales;

/** Casilla de rotulador marcada con un aspa roja. */
const casilla = (x: number, y: number, l: number) => ({
  marco: `M${x},${y + 3} Q${x},${y} ${x + 3},${y} L${x + l - 3},${y} Q${x + l},${y} ${x + l},${y + 3} L${x + l},${y + l - 3} Q${x + l},${y + l} ${x + l - 3},${y + l} L${x + 3},${y + l} Q${x},${y + l} ${x},${y + l - 3} Z`,
  aspa: `M${x + l * 0.22},${y + l * 0.22} L${x + l * 0.8},${y + l * 0.78} M${x + l * 0.78},${y + l * 0.2} L${x + l * 0.22},${y + l * 0.8}`,
});
---

<Pizarra label={d.label}>
  <svg slot="ancho" viewBox="0 0 800 250" aria-hidden="true">
    {
      d.senales.map((s, i) => {
        const c = casilla(40, 20 + i * 66, 40);
        return (
          <>
            <path d={c.marco} fill="#fff" stroke={ROJO} stroke-width="2.6" />
            <path d={c.aspa} fill="none" stroke={ROJO} stroke-width="3.4" stroke-linecap="round" />
            <Nota x={104} y={38 + i * 66} texto={s.t} tam={20} peso={700} />
            <Nota x={104} y={60 + i * 66} texto={s.s} tono="gris" tam={15} peso={500} />
          </>
        );
      })
    }
    <Nota x={40} y={236} texto={d.nota} tam={16} peso={700} />
  </svg>

  <svg slot="estrecho" viewBox="0 0 360 266" aria-hidden="true">
    {
      d.senales.map((s, i) => {
        const c = casilla(4, 12 + i * 76, 34);
        return (
          <>
            <path d={c.marco} fill="#fff" stroke={ROJO} stroke-width="2.4" />
            <path d={c.aspa} fill="none" stroke={ROJO} stroke-width="3" stroke-linecap="round" />
            <Nota x={52} y={28 + i * 76} texto={s.t} tam={15} peso={700} />
            <Nota x={52} y={47 + i * 76} texto={s.s} tono="gris" tam={12.5} peso={500} />
          </>
        );
      })
    }
    <Nota x={4} y={250} texto={d.nota} tam={13.5} peso={700} />
  </svg>
</Pizarra>
