---
/*
  El camino de un cambio hasta producción. En el post «Qué pasa después de
  entregar un chatbot o agente de IA», sección «Pruebas antes de cada cambio y
  revisión semanal», tras el párrafo de las casi 5.000 pruebas.

  Cuatro pasos en fila: el cambio, la batería de pruebas, la copia de
  seguridad y producción. Explica la idea, no el caso: las casi 5.000 pruebas
  del asistente de citas se quedan en el texto del post (propietario, 5 oct
  2026), para que la pizarra valga para cualquier chatbot. Dos salidas hacia abajo, con la flecha en rojo porque es donde
  algo falla: si falla una prueba, el cambio no se aplica, y si producción no
  responde, vuelve la versión anterior. Las fichas de esas salidas van en
  gris, porque no son el fallo, son la garantía.

  Escritorio 800 × 318, móvil 360 × 462 y para redes (solo se exporta) 700 × 392.
*/
import { type Lang, content } from '../../i18n/ui';
import Pizarra from './Pizarra.astro';
import PizarraDefs from './PizarraDefs.astro';
import Ficha from './Ficha.astro';
import Trazo from './Trazo.astro';
import Nota from './Nota.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = content[lang].pizarras.cambioSeguro;
const ICONOS = ['corrige', 'bateria', 'almacen', 'publica'] as const;
const IMANES = ['amarillo', 'negro', 'gris', 'verde'] as const;
const X = [0, 210, 420, 630];
const W = 170;
const H = 92;
const Y = 24;
const YB = 192; // fila de las salidas
// Móvil: una columna.
const MY = [10, 100, 190, 280];
// Para redes (solo se exporta): dos filas, el cambio y las pruebas arriba, la copia y
// producción abajo, y cada salida a la derecha de la ficha de la que sale.
const RW = 190;
const RX = [0, 230, 510];
const RY = [10, 250];
---

<Pizarra label={d.label}>
  <svg slot="ancho" viewBox="0 0 800 318" aria-hidden="true">
    <PizarraDefs pre="pcsa" />
    {[0, 1, 2].map((i) => <Trazo desde={[X[i] + W + 6, Y + H / 2]} hasta={[X[i + 1] - 6, Y + H / 2]} />)}
    {d.pasos.map((p, i) => <Ficha pre="pcsa" x={X[i]} y={Y} w={W} h={H} icono={ICONOS[i]} titulo={p.t} sub={p.s} iman={IMANES[i]} giro={i === 0 ? -1.5 : 0} tamIcono={28} tamTitulo={16} tamSub={13} />)}
    <Trazo desde={[X[1] + W / 2, Y + H + 8]} hasta={[X[1] + W / 2, YB - 8]} tono="rojo" etiqueta={d.falla} etiquetaEn={[X[1] + W / 2 - 50, (Y + H + YB) / 2 + 5]} tamEtiqueta={15} />
    <Trazo desde={[X[3] + W / 2, Y + H + 8]} hasta={[X[3] + W / 2, YB - 8]} tono="rojo" etiqueta={d.noResponde} etiquetaEn={[X[3] + W / 2 - 60, (Y + H + YB) / 2 + 5]} tamEtiqueta={15} />
    <Ficha pre="pcsa" x={X[1]} y={YB} w={W} h={H} icono="blindado" titulo={d.noSale.t} sub={d.noSale.s} tono="gris" iman="gris" giro={1.5} tamIcono={28} tamTitulo={16} tamSub={13} />
    <Ficha pre="pcsa" x={X[3]} y={YB} w={W} h={H} icono="repite" titulo={d.vuelve.t} sub={d.vuelve.s} tono="gris" iman="gris" giro={-1.5} tamIcono={28} tamTitulo={16} tamSub={13} />
    <Nota x={0} y={310} texto={d.nota} tono="gris" tam={14} peso={600} />
  </svg>

  <svg slot="estrecho" viewBox="0 0 360 462" aria-hidden="true">
    <PizarraDefs pre="pcse" />
    {d.pasos.map((p, i) => <Ficha pre="pcse" disposicion="horizontal" x={0} y={MY[i]} w={360} h={54} icono={ICONOS[i]} titulo={p.t} sub={p.s} iman={IMANES[i]} imanX={0.92} tamIcono={22} tamTitulo={14} tamSub={12.5} />)}
    {[0, 1, 2].map((i) => <Trazo desde={[40, MY[i] + 58]} hasta={[40, MY[i + 1] - 6]} />)}
    <Nota x={64} y={MY[1] + 76} texto={d.movilFalla} tono="rojo" tam={13} peso={700} />
    <Trazo desde={[40, MY[3] + 58]} hasta={[40, 366]} tono="rojo" />
    <Nota x={64} y={354} texto={d.movilNoResponde} tono="rojo" tam={13} peso={700} />
    <Ficha pre="pcse" disposicion="horizontal" x={0} y={372} w={360} h={54} icono="repite" titulo={d.vuelve.t} sub={d.vuelve.s} tono="gris" iman="gris" imanX={0.92} tamIcono={22} tamTitulo={14} tamSub={12.5} />
    <Nota x={0} y={454} texto={d.nota} tono="gris" tam={13} peso={600} />
  </svg>

  <svg slot="redes" viewBox="0 0 700 392" aria-hidden="true">
    <PizarraDefs pre="pcsr" />
    <Trazo desde={[RW + 6, RY[0] + H / 2]} hasta={[RX[1] - 6, RY[0] + H / 2]} />
    <Trazo desde={[RX[1] + 60, RY[0] + H + 8]} hasta={[RW / 2, RY[1] - 8]} curva={-18} etiqueta={d.pasan} etiquetaEn={[(RX[1] + 60 + RW / 2) / 2 + 100, (RY[0] + H + RY[1]) / 2 + 8]} tamEtiqueta={14} />
    <Trazo desde={[RW + 6, RY[1] + H / 2]} hasta={[RX[1] - 6, RY[1] + H / 2]} />
    {d.pasos.map((p, i) => <Ficha pre="pcsr" x={RX[i % 2]} y={RY[Math.floor(i / 2)]} w={RW} h={H} icono={ICONOS[i]} titulo={p.t} sub={p.s} iman={IMANES[i]} imanX={0.82} giro={i === 0 ? -1.5 : 0} tamIcono={30} tamTitulo={16.5} tamSub={13} />)}
    <Trazo desde={[RX[1] + RW + 6, RY[0] + H / 2]} hasta={[RX[2] - 6, RY[0] + H / 2]} tono="rojo" etiqueta={d.falla} etiquetaEn={[(RX[1] + RW + RX[2]) / 2, RY[0] + H / 2 - 12]} tamEtiqueta={14} />
    <Trazo desde={[RX[1] + RW + 6, RY[1] + H / 2]} hasta={[RX[2] - 6, RY[1] + H / 2]} tono="rojo" etiqueta={d.noResponde} etiquetaEn={[(RX[1] + RW + RX[2]) / 2, RY[1] + H / 2 - 12]} tamEtiqueta={14} />
    <Ficha pre="pcsr" x={RX[2]} y={RY[0]} w={RW} h={H} icono="blindado" titulo={d.noSale.t} sub={d.noSale.s} tono="gris" iman="gris" giro={1.5} tamIcono={30} tamTitulo={16.5} tamSub={13} />
    <Ficha pre="pcsr" x={RX[2]} y={RY[1]} w={RW} h={H} icono="repite" titulo={d.vuelve.t} sub={d.vuelve.s} tono="gris" iman="gris" giro={-1.5} tamIcono={30} tamTitulo={16.5} tamSub={13} />
    <Nota x={0} y={382} texto={d.nota} tono="gris" tam={15} peso={600} />
  </svg>
</Pizarra>
