---
/*
  Definiciones compartidas que cada SVG de pizarra necesita dentro de sí: la
  sombra de papel de las fichas y el brillo de los imanes. Cada versión (ancha y
  estrecha) lleva las suyas con un prefijo distinto. Con el mismo `id` el
  navegador resuelve siempre al primero, que es el de la versión oculta, y un
  filtro que vive dentro de algo oculto no se pinta: las fichas y los imanes
  desaparecían enteros (comprobado el 2 oct 2026).
*/
interface Props {
  pre: string;
}
const { pre } = Astro.props;
---

<defs>
  <filter id={`${pre}-sombra`} x="-20%" y="-20%" width="140%" height="150%">
    <feDropShadow dx="0" dy="2.5" stdDeviation="2.6" flood-color="#0f172a" flood-opacity="0.16" />
  </filter>
  <filter id={`${pre}-sombra-iman`} x="-50%" y="-50%" width="200%" height="220%">
    <feDropShadow dx="0" dy="1.6" stdDeviation="1.2" flood-color="#0f172a" flood-opacity="0.35" />
  </filter>
  <radialGradient id={`${pre}-brillo`} cx="35%" cy="30%" r="70%">
    <stop offset="0%" stop-color="#fff" stop-opacity="0.75" />
    <stop offset="45%" stop-color="#fff" stop-opacity="0.12" />
    <stop offset="100%" stop-color="#000" stop-opacity="0.18" />
  </radialGradient>
</defs>
