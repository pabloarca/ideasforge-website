---
/*
  Lo que aplazó el Ómnibus y lo que no. En el post «El reglamento también es
  tuyo», sección «El aplazamiento que casi todo el mundo ha leído mal».

  Dos columnas. A la izquierda, en gris, lo aplazado: el alto riesgo de los
  anexos III y I, con sus fechas nuevas. A la derecha, en tinta, lo que sigue
  en vigor y te toca a ti: prohibiciones, alfabetización y transparencia.

  Escritorio 800 × 250, móvil 360 × 470.
*/
import { type Lang, content } from '../../i18n/ui';
import Pizarra from './Pizarra.astro';
import PizarraDefs from './PizarraDefs.astro';
import Ficha from './Ficha.astro';
import Nota from './Nota.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = content[lang].pizarras.aplazamiento;
const SIGUE = ['blindado', 'escuela', 'chat'] as const;
const IMANES = ['rojo', 'amarillo', 'verde'] as const;
---

<Pizarra label={d.label}>
  <svg slot="ancho" viewBox="0 0 800 250" aria-hidden="true">
    <PizarraDefs pre="papa" />
    <path d="M400,10 L400,240" fill="none" stroke="#c9ced6" stroke-width="1.5" stroke-dasharray="5 6" />

    <Nota x={0} y={24} texto={d.aplazo.titulo} tono="gris" tam={19} peso={700} />
    <Nota x={0} y={45} texto={d.aplazo.sub} tono="gris" tam={15} peso={500} />
    {d.aplazo.items.map((it, i) => <Ficha pre="papa" disposicion="horizontal" x={0} y={62 + i * 64} w={370} h={52} icono="reloj" titulo={it.t} sub={it.s} tono="gris" iman="gris" imanX={0.93} giro={i ? 1 : -1} tamIcono={24} tamTitulo={15} tamSub={13} />)}

    <Nota x={420} y={24} texto={d.sigue.titulo} tam={19} peso={700} />
    <Nota x={420} y={45} texto={d.sigue.sub} tam={15} peso={600} />
    {d.sigue.items.map((it, i) => <Ficha pre="papa" disposicion="horizontal" x={420} y={62 + i * 60} w={380} h={50} icono={SIGUE[i]} titulo={it.t} sub={it.s} iman={IMANES[i]} imanX={0.93} tamIcono={24} tamTitulo={15} tamSub={13} />)}
  </svg>

  <svg slot="estrecho" viewBox="0 0 360 470" aria-hidden="true">
    <PizarraDefs pre="pape" />

    <Nota x={0} y={18} texto={d.sigue.titulo} tam={15} peso={700} />
    <Nota x={0} y={36} texto={d.sigue.sub} tam={12.5} peso={600} />
    {d.sigue.items.map((it, i) => <Ficha pre="pape" disposicion="horizontal" x={0} y={48 + i * 58} w={360} h={48} icono={SIGUE[i]} titulo={it.t} sub={it.s} iman={IMANES[i]} imanX={0.93} tamIcono={22} tamTitulo={14} tamSub={12.5} />)}
    <path d="M0,240 L360,240" fill="none" stroke="#c9ced6" stroke-width="1.5" stroke-dasharray="5 6" />
    <Nota x={0} y={268} texto={d.aplazo.titulo} tono="gris" tam={15} peso={700} />
    <Nota x={0} y={286} texto={d.aplazo.sub} tono="gris" tam={12.5} peso={500} />
    {d.aplazo.items.map((it, i) => <Ficha pre="pape" disposicion="horizontal" x={0} y={298 + i * 58} w={360} h={48} icono="reloj" titulo={it.t} sub={it.s} tono="gris" iman="gris" imanX={0.93} tamIcono={22} tamTitulo={14} tamSub={12.5} />)}
  </svg>
</Pizarra>
