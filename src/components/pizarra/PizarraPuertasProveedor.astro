---
/*
  Cómo alguien pasa a ser proveedor sin darse cuenta. En la sección del
  mismo nombre de la guía del reglamento, debajo de «La tercera es la trampa
  silenciosa».

  Tres puertas pequeñas, una por manera de cambiar de papel, y las tres
  flechas acaban en la misma silla, la del proveedor. La tercera, cambiar la
  finalidad prevista, lleva su aviso: la trampa silenciosa.

  Escritorio 800 × 320, móvil 360 × 300.
*/
import { type Lang, content } from '../../i18n/ui';
import Pizarra from './Pizarra.astro';
import Trazo from './Trazo.astro';
import Nota from './Nota.astro';
import { TINTA } from './colores';
import { ICONOS_PIZARRA } from './iconos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = content[lang].pizarras.puertasProveedor;
const silla = ICONOS_PIZARRA.silla;

/** Parte un texto en líneas de como mucho `max` caracteres, por palabras. */
const parte = (texto: string, max: number) => {
  const lineas: string[] = [];
  for (const p of texto.split(' ')) {
    const ult = lineas[lineas.length - 1];
    if (ult !== undefined && (ult + ' ' + p).length <= max) lineas[lineas.length - 1] = ult + ' ' + p;
    else lineas.push(p);
  }
  return lineas;
};

/** Una puerta pequeña dibujada: marco, dos paneles y pomo. */
const puerta = (x: number, y: number, w: number, h: number) => ({
  marco: { x, y, w, h },
  panel1: { x: x + w * 0.16, y: y + h * 0.1, w: w * 0.68, h: h * 0.36 },
  panel2: { x: x + w * 0.16, y: y + h * 0.54, w: w * 0.68, h: h * 0.36 },
  pomo: { cx: x + w * 0.82, cy: y + h * 0.5 },
});
const FY = [14, 116, 218];
const MFY = [8, 104, 200];
---

<Pizarra label={d.label}>
  <svg slot="ancho" viewBox="0 0 800 320" aria-hidden="true">
    {
      d.puertas.map((p, i) => {
        const q = puerta(20, FY[i], 64, 88);
        return (
          <>
            <rect x={q.marco.x} y={q.marco.y} width={q.marco.w} height={q.marco.h} rx="4" fill="#fff" stroke={TINTA} stroke-width="2.2" />
            <rect x={q.panel1.x} y={q.panel1.y} width={q.panel1.w} height={q.panel1.h} rx="2" fill="none" stroke="#c9ced6" stroke-width="1.4" />
            <rect x={q.panel2.x} y={q.panel2.y} width={q.panel2.w} height={q.panel2.h} rx="2" fill="none" stroke="#c9ced6" stroke-width="1.4" />
            <circle cx={q.pomo.cx} cy={q.pomo.cy} r="3.5" fill={TINTA} />
            <Nota x={104} y={FY[i] + 36} texto={p.t} tam={17} peso={700} />
            <Nota x={104} y={FY[i] + 57} texto={p.s} tono="gris" tam={14} peso={500} />
            <Trazo desde={[392, FY[i] + 44]} hasta={[560, 152]} curva={i === 0 ? -16 : i === 2 ? 16 : 0} />
          </>
        );
      })
    }
    <Nota x={104} y={FY[2] + 80} texto={d.trampa} tono="rojo" tam={15} peso={700} />
    <svg x={590} y={70} width="110" height="110" viewBox={silla.viewBox} aria-hidden="true">
      <path d={silla.d} fill={TINTA} />
    </svg>
    <Nota x={645} y={212} texto={d.silla.t} tam={20} peso={700} alinea="middle" />
    <Nota x={645} y={234} texto={d.silla.s} tono="gris" tam={14} peso={500} alinea="middle" />
  </svg>

  <svg slot="estrecho" viewBox="0 0 360 300" aria-hidden="true">
    {
      d.puertas.map((p, i) => {
        const q = puerta(0, MFY[i], 50, 70);
        return (
          <>
            <rect x={q.marco.x} y={q.marco.y} width={q.marco.w} height={q.marco.h} rx="4" fill="#fff" stroke={TINTA} stroke-width="2" />
            <rect x={q.panel1.x} y={q.panel1.y} width={q.panel1.w} height={q.panel1.h} rx="2" fill="none" stroke="#c9ced6" stroke-width="1.2" />
            <rect x={q.panel2.x} y={q.panel2.y} width={q.panel2.w} height={q.panel2.h} rx="2" fill="none" stroke="#c9ced6" stroke-width="1.2" />
            <circle cx={q.pomo.cx} cy={q.pomo.cy} r="3" fill={TINTA} />
            <Nota x={62} y={MFY[i] + 24} texto={p.t} tam={14} peso={700} />
            <Nota x={62} y={MFY[i] + 42} texto={parte(p.s, 22)} tono="gris" tam={12} peso={500} interlineado={1.15} />
            <Trazo desde={[236, MFY[i] + 34]} hasta={[270, 140]} />
          </>
        );
      })
    }
    <Nota x={62} y={MFY[2] + 70} texto={d.trampa} tono="rojo" tam={13} peso={700} />
    <svg x={276} y={104} width="70" height="70" viewBox={silla.viewBox} aria-hidden="true">
      <path d={silla.d} fill={TINTA} />
    </svg>
    <Nota x={311} y={194} texto={d.silla.t} tam={14} peso={700} alinea="middle" />
    <Nota x={311} y={212} texto={parte(d.silla.s, 12)} tono="gris" tam={11.5} peso={500} alinea="middle" interlineado={1.15} />
  </svg>
</Pizarra>
