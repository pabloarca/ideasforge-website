---
/*
  El tablero del gráfico pizarra: el marco sobre el que se pegan fichas y se
  dibuja con rotulador. Es el registro de alguien explicando en la pared.

  ASPECTO DESDE OCTUBRE DE 2026. El tablero era una pizarra blanca con marco
  de aluminio en degradado, sombra, esquinas redondeadas y una bandeja de
  rotuladores. El sistema de diseño nuevo no admite degradados, sombras,
  radios ni adornos, así que el tablero pasa a ser lo que es todo lo demás en
  el sitio: una figura plana enmarcada por la regla de 2 px.

  Los ochenta gráficos NO se han redibujado. Son SVG con sus colores escritos
  en atributos (`fill="#fff"`, `rx="6"`, `filter="url(…)"`), y aquí se les
  cambia el aspecto desde fuera, con CSS, que manda sobre un atributo de
  presentación:
    - `rx: 0` quita todos los radios;
    - `filter: none` quita todas las sombras;
    - los blancos y grises fríos se llevan a los neutros cálidos de la paleta.
  Lo que sí cambió en origen son los colores de rotulador (`colores.ts`) y la
  ficha con su imán (`Ficha.astro`), que ahora es el cuadrado de 10 px.

  Reglas del kit en `README.md`. El contenido son dos SVG del mismo gráfico,
  uno apaisado para escritorio y otro vertical para el móvil, porque un SVG
  apaisado en un teléfono se encoge hasta no leerse (pasó con todos los
  diagramas de la casa hasta el 2 oct 2026).

  La letra es Geist, la única del sitio. Antes era Inter: las dos tienen un
  ancho de letra muy parecido y los textos caben en sus cajas igual.
*/
interface Props {
  /** Descripción del gráfico para lectores de pantalla. */
  label: string;
  /** Leyenda opcional bajo la pizarra, en HTML de la página. */
  caption?: string;
}
const { label, caption } = Astro.props;
---

<figure class="pz-fig">
  <div class="pz" role="img" aria-label={label}>
    <div class="pz-tablero">
      <div class="lg:hidden"><slot name="estrecho" /></div>
      <div class="hidden lg:block"><slot name="ancho" /></div>
    </div>
  </div>
  {caption && <figcaption class="pz-pie">{caption}</figcaption>}
</figure>

<style>
  .pz-fig {
    margin: 2.25rem 0 2.75rem;
  }

  .pz {
    --pz-tinta: #201e1d;
    --pz-gris: #605d5d;
    --pz-azul: var(--color-accent, #002dfd);
    border: 2px solid var(--color-border);
  }

  .pz-tablero {
    padding: clamp(10px, 2.5vw, 22px);
    background: var(--color-bg);
    font-family: var(--font-sans);
    color: var(--pz-tinta);
  }

  .pz-tablero :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ---- El aspecto de los gráficos, corregido desde fuera ---- */

  /* Ni radios ni sombras, en ninguna pieza de ninguna pizarra. */
  .pz-tablero :global(rect) {
    rx: 0;
    ry: 0;
  }
  .pz-tablero :global([filter]) {
    filter: none;
  }

  /* Papel: el blanco pasa al fondo de la página y los grises fríos de
     relleno, a la superficie cálida. */
  .pz-tablero :global([fill='#fff']),
  .pz-tablero :global([fill='#fffdf8']),
  .pz-tablero :global([fill='#fafbfc']) {
    fill: var(--color-bg);
  }
  .pz-tablero :global([fill='#f6f7f9']),
  .pz-tablero :global([fill='#f2f3f5']),
  .pz-tablero :global([fill='#eceef2']) {
    fill: var(--color-bg-soft);
  }
  .pz-tablero :global([fill='#f4f6ff']) {
    fill: var(--color-accent-100);
  }
  .pz-tablero :global([fill='#2a2f3a']) {
    fill: var(--pz-tinta);
  }

  /* Líneas: los grises azulados pasan al gris de las reglas, y el trazo
     blanco que separaba piezas, al fondo. */
  .pz-tablero :global([stroke='#c9ced6']),
  .pz-tablero :global([stroke='#d3d7dd']),
  .pz-tablero :global([stroke='#dcdfe4']),
  .pz-tablero :global([stroke='#e3e6ea']),
  .pz-tablero :global([stroke='#b9bfc8']) {
    stroke: var(--color-border);
  }
  .pz-tablero :global([stroke='#9aa1ad']) {
    stroke: var(--color-neutral-400);
  }
  .pz-tablero :global([stroke='#1f2430']) {
    stroke: var(--pz-tinta);
  }
  .pz-tablero :global([stroke='#fff']) {
    stroke: var(--color-bg);
  }

  .pz-pie {
    margin-top: 0.75rem;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
  }
</style>
