---
/*
  Una ficha pegada a la pizarra. Va dentro de un <svg>:
  es un grupo, no un elemento HTML. Coordenadas en las unidades del viewBox
  del gráfico que la contiene.

  Dos disposiciones:
  - `vertical` (por defecto): icono arriba, título y, si la hay, una línea
    pequeña debajo. Para las fichas protagonistas.
  - `horizontal`: icono a la izquierda y texto a la derecha. Para las fichas
    compactas de una lista o de un móvil.

  La ficha puede ir un poco torcida (`giro`, en grados), que es lo que la hace
  parecer pegada a mano. Más de 3° ya parece descuido.
*/
import { ICONOS_PIZARRA, type NombreIconoPizarra } from './iconos';
import { GRIS, COLOR_TONO, PAPEL_TONO, type Tono } from './colores';

/*
  El «imán» es desde octubre de 2026 el cuadrado de 10 px del sistema de
  diseño, plano y sin brillo. Antes eran círculos de seis colores con sombra y
  reflejo. El nombre del color se conserva en la propiedad para no tocar las
  ochenta pizarras que lo pasan, pero ya solo distingue dos casos: `azul`
  pinta el cuadrado en acento, y cualquier otro lo pinta en tinta. El diseño
  tiene un solo acento y aquí no hay sitio para un amarillo o un verde.
*/
const IMANES = {
  rojo: '#201e1d',
  amarillo: '#201e1d',
  verde: '#201e1d',
  azul: '#002dfd',
  negro: '#201e1d',
  gris: '#201e1d',
} as const;

interface Props {
  /** Prefijo de las definiciones del SVG que la contiene (ver PizarraDefs).
   *  La ficha ya no usa ninguna, ni sombra ni brillo, pero la propiedad se
   *  conserva porque todas las pizarras la pasan. */
  pre?: string;
  x: number;
  y: number;
  w: number;
  h: number;
  icono: NombreIconoPizarra;
  titulo: string;
  sub?: string;
  giro?: number;
  iman?: keyof typeof IMANES;
  /** Dónde va el imán a lo ancho, de 0 a 1. En una ficha baja de una sola
      línea, a la derecha (0.88) para que no tape el texto. */
  imanX?: number;
  /** `azul` para lo que hace el modelo y `rojo` para el fallo. */
  tono?: Tono;
  disposicion?: 'vertical' | 'horizontal';
  /** Tamaño del icono en unidades del viewBox. */
  tamIcono?: number;
  tamTitulo?: number;
  tamSub?: number;
}
const {
  x,
  y,
  w,
  h,
  icono,
  titulo,
  sub,
  giro = 0,
  iman = 'rojo',
  imanX = 0.5,
  tono = 'tinta',
  disposicion = 'vertical',
  tamTitulo = 17,
  tamSub = 14.5,
} = Astro.props;
const tamIcono = Astro.props.tamIcono ?? (disposicion === 'horizontal' ? 28 : 34);

const ic = ICONOS_PIZARRA[icono];
const color = COLOR_TONO[tono];
const papel = PAPEL_TONO[tono];

// Vertical: con línea secundaria, el bloque de texto sube para dejarle sitio.
const yTitulo = sub ? h - 30 : h - 20;
const yIcono = Math.max(16, (sub ? h - 52 : h - 42) - tamIcono);

// Horizontal: icono a la izquierda centrado en alto, texto alineado a su derecha.
const xIconoH = 14;
const xTextoH = xIconoH + tamIcono + 11;
const yTituloH = sub ? h / 2 - 2 : h / 2 + tamTitulo * 0.36;
const ySubH = h / 2 + tamSub + 3;
---

<g transform={`translate(${x} ${y}) rotate(${giro} ${w / 2} ${h / 2})`}>
  <rect width={w} height={h} fill={papel.fondo} stroke={papel.borde} stroke-width="2" />
  {
    disposicion === 'vertical' ? (
      <>
        <svg x={(w - tamIcono) / 2} y={yIcono} width={tamIcono} height={tamIcono} viewBox={ic.viewBox} aria-hidden="true">
          <path d={ic.d} fill={color} />
        </svg>
        <text x={w / 2} y={yTitulo} text-anchor="middle" font-size={tamTitulo} font-weight="600" fill={color}>
          {titulo}
        </text>
        {sub && (
          <text x={w / 2} y={h - 11} text-anchor="middle" font-size={tamSub} font-weight="500" fill={GRIS}>
            {sub}
          </text>
        )}
      </>
    ) : (
      <>
        <svg x={xIconoH} y={(h - tamIcono) / 2} width={tamIcono} height={tamIcono} viewBox={ic.viewBox} aria-hidden="true">
          <path d={ic.d} fill={color} />
        </svg>
        <text x={xTextoH} y={yTituloH} font-size={tamTitulo} font-weight="600" fill={color}>
          {titulo}
        </text>
        {sub && (
          <text x={xTextoH} y={ySubH} font-size={tamSub} font-weight="500" fill={GRIS}>
            {sub}
          </text>
        )}
      </>
    )
  }
  {/* El cuadrado de 10 px, a caballo del borde de arriba. */}
  <rect x={w * imanX - 5} y="-5" width="10" height="10" fill={IMANES[iman]} />
</g>
