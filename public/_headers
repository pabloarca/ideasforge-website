# Cabeceras de Cloudflare Pages. Se leen de arriba abajo y se acumulan: una
# ruta puede recibir cabeceras de varias reglas.

# ── Los dominios de previsualización, fuera del índice ────────────────────────
# Cada despliegue crea una URL en pages.dev con una copia entera del sitio. Sin
# esto competirían con el dominio real por sus propias palabras, que es
# contenido duplicado con nuestro propio nombre.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# ── Caché ────────────────────────────────────────────────────────────────────
# El criterio es simple: si el nombre del fichero cambia cuando cambia su
# contenido, se puede cachear para siempre. Si no, se cachea poco.

# Astro pone un hash en el nombre de cada CSS y JS que compila, así que el
# fichero de mañana tendrá otro nombre. `immutable` le dice al navegador que ni
# se moleste en preguntar si cambió: no puede haber cambiado.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# La tipografía no lleva hash pero cambia una vez cada varios años, y es lo
# primero que se necesita para pintar texto. Un año, con revalidación silenciosa
# por si se sustituye.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes, vídeo e iconos. Sin hash en el nombre, así que se cachean un mes y
# se revalidan. Si se sustituye una foto, el visitante la ve como mucho al mes,
# y mientras tanto no se descarga en cada visita.
/blog/*
  Cache-Control: public, max-age=2592000
/case-studies/*
  Cache-Control: public, max-age=2592000
/logos/*
  Cache-Control: public, max-age=2592000
/integrations/*
  Cache-Control: public, max-age=2592000
/decor/*
  Cache-Control: public, max-age=2592000
/videos/*
  Cache-Control: public, max-age=2592000
/og/*
  Cache-Control: public, max-age=2592000

# El HTML NO se cachea largo a propósito. Es lo único que cambia cuando se
# corrige un texto, y cachearlo una semana significaría que una errata sigue
# publicada una semana después de arreglarla. Se revalida siempre y el servidor
# responde «no ha cambiado» cuando es el caso, que cuesta unos bytes.
/*
  Cache-Control: public, max-age=0, must-revalidate
